<div class="panel">
    <input type="text" id="searchInput" placeholder="Caută utilaj..." onkeyup="if(event.key==='Enter') cauta()">
    <select id="filterSectie" onchange="afiseazaPuncte()">
        <option value="Toate">Toate Secțiile</option>
