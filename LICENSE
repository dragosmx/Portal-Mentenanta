<script>
    // Inițializare Firebase
    const firebaseConfig = { 
        databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" 
    };
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    // Citire parametru din URL
    const urlParams = new URLSearchParams(window.location.search); 
    const idUtilaj = urlParams.get('id');

    if (idUtilaj) {
        // Interogare bază de date
        database.ref('utilaje/' + idUtilaj).once('value').then(snapshot => {
            const utilaj = snapshot.val(); 
            
            if (!utilaj) {
                document.getElementById('load').innerText = "❌ Eroare: Utilajul nu a fost găsit.";
                return;
            }
            
            // Ascundem loading-ul și afișăm conținutul
            document.getElementById('load').style.display = "none"; 
            document.getElementById('content').style.display = "block";
            
            // Populăm datele generale
            document.getElementById('uNume').innerText = utilaj.nume; 
            document.getElementById('uDetalii').innerText = "Secția: " + utilaj.sectie + " | ID: " + utilaj.id;
            
            // Setăm linkul pentru butonul de mecanic (îl va trimite la index.html pentru parolă, apoi la edit.html)
            document.getElementById('btnEditare').href = "index.html?ref=?id=" + utilaj.id;
            
            const containerIstoric = document.getElementById('uIstoric');
            
            if (utilaj.istoric) {
                // Sortăm descrescător după dată
                const istoricSortat = Object.values(utilaj.istoric).sort((a, b) => new Date(b.data) - new Date(a.data));
                
                istoricSortat.forEach(i => {
                    let clasaCSS = "istoric-item";
                    
                    // Dacă e intervenție corectivă (defect), o facem roșie
                    if (i.tip && i.tip.includes("Corectivă")) {
                        clasaCSS += " defect";
                    }
                    
                    containerIstoric.innerHTML += `
                        <div class="${clasaCSS}">
                            <div class="data-interventie">📅 ${i.data} | Tip: ${i.tip || 'Preventivă'}</div>
                            <div style="font-size:13px; margin-bottom:5px;"><b>👷 Mecanic:</b> ${i.mecanic || '-'}</div>
                            <div style="font-size:13px; margin-bottom:5px;"><b>🔧 Operațiuni:</b> ${i.verificari}</div>
                            <div style="font-size:13px; color:#555;"><b>📝 Obs:</b> ${i.obs || '-'}</div>
                        </div>
                    `;
                });
            } else {
                containerIstoric.innerHTML = "<p style='text-align:center; padding:20px;'>Niciun istoric înregistrat pentru acest utilaj.</p>";
            }
        });
    } else {
        document.getElementById('load').innerText = "❌ Eroare: Nu s-a scanat un cod valid.";
    }
</script>
</body>
</html>
