<body>

<nav>
    <img src="logo.png" onclick="window.location.href='index.html'">
    <div>
        <button onclick="printeazaQR()" style="background:#8e44ad; color:white; border:none; padding:10px 15px; border-radius:8px; font-weight:bold; cursor:pointer;">🖨️ ETICHETE QR</button>
        <button onclick="deschideRapoarte()" style="background:var(--accent); color:white; border:none; padding:10px 15px; border-radius:8px; font-weight:bold; cursor:pointer; margin-left:10px;">📊 DASHBOARD</button>
    </div>
