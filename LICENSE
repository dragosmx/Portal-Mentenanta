    </div>

    <div class="logo-box"><img src="logo.png"></div>
    <div class="cloud-status"><div class="dot"></div> ONLINE & ACTIV</div>
    
    <div id="status" class="status-badge">MOD: UTILAJ NOU</div>

    <div class="group"><label>Denumire Utilaj</label><input type="text" id="nume" placeholder="Nume..." oninput="checkReady()"></div>
    <div class="group"><label>Marcă / Model</label><input type="text" id="model" placeholder="Ex: Gunther / G350"></div>
    
    <div class="group">
        <label>Secție</label>
        <select id="sectie" onchange="toggleExtra()">
            <option value="Tranșare">Tranșare</option>
            <option value="Injectare">Injectare</option>
            <option value="Tocare">Tocare</option>
            <option value="Fabricație">Fabricație</option>
