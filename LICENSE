<script>
    const firebaseConfig = { 
        databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" 
    };
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    var map = L.map('map', { 
        crs: L.CRS.Simple, 
        minZoom: 0, 
        maxZoom: 3 
    });
    
    L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map);
    map.setView([500, 700], 0.5);

    let dbRaw = {}; 
    let markersList = [];

    database.ref('utilaje').on('value', (snap) => {
        dbRaw = snap.val() || {};
        afiseazaPuncte();
    });

    function calculZile(dataStr) {
        if (!dataStr || dataStr === "-") return 999;
        return Math.floor((new Date() - new Date(dataStr)) / (1000 * 3600 * 24));
    }

    // Funcție pentru generare pin SVG customizat cu culori perfecte
    function getColoredIcon(color) {
        const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 36" width="28" height="42">
                        <path fill="${color}" stroke="#000" stroke-width="1.5" d="M12 0C5.373 0 0 5.373 0 12c0 7.333 12 24 12 24s12-16.667 12-24C24 5.373 18.627 0 12 0zm0 17.5c-3.038 0-5.5-2.462-5.5-5.5S8.962 6.5 12 6.5s5.5 2.462 5.5 5.5-2.462 5.5-5.5 5.5z"/>
                     </svg>`;
        return L.divIcon({ 
            className: "custom-pin", 
            html: svg, 
            iconSize: [28, 42], 
            iconAnchor: [14, 42], 
            popupAnchor: [0, -40] 
        });
    }

    function afiseazaPuncte() {
        const filtru = document.getElementById('filterSectie').value;
        markersList.forEach(m => map.removeLayer(m)); 
        markersList = [];

        Object.keys(dbRaw).forEach(key => {
            const u = dbRaw[key];
            if(filtru !== "Toate" && u.sectie !== filtru) return;
            if(!u.lat || !u.lng) return;

            let ultimaData = "-";
            if (u.istoric) {
                const ist = Object.values(u.istoric).sort((a, b) => new Date(b.data) - new Date(a.data));
                ultimaData = ist[0].data;
            }
            
            const zile = calculZile(ultimaData);

            // LOGICA CULORI (Aici culorile se aplica corect)
            let hexColor = "#e74c3c"; // Rosu implicit
            if (zile < 30) {
                hexColor = "#27ae60"; // Verde
            } else if (zile < 90) {
                hexColor = "#f39c12"; // Galben
            }

            const m = L.marker([u.lat, u.lng], { 
                icon: getColoredIcon(hexColor) 
            }).addTo(map);
            
            let popHtml = `
                <div class="popup-header">
                    <h3>${u.nume}</h3>
                    <p>${u.model||''} | ${ultimaData}</p>
                </div>
                <div class="popup-body">
                    <table class="history-table">
                        <tbody>
            `;
            
            if(u.istoric) {
                Object.values(u.istoric).sort((a,b)=>new Date(b.data)-new Date(a.data)).slice(0,3).forEach(i => {
                    popHtml += `<tr><td><b>${i.data}</b></td><td>${i.tip || ''}<br>${i.mecanic ? 'de: '+i.mecanic : ''}</td></tr>`;
                });
            } else {
                popHtml += `<tr><td colspan="2">Fără date</td></tr>`;
            }
            
            popHtml += `
                        </tbody>
                    </table>
                    <button style="width:100%;background:var(--excel);color:white;border:none;padding:8px;margin-top:10px;cursor:pointer;" onclick="exportaFisa('${key}')">📥 Descarcă Fișa</button>
                </div>
            `;
            
            m.bindPopup(popHtml);
            m.uData = { id: String(u.id).toUpperCase(), nume: u.nume.toUpperCase() };
            markersList.push(m);
        });
    }

    function deschideRapoarte() {
        const corp = document.getElementById('corpScadente'); 
        const corptabel = document.getElementById('corptabel'); 
        corp.innerHTML = ""; 
        corptabel.innerHTML = "";
        
        Object.values(dbRaw).forEach(u => {
            let ultima = "-";
            if(u.istoric) {
                ultima = Object.values(u.istoric).sort((a,b)=>new Date(b.data)-new Date(a.data))[0].data;
            }
            
            const zile = calculZile(ultima);
            
            let actiune = "";
            let status = "";
            
            if (zile >= 365) { 
                actiune = "Revizie Anuală (Ex: Schimb ulei transmisie Shell Tellus 90, tablou electric)"; 
                status = `<span class="status-pill bg-crit">CRITIC</span>`; 
            }
            else if (zile >= 180) { 
                actiune = "Revizie Semestrială (Ex: Verificare benzi transport, sistem hidraulic)"; 
                status = `<span class="status-pill bg-crit">DEPĂȘIT</span>`; 
            }
            else if (zile >= 90) { 
                actiune = "Verificare Trimestrială (Ex: Reîntindere curele, descărcător pastă)"; 
                status = `<span class="status-pill bg-warn">URMEAZĂ</span>`; 
            }
            else if (zile >= 30) { 
                actiune = "Inspecție Lunară (Ex: Curățare filtru admisie aer)"; 
                status = `<span class="status-pill bg-warn">VERIFICĂ</span>`; 
            }
            else if (zile >= 7) { 
                actiune = "Inspecție Săptămânală (Ex: Verificare și ascuțire sistem tăiere)"; 
                status = `<span class="status-pill bg-ok">OK</span>`; 
            }
            
            if (zile >= 30 || ultima === "-") {
                corp.innerHTML += `
                    <tr>
                        <td style="padding:10px;border-bottom:1px solid #eee;"><b>${u.nume}</b><br><span style="font-size:10px;color:gray;">${u.sectie}</span></td>
                        <td style="border-bottom:1px solid #eee;"><b>${zile === 999 ? 'LIPSĂ DATE' : zile + ' zile'}</b></td>
                        <td style="border-bottom:1px solid #eee;">${actiune}</td>
                        <td style="border-bottom:1px solid #eee;">${status}</td>
                    </tr>
                `;
            }
            
            corptabel.innerHTML += `
                <tr>
                    <td style="padding:5px;border-bottom:1px solid #eee;"><b>${u.nume}</b></td>
                    <td style="border-bottom:1px solid #eee;">${ultima}</td>
                </tr>
            `;
        });
        
        document.getElementById('reportModal').style.display = "flex";
    }

    function exportaFisa(id) {
        const u = dbRaw[id];
        let csv = "\uFEFFDATA;TIP;MECANIC;VERIFICARI;OBSERVATII\n";
        if (u.istoric) {
            Object.values(u.istoric).forEach(i => { 
                csv += `${i.data};${i.tip || ''};${i.mecanic || ''};${(i.verificari || '').replace(/;/g, ',')};${(i.obs || '').replace(/;/g, ',')}\n`; 
            });
        }
        const a = document.createElement("a"); 
        a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' })); 
        a.download = `Istoric_${u.nume}.csv`; 
        a.click();
    }

    function exportaTotExcel() {
        let csv = "\uFEFFDATA;UTILAJ;SECTIE;MODEL;TIP_INTERVENTIE;MECANIC;VERIFICARI;OBSERVATII\n";
        Object.values(dbRaw).forEach(u => {
            if(u.istoric) {
                Object.values(u.istoric).forEach(i => { 
                    csv += `${i.data};${u.nume};${u.sectie};${u.model || ''};${i.tip || ''};${i.mecanic || ''};${(i.verificari || '').replace(/;/g, ',')};${(i.obs || '').replace(/;/g, ',')}\n`; 
                });
            }
        });
        const a = document.createElement("a"); 
        a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8;' })); 
        a.download = "Mentenanta_Global_Killer.csv"; 
        a.click();
    }

    function cauta() {
        const val = document.getElementById('searchInput').value.toUpperCase().trim();
        const gasit = markersList.find(m => m.uData.id.includes(val) || m.uData.nume.includes(val));
        if(gasit) { 
            map.setView(gasit.getLatLng(), 1.5); 
            gasit.openPopup(); 
        } else {
            alert("Utilajul nu a fost găsit pe hartă!");
        }
    }

    window.onload = () => { 
        setTimeout(() => map.invalidateSize(), 600); 
    };
</script>
</body>
</html>
