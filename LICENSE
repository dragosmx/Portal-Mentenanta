<script>
    // --- 1. CONFIGURARE FIREBASE ---
    const firebaseConfig = { 
        databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" 
    };
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    // --- 2. CONFIGURARE HARTĂ ---
    var map = L.map('map', { 
        crs: L.CRS.Simple, 
        minZoom: 0, 
        maxZoom: 3 
    });
    var bounds = [[0, 0], [1000, 1400]];
    L.imageOverlay('harta.jpg', bounds).addTo(map);
    map.setView([500, 700], 1); 

    // --- 3. VARIABILE GLOBALE ---
    let dbRaw = {};
    let markersGroup = L.layerGroup().addTo(map);
    let activeMarker = null;
    let selectedId = null;
    let currentCoords = null;
    
    // Setăm data de azi implicit
    document.getElementById('data').valueAsDate = new Date();

    // --- 4. ASCULTĂTOR FIREBASE (REALTIME) ---
    database.ref('utilaje').on('value', (snap) => {
        dbRaw = snap.val() || {};
        refreshPini();
    });

    // --- 5. AFIȘARE PINI EXISTENȚI ---
    function refreshPini() {
        markersGroup.clearLayers();
        Object.keys(dbRaw).forEach(id => {
            const u = dbRaw[id];
            
            // Asigurare că avem coordonate valide înainte să desenăm pinul
            if (u.lat && u.lng) {
                const markerExist = L.marker([u.lat, u.lng], {
                    icon: L.icon({ 
                        iconUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon.png', 
                        className: 'existing-pin', 
                        iconSize: [25, 41], 
                        iconAnchor: [12, 41] 
                    })
                }).addTo(markersGroup);
                
                // Click pe un pin existent deschide modul "Editare"
                markerExist.on('click', (e) => { 
                    L.DomEvent.stopPropagation(e); 
                    incarcaUtilaj(id); 
                });
            }
        });
    }

    // --- 6. CLICK PE HARTĂ (ADĂUGARE PIN NOU) ---
    map.on('click', (e) => {
        // Dacă edităm deja un utilaj, nu permitem mutarea lui prin click
        if (selectedId) return; 
        
        currentCoords = [e.latlng.lat.toFixed(0), e.latlng.lng.toFixed(0)];
        
        if (activeMarker) {
            map.removeLayer(activeMarker);
        }
        
        activeMarker = L.marker(e.latlng).addTo(map);
        checkReady();
    });

    // --- 7. ÎNCĂRCARE DATE UTILAJ EXISTENT ---
    function incarcaUtilaj(id) {
        selectedId = id; 
        const utilajCurent = dbRaw[id];
        
        document.getElementById('nume').value = utilajCurent.nume;
        document.getElementById('model').value = utilajCurent.model || "";
        document.getElementById('sectie').value = utilajCurent.sectie;
        
        document.getElementById('status').innerHTML = `MOD: EDITARE (ID: ${id})`;
        document.getElementById('status').className = "status-badge status-edit";
        
        document.getElementById('deleteZone').innerHTML = `<button class="btn-del" onclick="stergeUtilaj('${id}')">⚠️ ȘTERGE UTILAJ DEFINITIV</button>`;
        
        if (activeMarker) {
            map.removeLayer(activeMarker);
        }
        
        toggleExtra(); 
        checkReady();
    }

    // --- 8. GENERARE BIFE DINAMICE ÎN FUNCȚIE DE SECȚIE ---
    function toggleExtra() {
        const sectieSelectata = document.getElementById('sectie').value;
        const divExtra = document.getElementById('extraFields');
        
        let htmlExtra = '<label>Verificări Specifice:</label><div class="checklist">';

        if (sectieSelectata === 'Tratament Termic' || sectieSelectata === 'Secție Crude') {
            htmlExtra += `
                <label class="check-item"><input type="checkbox" class="task" value="Sonde"> Sonde Produs/Cameră</label>
                <label class="check-item"><input type="checkbox" class="task" value="Generator Fum"> Generator Fum</label>
                <label class="check-item"><input type="checkbox" class="task" value="Clapete"> Clapete / Ventilație</label>
                <label class="check-item"><input type="checkbox" class="task" value="Garnituri"> Garnituri Ușă</label>`;
        } else if (['Tocare', 'Injectare', 'Fabricație', 'Tranșare'].includes(sectieSelectata)) {
            htmlExtra += `
                <label class="check-item"><input type="checkbox" class="task" value="Ulei"> Nivel Ulei / Gresare</label>
                <label class="check-item"><input type="checkbox" class="task" value="Lanturi"> Lanțuri / Curele</label>
                <label class="check-item"><input type="checkbox" class="task" value="Cutite"> Stare Cuțite / Site</label>
                <label class="check-item"><input type="checkbox" class="task" value="Zgomot"> Zgomot Rulmenți</label>`;
        } else if (sectieSelectata === 'Ambalare Vid') {
            htmlExtra += `
                <label class="check-item"><input type="checkbox" class="task" value="Pompa Vid"> Filtre / Ulei Pompă</label>
                <label class="check-item"><input type="checkbox" class="task" value="Lipire"> Rezistențe Lipire</label>
                <label class="check-item"><input type="checkbox" class="task" value="Senzori"> Senzori Poziție</label>`;
        } else {
            htmlExtra += `
                <label class="check-item"><input type="checkbox" class="task" value="Inspectie"> Inspecție Vizuală</label>
                <label class="check-item"><input type="checkbox" class="task" value="Igienizare"> Curățenie</label>`;
        }
        
        htmlExtra += `</div><div class="group" style="margin-top:10px;"><label>Verificare Manuală (Extra)</label><input type="text" id="extraCheck" placeholder="Ex: Presiune aer 6 bari"></div>`;
        
        divExtra.innerHTML = htmlExtra;
    }

    // --- 9. VERIFICARE BUTON SALVARE ---
    function checkReady() {
        const numeCompletat = document.getElementById('nume').value.trim().length > 2;
        const areLocatie = (selectedId !== null) || (currentCoords !== null);
        
        document.getElementById('saveBtn').disabled = !(areLocatie && numeCompletat);
    }

    // --- 10. ȘTERGERE UTILAJ ---
    async function stergeUtilaj(id) {
        if (confirm("ATENȚIE! Ești sigur că vrei să ștergi acest utilaj și întreg istoricul lui de mentenanță din baza de date?")) {
            try {
                await database.ref('utilaje/' + id).remove();
                resetForm();
            } catch(e) {
                alert("Eroare la ștergere: " + e.message);
            }
        }
    }

    // --- 11. FUNCȚIA PRINCIPALĂ DE SALVARE ---
    async function salveaza() {
        const btnSalvare = document.getElementById('saveBtn');
        const mesajFeedback = document.getElementById('feedbackMsg');
        
        // Dezactivăm butonul și arătăm că se încarcă
        btnSalvare.disabled = true; 
        btnSalvare.innerText = "⏳ SE SALVEAZĂ...";

        try {
            // Colectăm bifele
            const check-uri = Array.from(document.querySelectorAll('.task:checked')).map(c => c.value).join(", ");
            const inputManual = document.getElementById('extraCheck') ? document.getElementById('extraCheck').value : "";
            const verificariFinale = check-uri + (inputManual ? " | " + inputManual : "");

            // Construim obiectul pentru istoric
            const istoricEntry = {
                data: document.getElementById('data').value,
                verificari: verificariFinale,
                obs: document.getElementById('obs').value,
                timestamp: Date.now() // Timp exact pentru a păstra ordinea
            };

            if (selectedId) {
                // Dacă utilajul există deja, adăugăm o intervenție NOUĂ în istoricul lui
                const referintaIstoricNou = database.ref('utilaje/' + selectedId + '/istoric').push();
                await referintaIstoricNou.set(istoricEntry);
                
                // Actualizăm modelul în cazul în care a fost corectat
                await database.ref('utilaje/' + selectedId + '/model').set(document.getElementById('model').value);
                
            } else {
                // Dacă este un utilaj complet nou pe hartă
                const idNou = "K-" + Date.now();
                
                const utilajNou = {
                    id: idNou,
                    nume: document.getElementById('nume').value,
                    model: document.getElementById('model').value,
                    sectie: document.getElementById('sectie').value,
                    lat: parseFloat(currentCoords[0]),
                    lng: parseFloat(currentCoords[1]),
                    istoric: { 
                        "init": istoricEntry 
                    }
                };
                
                await database.ref('utilaje/' + idNou).set(utilajNou);
            }

            // Arătăm mesaj de SUCCES
            mesajFeedback.innerText = "✅ SALVAT CU SUCCES!";
            mesajFeedback.className = "msg-popup msg-success";
            mesajFeedback.style.display = "block";

            // După 2 secunde, resetăm formularul automat
            setTimeout(() => {
                resetForm();
                btnSalvare.innerText = "💾 SALVEAZĂ ÎN CLOUD";
                mesajFeedback.style.display = "none";
            }, 2000);

        } catch(eroare) {
            // Arătăm mesaj de EROARE dacă a picat netul
            mesajFeedback.innerText = "❌ EROARE: " + eroare.message;
            mesajFeedback.className = "msg-popup msg-error";
            mesajFeedback.style.display = "block";
            
            btnSalvare.disabled = false;
            btnSalvare.innerText = "💾 ÎNCEARCĂ DIN NOU";
        }
    }

    // --- 12. RESETARE FORMULAR PENTRU ACȚIUNI NOI ---
    function resetForm() {
        selectedId = null; 
        currentCoords = null;
        
        document.getElementById('nume').value = ""; 
        document.getElementById('model').value = ""; 
        document.getElementById('obs').value = "";
        
        document.getElementById('status').innerHTML = `MOD: UTILAJ NOU`;
        document.getElementById('status').className = "status-badge";
        
        document.getElementById('deleteZone').innerHTML = "";
        
        if (activeMarker) {
            map.removeLayer(activeMarker);
        }
        
        toggleExtra(); 
        checkReady();
    }

    // --- 13. INIȚIALIZARE LA PORNIRE ---
    toggleExtra();
    
    // Ajută harta Leaflet să se randeze corect după ce interfața este gata
    window.onload = () => { 
        setTimeout(() => {
            map.invalidateSize();
        }, 500); 
    };

</script>
</body>
</html>
