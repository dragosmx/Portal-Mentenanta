        .btn-save { background: var(--success); color: white; padding: 18px; border: none; border-radius: 12px; width: 100%; cursor: pointer; font-weight: bold; text-transform: uppercase; margin-top: 10px; transition: 0.3s; }
        .btn-save:disabled { opacity: 0.2; cursor: not-allowed; }
        .btn-del { background: none; color: var(--danger); border: 1px solid var(--danger); padding: 8px; border-radius: 8px; cursor: pointer; font-size: 10px; width: 100%; margin-top: 15px; font-weight: bold; }

        #map { flex: 1; background: #222; cursor: crosshair; }
