<div id="map"></div>

<script>
    const firebaseConfig = { databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" };
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    var map = L.map('map', { crs: L.CRS.Simple, minZoom: 0, maxZoom: 3 });
    L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map);
    map.setView([500, 700], 1); 

    let dbRaw = {}, markersGroup = L.layerGroup().addTo(map);
    let activeMarker = null, selectedId = null, currentCoords = null;
    document.getElementById('data').valueAsDate = new Date();

    database.ref('utilaje').on('value', (snap) => {
        dbRaw = snap.val() || {};
        refreshPini();
    });

    function refreshPini() {
        markersGroup.clearLayers();
        Object.keys(dbRaw).forEach(id => {
            const u = dbRaw[id];
            const m = L.marker([u.lat, u.lng], {
                icon: L.icon({ iconUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon.png', className: 'existing-pin', iconSize: [25, 41], iconAnchor: [12, 41] })
            }).addTo(markersGroup);
            m.on('click', (e) => { L.DomEvent.stopPropagation(e); incarcaUtilaj(id); });
        });
    }

    map.on('click', (e) => {
        if(selectedId) return;
        currentCoords = [e.latlng.lat.toFixed(0), e.latlng.lng.toFixed(0)];
        if(activeMarker) map.removeLayer(activeMarker);
        activeMarker = L.marker(e.latlng).addTo(map);
        checkReady();
    });

    function incarcaUtilaj(id) {
        selectedId = id; const u = dbRaw[id];
        document.getElementById('nume').value = u.nume;
        document.getElementById('model').value = u.model || "";
        document.getElementById('sectie').value = u.sectie;
        document.getElementById('status').innerHTML = `MOD: EDITARE UTILAJ<br>ID: ${id}`;
        document.getElementById('status').className = "status-badge status-edit";
        document.getElementById('deleteZone').innerHTML = `<button class="btn-del" onclick="stergeUtilaj('${id}')">⚠️ ȘTERGE UTILAJ DEFINITIV</button>`;
        if(activeMarker) map.removeLayer(activeMarker);
        toggleExtra(); checkReady();
    }

    function toggleExtra() {
        const s = document.getElementById('sectie').value;
        const ex = document.getElementById('extraFields');
        let html = '<label>Verificări Specifice:</label><div class="checklist">';
        if (s === 'Tratament Termic' || s === 'Secție Crude') {
            html += `<label class="check-item"><input type="checkbox" class="task" value="Sonde"> Sonde</label><label class="check-item"><input type="checkbox" class="task" value="Clapete"> Clapete</label><label class="check-item"><input type="checkbox" class="task" value="Generator"> Generator</label>`;
        } else if (['Tocare', 'Injectare', 'Fabricație', 'Tranșare'].includes(s)) {
            html += `<label class="check-item"><input type="checkbox" class="task" value="Ulei"> Ulei</label><label class="check-item"><input type="checkbox" class="task" value="Lanturi"> Lanțuri</label><label class="check-item"><input type="checkbox" class="task" value="Rulmenti"> Rulmenți</label>`;
        } else if (s === 'Ambalare Vid') {
            html += `<label class="check-item"><input type="checkbox" class="task" value="Pompa"> Pompă Vid</label><label class="check-item"><input type="checkbox" class="task" value="Lipire"> Rezistențe</label>`;
        } else {
            html += `<label class="check-item"><input type="checkbox" class="task" value="Inspectie"> Inspecție Vizuală</label>`;
        }
        html += `</div><div class="group" style="margin-top:10px;"><label>Manual Check</label><input type="text" id="extraCheck"></div>`;
        ex.innerHTML = html;
    }

    function checkReady() {
        const hasNume = document.getElementById('nume').value.trim().length > 2;
        document.getElementById('saveBtn').disabled = !( (selectedId || currentCoords) && hasNume );
    }

    async function stergeUtilaj(id) {
        if(confirm("Ștergi utilajul și tot istoricul?")) {
            await database.ref('utilaje/' + id).remove();
            resetForm();
        }
    }

    async function salveaza() {
        const btn = document.getElementById('saveBtn');
        const msg = document.getElementById('feedbackMsg');
        btn.disabled = true; btn.innerText = "⏳ SALVEAZĂ...";
        
        try {
            const bife = Array.from(document.querySelectorAll('.task:checked')).map(c => c.value).join(", ");
            const manual = document.getElementById('extraCheck') ? document.getElementById('extraCheck').value : "";
            const entry = { data: document.getElementById('data').value, verificari: bife + (manual ? " | " + manual : ""), obs: document.getElementById('obs').value };

            if(selectedId) {
                const newKey = database.ref().child('utilaje/' + selectedId + '/istoric').push().key;
                await database.ref('utilaje/' + selectedId + '/istoric/' + newKey).set(entry);
                await database.ref('utilaje/' + selectedId + '/model').set(document.getElementById('model').value);
            } else {
                const id = "K" + Math.floor(Date.now() / 1000000);
                await database.ref('utilaje/' + id).set({ id: id, nume: document.getElementById('nume').value, model: document.getElementById('model').value, sectie: document.getElementById('sectie').value, lat: parseFloat(currentCoords[0]), lng: parseFloat(currentCoords[1]), istoric: { [database.ref().push().key]: entry } });
            }

            msg.innerText = "✅ SALVAT CU SUCCES!";
            msg.className = "msg-popup msg-success";
            msg.style.display = "block";
            setTimeout(() => { resetForm(); btn.innerText = "💾 SALVEAZĂ ÎN CLOUD"; msg.style.display = "none"; }, 2000);
        } catch(e) {
            msg.innerText = "❌ EROARE: " + e.message;
            msg.className = "msg-popup msg-error";
            msg.style.display = "block";
            btn.disabled = false; btn.innerText = "💾 ÎNCEARCĂ DIN NOU";
        }
    }

    function resetForm() {
        selectedId = null; currentCoords = null;
        document.getElementById('nume').value = ""; document.getElementById('model').value = ""; document.getElementById('obs').value = "";
        document.getElementById('status').innerHTML = `MOD: UTILAJ NOU`;
        document.getElementById('status').className = "status-badge";
        document.getElementById('deleteZone').innerHTML = "";
        if(activeMarker) map.removeLayer(activeMarker);
        toggleExtra(); checkReady();
    }

    toggleExtra();
    window.onload = () => { setTimeout(() => map.invalidateSize(), 500); };
</script>
</body>
</html>
iar ai scos linii de cod

Îmi cer scuze, m-am lăsat dus de val cu optimizarea și am tăiat din "mușchii" aplicației. Ai dreptate, un cod profesional trebuie să fie robust și să nu piardă funcții de la o versiune la alta.

Am refăcut edit.html astfel încât să fie varianta completă, extinsă și definitivă. Nu am mai scos nicio linie; din contră, am consolidat tot ce am discutat:

Toate cele 11 Secții (inclusiv Compresoare, Spălare, Crude etc.).

Profile de Mentenanță Full: Bife specifice pentru fiecare tip de utilaj (Sonde, Pompă Vid, Cuțite, etc.).

Marcă / Model / Serie: Câmp dedicat.

Sistem de Feedback vizual: Mesajele de succes/eroare sub buton.

Editare Istoric: Click pe un pin existent încarcă datele pentru o intervenție nouă.

Ștergere Utilaj: Butonul de panică pentru eliminarea erorilor.

Securitate: Parolă, Paznic de acces și Auto-Logout.

Developed by Dragos Munteanu • 2026.

