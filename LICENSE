<script>
    const firebaseConfig = { databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" };
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    var map = L.map('map', { crs: L.CRS.Simple, minZoom: 0, maxZoom: 3 });
    L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map);
    map.setView([500, 700], 1); 

    let dbRaw = {}, markersGroup = L.layerGroup().addTo(map), activeMarker = null, selectedId = null, currentCoords = null;
    document.getElementById('data').valueAsDate = new Date();

    database.ref('utilaje').on('value', (snap) => { dbRaw = snap.val() || {}; refreshPini(); });

    function refreshPini() {
        markersGroup.clearLayers();
        Object.keys(dbRaw).forEach(id => {
            const u = dbRaw[id];
            if(u.lat && u.lng) {
                const m = L.marker([u.lat, u.lng], { icon: L.icon({ iconUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon.png', className: 'existing-pin', iconSize: [25, 41], iconAnchor: [12, 41] }) }).addTo(markersGroup);
                m.on('click', (e) => { L.DomEvent.stopPropagation(e); incarcaUtilaj(id); });
            }
        });
    }

    map.on('click', (e) => {
        if(selectedId) return; 
        currentCoords = [e.latlng.lat.toFixed(0), e.latlng.lng.toFixed(0)];
        if(activeMarker) map.removeLayer(activeMarker);
        activeMarker = L.marker(e.latlng).addTo(map); checkReady();
    });

    function incarcaUtilaj(id) {
        selectedId = id; const u = dbRaw[id];
        document.getElementById('nume').value = u.nume; document.getElementById('model').value = u.model || ""; document.getElementById('sectie').value = u.sectie;
        document.getElementById('status').innerHTML = `MOD: EDITARE UTILAJ (ID: ${id})`; document.getElementById('status').className = "status-badge status-edit";
        document.getElementById('deleteZone').innerHTML = `<button class="btn-del" onclick="stergeUtilaj('${id}')">⚠️ ȘTERGE UTILAJ DEFINITIV</button>`;
        if(activeMarker) map.removeLayer(activeMarker); toggleExtra(); checkReady();
    }

    function toggleExtra() {
        const s = document.getElementById('sectie').value;
        let html = '<label>Operațiuni Plan 2026:</label><div class="checklist">';

        if (s === 'Tocare' || s === 'Injectare') {
            html += `<label class="check-item"><input type="checkbox" class="task" value="Ungere Rulmenți"> Ungere Rulmenți</label><label class="check-item"><input type="checkbox" class="task" value="Schimb Ulei Transmisie"> Schimb Ulei Transmisie</label><label class="check-item"><input type="checkbox" class="task" value="Curele Transmisie"> Reîntindere/Schimb Curele</label><label class="check-item"><input type="checkbox" class="task" value="Filtru Aer"> Filtru Aer</label>`;
        } else if (s === 'Ambalare Vid') {
            html += `<label class="check-item"><input type="checkbox" class="task" value="Nivel Ulei Pompa"> Nivel Ulei Pompă Vid</label><label class="check-item"><input type="checkbox" class="task" value="Schimb Ulei Pompa"> Schimb Ulei Pompă Vid</label><label class="check-item"><input type="checkbox" class="task" value="Rezistente Lipire"> Rezistențe Lipire</label><label class="check-item"><input type="checkbox" class="task" value="Banda Teflon"> Bandă Teflon</label><label class="check-item"><input type="checkbox" class="task" value="Garnituri"> Garnituri</label>`;
        } else if (s === 'Tratament Termic') {
            html += `<label class="check-item"><input type="checkbox" class="task" value="Curatare Generator Fum"> Curățare Generator Fum</label><label class="check-item"><input type="checkbox" class="task" value="Calibrare Sonde"> Calibrare Sonde</label><label class="check-item"><input type="checkbox" class="task" value="Verificare Rezistente"> Verificare Rezistențe</label><label class="check-item"><input type="checkbox" class="task" value="Ungere Pistoane"> Ungere Pistoane</label>`;
        } else if (s === 'Depozitare' || s === 'Fabricație') {
            html += `<label class="check-item"><input type="checkbox" class="task" value="Spalare Condensator"> Spălare Condensator</label><label class="check-item"><input type="checkbox" class="task" value="Nivel Agent Frigorific"> Nivel Agent Frig.</label><label class="check-item"><input type="checkbox" class="task" value="Rezistente Decongelare"> Rezistențe Decongelare</label>`;
        } else {
            html += `<label class="check-item"><input type="checkbox" class="task" value="Inspectie Vizuala"> Inspecție Vizuală</label><label class="check-item"><input type="checkbox" class="task" value="Verificare Tablou Electric"> Tablou Electric</label>`;
        }
        html += `</div><div class="group" style="margin-top:10px;"><label>Altă operațiune:</label><input type="text" id="extraCheck"></div>`;
        document.getElementById('extraFields').innerHTML = html;
    }

    function checkReady() {
        document.getElementById('saveBtn').disabled = !( (selectedId || currentCoords) && document.getElementById('nume').value.trim().length > 2 );
    }

    async function stergeUtilaj(id) { if (confirm("Ștergi utilajul?")) { await database.ref('utilaje/' + id).remove(); resetForm(); } }

    async function salveaza() {
        const btn = document.getElementById('saveBtn'); const msg = document.getElementById('feedbackMsg');
        btn.disabled = true; btn.innerText = "⏳ SE SALVEAZĂ...";

        try {
            const bife = Array.from(document.querySelectorAll('.task:checked')).map(c => c.value).join(", ");
            const manual = document.getElementById('extraCheck') ? document.getElementById('extraCheck').value : "";
            
            const entry = {
                data: document.getElementById('data').value,
                tip: document.getElementById('tipInterventie').value,
                mecanic: document.getElementById('mecanic').value,
                verificari: bife + (manual ? " | " + manual : ""),
                obs: document.getElementById('obs').value,
                timestamp: Date.now()
            };

            if (selectedId) {
                await database.ref('utilaje/' + selectedId + '/istoric').push().set(entry);
                await database.ref('utilaje/' + selectedId + '/model').set(document.getElementById('model').value);
                await database.ref('utilaje/' + selectedId + '/sectie').set(document.getElementById('sectie').value);
            } else {
                const idNou = "K-" + Math.floor(1000 + Math.random() * 9000);
                await database.ref('utilaje/' + idNou).set({ id: idNou, nume: document.getElementById('nume').value, model: document.getElementById('model').value, sectie: document.getElementById('sectie').value, lat: parseFloat(currentCoords[0]), lng: parseFloat(currentCoords[1]), istoric: { "init": entry } });
            }

            msg.innerText = "✅ SALVAT CU SUCCES!"; msg.className = "msg-popup msg-success"; msg.style.display = "block";
            setTimeout(() => { resetForm(); btn.innerText = "💾 SALVEAZĂ FIȘA"; msg.style.display = "none"; }, 2000);
        } catch(e) {
            msg.innerText = "❌ EROARE: " + e.message; msg.className = "msg-popup msg-error"; msg.style.display = "block";
            btn.disabled = false; btn.innerText = "💾 ÎNCEARCĂ DIN NOU";
        }
    }

    function resetForm() {
        selectedId = null; currentCoords = null;
        document.getElementById('nume').value = ""; document.getElementById('model').value = ""; document.getElementById('obs').value = ""; document.getElementById('mecanic').value = "";
        document.getElementById('status').innerHTML = `MOD: UTILAJ NOU`; document.getElementById('status').className = "status-badge"; document.getElementById('deleteZone').innerHTML = "";
        if (activeMarker) map.removeLayer(activeMarker); toggleExtra(); checkReady();
    }

    toggleExtra(); window.onload = () => { setTimeout(() => map.invalidateSize(), 500); };
</script>
</body>
