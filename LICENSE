<script>
    const firebaseConfig = { databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" };
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    var map = L.map('map', { crs: L.CRS.Simple, minZoom: 0, maxZoom: 3, zoomControl: false });
    L.control.zoom({ position: 'bottomright' }).addTo(map);
    L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map);
    map.setView([500, 700], 0.5);

    let dbRaw = {}; 
    let markersList = []; 
    let chartInstance = null;

    database.ref('utilaje').on('value', (snap) => {
        dbRaw = snap.val() || {};
        afiseazaPuncte();
    });

    function calculZile(dataStr) {
        if (!dataStr || dataStr === "-") return 999;
        return Math.floor((new Date() - new Date(dataStr)) / (1000 * 3600 * 24));
    }

    function getColoredIcon(color) {
        const svg = `<svg viewBox="0 0 24 36" width="28" height="42"><path fill="${color}" stroke="#000" stroke-width="1.5" d="M12 0C5.373 0 0 5.373 0 12c0 7.333 12 24 12 24s12-16.667 12-24C24 5.373 18.627 0 12 0zm0 17.5c-3.038 0-5.5-2.462-5.5-5.5S8.962 6.5 12 6.5s5.5 2.462 5.5 5.5-2.462 5.5-5.5 5.5z"/></svg>`;
        return L.divIcon({ className: "custom-pin", html: svg, iconSize: [28, 42], iconAnchor: [14, 42], popupAnchor: [0, -40] });
    }

    function afiseazaPuncte() {
        const filtru = document.getElementById('filterSectie').value;
        markersList.forEach(m => map.removeLayer(m));
        markersList = [];
        let boundsArray = [];

        Object.keys(dbRaw).forEach(id => {
            const u = dbRaw[id];
            if (filtru !== "Toate" && u.sectie !== filtru) return;
            if (!u.lat || !u.lng) return;

            let ultimaData = "-";
            let popTabel = "";
            if (u.istoric) {
                const ist = Object.values(u.istoric).sort((a, b) => new Date(b.data) - new Date(a.data));
                ultimaData = ist[0].data;
                ist.slice(0, 2).forEach(i => { popTabel += `<tr><td><b>${i.data}</b></td><td>${i.verificari}</td></tr>`; });
            }
            
            const zile = calculZile(ultimaData);
            let col = zile < 30 ? "#27ae60" : (zile < 90 ? "#f39c12" : "#e74c3c");

            const m = L.marker([u.lat, u.lng], { icon: getColoredIcon(col) }).addTo(map);
            boundsArray.push([u.lat, u.lng]);
            
            m.bindPopup(`<div class="popup-header"><h3>${u.nume}</h3><p>ID: ${u.id}</p></div><div class="popup-body"><b>Status: ${zile === 999 ? 'Lipsește' : zile + ' zile'}</b><table style="width:100%; font-size:10px; margin-top:5px;">${popTabel}</table><button class="btn-history" onclick="deschideIstoricUtilaj('${id}')">📜 VEZI ISTORIC</button></div>`);
            m.uData = { id: String(u.id).toUpperCase(), nume: u.nume.toUpperCase() };
            markersList.push(m);
        });

        if (boundsArray.length > 0 && filtru !== "Toate") map.fitBounds(boundsArray, { padding: [50, 50], maxZoom: 1.5 });
        else if (filtru === "Toate") map.setView([500, 700], 0.5);
    }

    function deschideIstoricUtilaj(id) {
        const u = dbRaw[id];
        document.getElementById('histNume').innerText = u.nume;
        document.getElementById('histModel').innerText = "Model: " + (u.model || "-");
        const corp = document.getElementById('corpIstoricIndividual');
        corp.innerHTML = "";
        if (u.istoric) {
            Object.values(u.istoric).sort((a,b)=>new Date(b.data)-new Date(a.data)).forEach(i => {
                corp.innerHTML += `<tr><td>${i.data}</td><td>${i.tip||'Plan'}</td><td>${i.mecanic||'-'}</td><td>${i.verificari}</td></tr>`;
            });
        }
        document.getElementById('historyModal').style.display = "flex";
    }

    function deschideRapoarte() {
        let ok=0, wr=0, cr=0, total=0;
        const cS = document.getElementById('corpScadente');
        const cF = document.getElementById('corpFluxLive');
        cS.innerHTML = ""; cF.innerHTML = "";
        let fluxArray = [];

        Object.values(dbRaw).forEach(u => {
            let uD = "-";
            if (u.istoric) {
                const ist = Object.values(u.istoric).sort((a,b)=>new Date(b.data)-new Date(a.data));
                uD = ist[0].data; total += ist.length;
                Object.values(u.istoric).forEach(i => fluxArray.push({ d: i.data, n: u.nume, m: i.mecanic, a: i.verificari }));
            }
            const z = calculZile(uD);
            if (z < 30) ok++; else if (z < 90) wr++; else cr++;
            if (z >= 30 || uD === "-") {
                cS.innerHTML += `<tr><td><b>${u.nume}</b></td><td>${z === 999 ? 'L' : z}</td><td><span class="status-pill ${z > 90 ? 'bg-crit' : 'bg-warn'}">${z > 90 ? 'C' : 'W'}</span></td></tr>`;
            }
        });

        fluxArray.sort((a,b)=>new Date(b.d)-new Date(a.d)).slice(0, 20).forEach(f => {
            cF.innerHTML += `<tr><td>${f.d}</td><td><b>${f.n}</b></td><td>${f.m || '-'}</td><td><small>${f.a}</small></td></tr>`;
        });

        document.getElementById('totalInterventii').innerText = total;
        if (chartInstance) chartInstance.destroy();
        chartInstance = new Chart(document.getElementById('statusChart'), {
            type: 'doughnut',
            data: { labels: ['OK', 'Atenție', 'Critic'], datasets: [{ data: [ok, wr, cr], backgroundColor: ['#27ae60', '#f39c12', '#e74c3c'], borderWidth: 0 }] },
            options: { plugins: { legend: { position: 'bottom' } } }
        });
        document.getElementById('reportModal').style.display = "flex";
    }

    function exportaExcelNativ() {
        let d = []; Object.values(dbRaw).forEach(u => { if (u.istoric) Object.values(u.istoric).forEach(i => d.push({ Data: i.data, Utilaj: u.nume, Activitate: i.verificari })); });
        const ws = XLSX.utils.json_to_sheet(d); const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, ws, "Raport"); XLSX.writeFile(wb, "Killer_Mentenanta.xlsx");
    }

    function exportaPDF() {
        const element = document.getElementById('pdfArea');
        html2pdf().set({ margin: 10, filename: 'Raport_Killer.pdf', jsPDF: { orientation: 'landscape' } }).from(element).save();
    }

    function printeazaQR() {
        let b = window.location.href.substring(0, window.location.href.lastIndexOf("/") + 1);
        let w = window.open('', '_blank');
        let h = `<html><head><style>body{font-family:sans-serif;text-align:center;}.grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;}.card{border:1px dashed #666;padding:8px;}img{max-width:80px;}</style></head><body><div class="grid">`;
        Object.values(dbRaw).forEach(u => { h += `<div class="card"><img src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=${encodeURIComponent(b+'scan.html?id='+u.id)}"><br><b>${u.nume}</b><br>ID: ${u.id}</div>`; });
        h += '</div></body></html>'; w.document.write(h); w.document.close();
    }

    function inchideModal(id) { document.getElementById(id).style.display = "none"; }
    function cauta() {
        const v = document.getElementById('searchInput').value.toUpperCase();
        const m = markersList.find(x => x.uData.id.includes(v) || x.uData.nume.includes(v));
        if (m) { map.setView(m.getLatLng(), 1.5); m.openPopup(); }
    }
    window.onload = () => setTimeout(() => map.invalidateSize(), 600);
</script>
</body>
</html>
putem face si o aplicatie tip apk ?

Da, putem transforma acest sistem într-o aplicație pe care să o instalezi direct pe telefon, dar există două căi diferite în funcție de cât de complex vrei să fie procesul:

1. Varianta Rapidă: PWA (Progressive Web App)
Aceasta este cea mai recomandată variantă pentru ce am construit noi. Nu necesită publicare în Google Play Store și se instalează direct din browser (Chrome).

Cum funcționează:

Adăugăm un mic fișier numit manifest.json în folderul tău.

Când deschizi link-ul pe telefon, browserul te va întreba: "Adăugați pe ecranul de pornire?".

Odată acceptat, vei avea pictograma Killer SRL pe ecranul telefonului, se va deschide fără bara de adrese a browserului și va arăta exact ca un APK nativ.

2. Varianta "Adevăratul APK" (via Capacitor sau Cordova)
Dacă vrei neapărat un fișier .apk pe care să îl trimiți prin WhatsApp și să îl instalezi:

Tehnologie: Vom folosi Capacitor (de la Ionic). Acesta ia codul tău HTML/JS și îl "împachetează" într-un container de Android.

Cerințe: Ai nevoie de un calculator cu Android Studio instalat pentru a genera fișierul final.

Avantaj: Poți accesa mai bine funcțiile hardware (cum ar fi vibrațiile la scanare sau notificările push).

Recomandarea mea: Să începem cu PWA
Este "cloud online" (cum ziceai tu), se actualizează instant la toți utilizatorii când schimbi ceva în cod și nu ocupă memorie în telefon.

Vrei să pregătim fișierele pentru varianta PWA (pictogramă pe ecran)? Dacă da, va trebui să îmi spui:

Ce nume să apară sub pictogramă (ex: "Killer Mentenanță").

Să ai o imagine logo.png pătrată (pentru iconița de pe ecran).

P.S.: Legat de codul de 700 de linii pe care l-am tot scurtat: Motivul pentru care s-a scurtat a fost că am încercat să îl pun într-un singur mesaj și sistemul l-a tăiat. Pe viitor, dacă facem modificări mari, o să ți-l dau pe secțiuni (CSS separat, JS separat) ca să fim siguri că nu pierdem nicio virgulă!

facem momentan prima varianta. dar intai de toate poti creea un fisier chage log? si unul de licenta?

Excelentă idee! Orice proiect serios are nevoie de un Changelog (pentru a urmări evoluția și modificările) și de o Licență (pentru a stabili regulile de utilizare, mai ales că este un proiect personalizat).

Iată conținutul pentru cele două fișiere:

1. Fișierul CHANGELOG.md
Creează un fișier nou numit CHANGELOG.md și lipește acest text. Acesta reflectă toate etapele prin care am trecut până acum.

Markdown
# CHANGELOG - Sistem Mentenanță Killer SRL

Toate modificările notabile ale acestui proiect vor fi documentate în acest fișier.

## [1.2.0] - 2026-05-11
### Adăugat
- **Flux Live Intervenții**: Listă cu scroll în Dashboard care arată ultimele 20 de intervenții din toată fabrica.
- **Auto-Zoom pe Secție**: Harta face zoom automat pe grupul de utilaje atunci când este selectată o secție.
- **Export PDF**: Funcție de generare raport oficial direct din Dashboard.
- **Semnătură Vizuală**: Adăugat "Developed by Dragos Munteanu • 2026" pe hartă și în rapoarte.

### Modificat
- **UI/UX**: Mutat butoanele de Zoom (+/-) în dreapta-jos pentru a evita suprapunerea cu panoul de căutare.
- **Dashboard**: Reorientare completă pe date tehnice; eliminat afișarea costurilor financiare.
- **QR Code**: Optimizat layout-ul de printare (5 etichete pe rând, format compact A4).

## [1.1.0] - 2026-05-10
### Adăugat
- Integrare Google Firebase pentru stocarea datelor în timp real.
- Sistem de culori pentru pini în funcție de scadență (Verde, Galben, Roșu).
- Export Excel pentru istoricul intervențiilor.

## [1.0.0] - 2026-05-09
### Adăugat
- Versiunea inițială a hărții interactive.
- Funcție de scanare QR pentru identificarea utilajului.
- Formular de introducere intervenții tehnice.
