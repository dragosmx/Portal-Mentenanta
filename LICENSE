<script>
    const firebaseConfig = { databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" };
    firebase.initializeApp(firebaseConfig); const db = firebase.database();
    var map = L.map('map', { crs: L.CRS.Simple, minZoom: 0, maxZoom: 3, zoomControl: false });
    L.control.zoom({ position: 'bottomright' }).addTo(map); L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map); map.setView([500, 700], 0.5);
    let dbR = {}, mList = [], chart = null;
    db.ref('utilaje').on('value', (s) => { dbR = s.val() || {}; afiseazaPuncte(); });
    function cZ(d) { if(!d || d === "-") return 999; return Math.floor((new Date() - new Date(d)) / 864e5); }
    function gCI(c) { 
        const s = `<svg viewBox="0 0 24 36" width="28" height="42"><path fill="${c}" stroke="#000" d="M12 0C5.4 0 0 5.4 0 12c0 7.3 12 24 12 24s12-16.7 12-24C24 5.4 18.6 0 12 0zm0 17.5c-3 0-5.5-2.5-5.5-5.5s2.5-5.5 5.5-5.5 5.5 2.5 5.5 5.5-2.5 5.5-5.5 5.5z"/></svg>`;
        return L.divIcon({ className: "custom-pin", html: s, iconSize: [28, 42], iconAnchor: [14, 42], popupAnchor: [0, -40] });
    }
    function afiseazaPuncte() {
        const f = document.getElementById('fS').value; mList.forEach(m => map.removeLayer(m)); mList = []; let b = [];
        Object.keys(dbR).forEach(id => {
            const u = dbR[id]; if(f !== "Toate" && u.sectie !== f) return; if(!u.lat || !u.lng) return;
            let uD = "-", pop = ""; if(u.istoric) {
                const ist = Object.values(u.istoric).sort((a,b)=>new Date(b.data)-new Date(a.data)); uD = ist[0].data;
                ist.slice(0, 2).forEach(i => pop += `<tr><td><b>${i.data}</b></td><td>${i.verificari}</td></tr>`);
            }
            const z = cZ(uD); let col = z < 30 ? "#27ae60" : (z < 90 ? "#f39c12" : "#e74c3c");
            const m = L.marker([u.lat, u.lng], { icon: gCI(col) }).addTo(map); b.push([u.lat, u.lng]);
            m.bindPopup(`<div class="popup-header"><h3>${u.nume}</h3><p>ID: ${u.id}</p></div><div class="popup-body"><b>Status: ${z} zile</b><table style="width:100%; font-size:10px; margin-top:5px;">${pop}</table><button class="btn-h" onclick="deschideHist('${id}')">📜 ISTORIC</button></div>`);
            m.uD = { id: String(u.id).toUpperCase(), n: u.nume.toUpperCase() }; mList.push(m);
        });
        if(b.length > 0 && f !== "Toate") map.fitBounds(b, { padding: [50, 50], maxZoom: 1.5 });
    }
    function deschideHist(id) {
        const u = dbR[id]; document.getElementById('hN').innerText = u.nume; document.getElementById('hMd').innerText = u.model || "-";
        const c = document.getElementById('cI'); c.innerHTML = "";
        if(u.istoric) Object.values(u.istoric).sort((a,b)=>new Date(b.data)-new Date(a.data)).forEach(i => {
            c.innerHTML += `<tr><td>${i.data}</td><td>${i.tip||'Plan'}</td><td>${i.mecanic||'-'}</td><td>${i.verificari}</td><td>${i.obs||'-'}</td></tr>`;
        });
        document.getElementById('hM').style.display = "flex";
    }
    function deschideRapoarte() {
        let ok=0, wr=0, cr=0, t=0; const cS = document.getElementById('cS'), cF = document.getElementById('cF');
        cS.innerHTML = ""; cF.innerHTML = ""; let fl = [];
        Object.values(dbR).forEach(u => {
            let uD = "-"; if(u.istoric) {
                const ist = Object.values(u.istoric).sort((a,b)=>new Date(b.data)-new Date(a.data)); uD = ist[0].data; t += ist.length;
                Object.values(u.istoric).forEach(i => fl.push({ d: i.data, n: u.nume, m: i.mecanic, a: i.verificari }));
            }
            const z = cZ(uD); if(z < 30) ok++; else if(z < 90) wr++; else cr++;
            if(z >= 30 || uD === "-") cS.innerHTML += `<tr><td><b>${u.nume}</b></td><td>${z === 999 ? 'L' : z}</td><td><span class="pill ${z > 90 ? 'bg-crit' : 'bg-warn'}">${z > 90 ? 'C' : 'W'}</span></td></tr>`;
        });
        fl.sort((a,b)=>new Date(b.d)-new Date(a.d)).slice(0, 15).forEach(f => cF.innerHTML += `<tr><td>${f.d}</td><td>${f.n}</td><td>${f.m}</td><td>${f.a}</td></tr>`);
        document.getElementById('tI').innerText = t;
        if(chart) chart.destroy();
        chart = new Chart(document.getElementById('sC'), { type: 'doughnut', data: { labels: ['OK','Atenție','Critic'], datasets: [{ data: [ok, wr, cr], backgroundColor: ['#27ae60','#f39c12','#e74c3c'], borderWidth: 0 }] } });
        document.getElementById('rM').style.display = "flex";
    }
    function exportaExcel() {
        let d = []; Object.values(dbR).forEach(u => { if(u.istoric) Object.values(u.istoric).forEach(i => d.push({ Data: i.data, Utilaj: u.nume, Sectie: u.sectie, Activitate: i.verificari })); });
        const ws = XLSX.utils.json_to_sheet(d); const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, ws, "Raport"); XLSX.writeFile(wb, "Mentenanta_Killer.xlsx");
    }
    function exportaPDF() { html2pdf().set({ margin: 10, filename: 'Raport_Killer.pdf', jsPDF: { format: 'a4', orientation: 'landscape' } }).from(document.getElementById('pA')).save(); }
    function printeazaQR() {
        let b = window.location.href.substring(0, window.location.href.lastIndexOf("/") + 1);
        let w = window.open('', '_blank');
        let h = `<html><head><style>body{font-family:sans-serif;text-align:center;}.grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;}.card{border:1px dashed #666;padding:8px;font-size:10px;}img{max-width:80px;}</style></head><body><div class="grid">`;
        Object.values(dbR).forEach(u => { h += `<div class="card"><img src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=${encodeURIComponent(b+'scan.html?id='+u.id)}"><br><b>${u.nume}</b><br>ID: ${u.id}</div>`; });
        h += '</div></body></html>'; w.document.write(h); w.document.close();
    }
    function cauta() {
        const v = document.getElementById('sIn').value.toUpperCase();
        const m = mList.find(x => x.uD.id.includes(v) || x.uD.n.includes(v));
        if(m) { map.setView(m.getLatLng(), 1.5); m.openPopup(); }
    }
    window.onload = () => setTimeout(() => map.invalidateSize(), 600);
</script>
