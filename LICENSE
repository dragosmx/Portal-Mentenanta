        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 2000; align-items: center; justify-content: center; }
        .modal-c { background: #f8f9fa; width: 95%; max-width: 1200px; max-height: 90%; padding: 25px; border-radius: 20px; display: flex; gap: 20px; position: relative; overflow: auto; }
    </style>
