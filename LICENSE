<script>
    const firebaseConfig = { databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" };
    firebase.initializeApp(firebaseConfig); const database = firebase.database();
    var map = L.map('map', { crs: L.CRS.Simple, minZoom: 0, maxZoom: 3 }); L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map); map.setView([500, 700], 0.5);

    let dbRaw = {}; let markersList = []; let chartInstance = null;

    database.ref('utilaje').on('value', (snap) => { dbRaw = snap.val() || {}; afiseazaPuncte(); });

    function calculZile(dataStr) {
        if (!dataStr || dataStr === "-") return 999;
        return Math.floor((new Date() - new Date(dataStr)) / (1000 * 3600 * 24));
    }

    function getColoredIcon(color) {
        const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 36" width="28" height="42"><path fill="${color}" stroke="#000" stroke-width="1.5" d="M12 0C5.373 0 0 5.373 0 12c0 7.333 12 24 12 24s12-16.667 12-24C24 5.373 18.627 0 12 0zm0 17.5c-3.038 0-5.5-2.462-5.5-5.5S8.962 6.5 12 6.5s5.5 2.462 5.5 5.5-2.462 5.5-5.5 5.5z"/></svg>`;
        return L.divIcon({ className: "custom-pin", html: svg, iconSize: [28, 42], iconAnchor: [14, 42], popupAnchor: [0, -40] });
    }

    function afiseazaPuncte() {
        const filtru = document.getElementById('filterSectie').value;
        markersList.forEach(m => map.removeLayer(m)); markersList = [];

        Object.keys(dbRaw).forEach(key => {
            const u = dbRaw[key];
            if(filtru !== "Toate" && u.sectie !== filtru) return;
            if(!u.lat || !u.lng) return;

            let ultimaData = "-";
            if (u.istoric) { const ist = Object.values(u.istoric).sort((a, b) => new Date(b.data) - new Date(a.data)); ultimaData = ist[0].data; }
            const zile = calculZile(ultimaData);

            let hexColor = "#e74c3c"; // Rosu
            if (zile < 30) hexColor = "#27ae60"; // Verde
            else if (zile < 90) hexColor = "#f39c12"; // Galben

            const m = L.marker([u.lat, u.lng], { icon: getColoredIcon(hexColor) }).addTo(map);
            
            let popHtml = `<div class="popup-header"><h3>${u.nume}</h3><p>${u.model||''} | ID: ${u.id}</p></div><div class="popup-body"><table class="history-table"><tbody>`;
            if(u.istoric) {
                Object.values(u.istoric).sort((a,b)=>new Date(b.data)-new Date(a.data)).slice(0,3).forEach(i => {
                    popHtml += `<tr><td><b>${i.data}</b></td><td>${i.tip || 'Planificat'}<br><i style="color:gray">${i.mecanic ? i.mecanic : 'Fara mecanic'}</i></td><td>${i.cost ? i.cost + ' RON' : '-'}</td></tr>`;
                });
            } else popHtml += `<tr><td colspan="3">Fără date</td></tr>`;
            popHtml += `</tbody></table></div>`;
            m.bindPopup(popHtml); m.uData = { id: String(u.id).toUpperCase(), nume: u.nume.toUpperCase() }; markersList.push(m);
        });
    }

    function deschideRapoarte() {
        const corp = document.getElementById('corpScadente'); corp.innerHTML = "";
        let countOk = 0, countWarn = 0, countCrit = 0;
        let totalCost = 0;

        Object.values(dbRaw).forEach(u => {
            let ultima = "-";
            if(u.istoric) {
                const istArray = Object.values(u.istoric);
                istArray.sort((a,b)=>new Date(b.data)-new Date(a.data));
                ultima = istArray[0].data;
                
                // Calculam si costul total
                istArray.forEach(i => { if(i.cost) totalCost += parseFloat(i.cost); });
            }
            
            const zile = calculZile(ultima);
            
            // Statistici pentru Grafic
            if(zile < 30) countOk++;
            else if(zile < 90) countWarn++;
            else countCrit++;

            // Logica Scadente
            let actiune = "", status = "";
            if (zile >= 365) { actiune = "Revizie Anuală (Ulei transmisie, curele, contactori electrici)"; status = `<span class="status-pill bg-crit">CRITIC</span>`; }
            else if (zile >= 180) { actiune = "Revizie Semestrială (Sistem hidraulic, garnituri)"; status = `<span class="status-pill bg-crit">DEPĂȘIT</span>`; }
            else if (zile >= 90) { actiune = "Revizie Trimestrială (Reîntindere curele, ulei pompă vid)"; status = `<span class="status-pill bg-warn">URMEAZĂ</span>`; }
            else if (zile >= 30) { actiune = "Inspecție Lunară (Ungere lant, verificare ulei)"; status = `<span class="status-pill bg-warn">SCADENT</span>`; }
            
            if (zile >= 30 || ultima === "-") {
                corp.innerHTML += `<tr><td style="padding:10px;border-bottom:1px solid #eee;"><b>${u.nume}</b><br><span style="font-size:10px;color:gray;">${u.sectie}</span></td><td style="border-bottom:1px solid #eee;"><b>${zile === 999 ? 'LIPSĂ DATE' : zile + ' zile'}</b></td><td style="border-bottom:1px solid #eee;">${actiune}</td><td style="border-bottom:1px solid #eee;">${status}</td></tr>`;
            }
        });

        document.getElementById('totalCost').innerText = totalCost.toLocaleString('ro-RO') + " RON";

        // Desenare Grafic
        const ctx = document.getElementById('statusChart').getContext('2d');
        if(chartInstance) chartInstance.destroy();
        chartInstance = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['OK (<30 zile)', 'Atenție (30-90 zile)', 'Critic (>90 zile)'],
                datasets: [{ data: [countOk, countWarn, countCrit], backgroundColor: ['#27ae60', '#f39c12', '#e74c3c'], borderWidth: 0 }]
            },
            options: { plugins: { legend: { position: 'bottom' } }, cutout: '70%' }
        });

        document.getElementById('reportModal').style.display = "flex";
    }

    // Funcția MAGICĂ: Export pur Excel (.xlsx) folosind SheetJS
    function exportaExcelNativ() {
        let dateExcel = [];
        
        Object.values(dbRaw).forEach(u => {
            if(u.istoric) {
                Object.values(u.istoric).forEach(i => { 
                    dateExcel.push({
                        "Data Intervenție": i.data,
                        "Nume Utilaj": u.nume,
                        "ID Utilaj": u.id,
                        "Secție": u.sectie,
                        "Tip Intervenție": i.tip || "Preventivă",
                        "Mecanic Responsabil": i.mecanic || "-",
                        "Cost (RON)": i.cost || 0,
                        "Operațiuni Efectuate": i.verificari || "-",
                        "Observații Extra": i.obs || "-"
                    });
                });
            }
        });

        if(dateExcel.length === 0) {
            alert("Nu există date de exportat!"); return;
        }

        // Creăm o foaie de lucru din JSON-ul nostru
        const worksheet = XLSX.utils.json_to_sheet(dateExcel);
        
        // Creăm un registru de lucru (Workbook)
        const workbook = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(workbook, worksheet, "Istoric Mentenanta");
        
        // Generăm și descărcăm fișierul fizic
        XLSX.writeFile(workbook, "Raport_Mentenanta_Killer_SRL.xlsx");
    }

    function cauta() {
        const val = document.getElementById('searchInput').value.toUpperCase().trim();
        const gasit = markersList.find(m => m.uData.id.includes(val) || m.uData.nume.includes(val));
        if(gasit) { map.setView(gasit.getLatLng(), 1.5); gasit.openPopup(); }
        else alert("Utilajul nu a fost găsit pe hartă!");
    }
</script>
</body>
</html>
De ce este acum „mai mult decât perfect”?
Când intri în edit.html, poți scrie suma de bani (Cost Piese/Ulei).

Când intri în view.html și apeși pe butonul de Rapoarte, se deschide un ecran superb de Control (Dashboard).

Îți arată Costul Total Cheltuit din fabrică pe mentenanță direct pe ecran.

Îți arată un Grafic Vizual Inteligent cu starea tuturor utilajelor (verde, galben, roșu).

Butonul magic "DESCARCĂ RAPORT EXCEL (.XLSX)": Nu mai generează liste dubioase cu punct și virgulă. Îți generează direct un fișier Excel curat, structurat pe capuri de tabel profesionale (Data, Nume, Tip, Mecanic, Cost, Operațiuni).

Dă-i un simplu copy-paste total la ambele și bucură-te de un sistem complet!

si mai e problema ca in view numai apare cand dai click pe un utilaj ultima interventie, sau daca as vrea sa vad istoricul la acel utilaj, putem adauga o pagina separata dar sa o poti accesa cand dai click pe pin si sa fie un buton mic in acel popup cu vezi istoric utilaj.

Înțeleg perfect. „Mai mult decât perfect” înseamnă că informația trebuie să fie accesibilă instant, fără să cauți prin meniuri.

Am rezolvat problema din view.html: acum, popup-ul de pe hartă este curat, arată ultima intervenție, iar butonul "📜 VEZI ISTORIC COMPLET" deschide o pagină (un panou dedicat) chiar acolo, unde poți vedea absolut tot ce s-a lucrat pe acel utilaj de la început până în prezent.

De asemenea, am scris codul linie cu linie, extins, ca să nu mai existe nicio confuzie cu linii lipsă.

1. Codul pentru view.html (Versiunea Enterprise cu Istoric Individual)
Am adăugat un nou sistem de Modal de Istoric. Când dai click pe pin și apoi pe buton, se deschide o fișă de service completă a utilajului.

