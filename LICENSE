<script>
    // 1. Initializare Firebase
    const firebaseConfig = { 
        databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" 
    };
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    // 2. Initializare Hartă
    var map = L.map('map', { 
        crs: L.CRS.Simple, 
        minZoom: 0, 
        maxZoom: 3 
    });
    L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map);
    map.setView([500, 700], 0.5);

    let dbRaw = {}; 
    let markersList = []; 
    let chartInstance = null;

    // 3. Preluare Date
    database.ref('utilaje').on('value', (snap) => {
        dbRaw = snap.val() || {};
        afiseazaPuncte();
    });

    // 4. Calculare diferență zile
    function calculZile(dataStr) {
        if (!dataStr || dataStr === "-") return 999;
        const diff = new Date() - new Date(dataStr);
        return Math.floor(diff / (1000 * 3600 * 24));
    }

    // 5. Generare Pini SVG Colorați
    function getColoredIcon(color) {
        const svg = `
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 36" width="28" height="42">
                <path fill="${color}" stroke="#000" stroke-width="1.5" d="M12 0C5.373 0 0 5.373 0 12c0 7.333 12 24 12 24s12-16.667 12-24C24 5.373 18.627 0 12 0zm0 17.5c-3.038 0-5.5-2.462-5.5-5.5S8.962 6.5 12 6.5s5.5 2.462 5.5 5.5-2.462 5.5-5.5 5.5z"/>
            </svg>`;
        return L.divIcon({ 
            className: "custom-pin", 
            html: svg, 
            iconSize: [28, 42], 
            iconAnchor: [14, 42], 
            popupAnchor: [0, -40] 
        });
    }

    // 6. Afișare puncte pe hartă (POPUP DETALIAT CA ÎN IMAGINE)
    function afiseazaPuncte() {
        const filtru = document.getElementById('filterSectie').value;
        markersList.forEach(m => map.removeLayer(m));
        markersList = [];

        Object.keys(dbRaw).forEach(id => {
            const u = dbRaw[id];
            if (filtru !== "Toate" && u.sectie !== filtru) return;
            if (!u.lat || !u.lng) return;

            let ultimaData = "-";
            let tabelPopHtml = "";
            let statusText = "🟢 OK";

            if (u.istoric) {
                // Sortăm descrescător după dată
                const ist = Object.values(u.istoric).sort((a, b) => new Date(b.data) - new Date(a.data));
                ultimaData = ist[0].data;
                
                // Generăm rândurile pentru mini-tabel (maxim 3 intervenții)
                ist.slice(0, 3).forEach(i => {
                    let culoareTip = (i.tip && i.tip.includes('Corectivă')) ? '#e74c3c' : '#27ae60';
                    tabelPopHtml += `
                        <tr>
                            <td style="padding: 6px; border-bottom: 1px solid #eee; vertical-align: top; white-space: nowrap; width: 35%;">
                                <b>${i.data}</b><br>
                                <span style="font-size:9px; color:#7f8c8d;">${i.mecanic || 'Nespecificat'}</span>
                            </td>
                            <td style="padding: 6px; border-bottom: 1px solid #eee; vertical-align: top; font-size:10px;">
                                <span style="color:${culoareTip}; font-weight:bold;">[${i.tip || 'Plan'}]</span><br>
                                <span style="color:#2c3e50;">${i.verificari ? i.verificari : '<i>Nicio operațiune</i>'}</span>
                            </td>
                        </tr>
                    `;
                });
            } else {
                tabelPopHtml = `<tr><td colspan="2" style="text-align:center; padding: 10px;">Lipsă date istoric.</td></tr>`;
            }
            
            const zile = calculZile(ultimaData);

            let hexColor = "#e74c3c"; // Rosu (Implicit)
            if (zile < 30) {
                hexColor = "#27ae60"; // Verde
                statusText = "🟢 ÎN GRAFIC";
            } else if (zile < 90) {
                hexColor = "#f39c12"; // Galben
                statusText = "🟡 NECESITĂ ATENȚIE";
            } else {
                statusText = "🔴 CRITIC / DEPĂȘIT";
            }

            const m = L.marker([u.lat, u.lng], { 
                icon: getColoredIcon(hexColor) 
            }).addTo(map);
            
            // Construcția POPUP-ului (EXACT CA ÎN IMAGINEA TA)
            const popHtml = `
                <div class="popup-header">
                    <h3>${u.nume}</h3>
                    <p>Model: ${u.model || '-'} | ID: ${u.id}</p>
                </div>
                <div class="popup-body">
                    <div class="last-info">
                        <b>Status Actual:</b> ${statusText}<br>
                        <b>Zile scurse de la ultima revizie:</b> ${zile === 999 ? 'Niciodată' : zile + ' zile'}
                    </div>
                    
                    <b style="font-size:11px; color:#2c3e50; text-transform: uppercase;">Ce s-a lucrat ultima oară:</b>
                    <table style="width:100%; border-collapse:collapse; font-size:11px; margin-top:8px; margin-bottom:10px;">
                        <thead>
                            <tr style="background:#f1f2f6; color: #555;">
                                <th style="padding:5px; text-align:left;">Data / Om</th>
                                <th style="padding:5px; text-align:left;">Operațiuni Efectuate</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${tabelPopHtml}
                        </tbody>
                    </table>
                    
                    <button class="btn-history" onclick="deschideIstoricUtilaj('${id}')">📜 VEZI ISTORIC COMPLET</button>
                </div>
            `;
            
            m.bindPopup(popHtml);
            m.uData = { id: String(u.id).toUpperCase(), nume: u.nume.toUpperCase() };
            markersList.push(m);
        });
    }

    // 7. MODAL ISTORIC INDIVIDUAL
    function deschideIstoricUtilaj(id) {
        const u = dbRaw[id];
        document.getElementById('histNume').innerText = u.nume;
        document.getElementById('histModel').innerText = "Model: " + (u.model || "-") + " | Secție: " + u.sectie;
        
        const corp = document.getElementById('corpIstoricIndividual');
        corp.innerHTML = "";
        
        if (u.istoric) {
            const istSorted = Object.values(u.istoric).sort((a, b) => new Date(b.data) - new Date(a.data));
            
            istSorted.forEach(i => {
                corp.innerHTML += `
                    <tr>
                        <td><b>${i.data}</b></td>
                        <td>${i.tip || 'Preventivă'}</td>
                        <td><i>${i.mecanic || '-'}</i></td>
                        <td>${i.verificari || '-'}</td>
                        <td>${i.obs || '-'}</td>
                        <td><b>${i.cost || 0} RON</b></td>
                    </tr>
                `;
            });
        } else {
            corp.innerHTML = "<tr><td colspan='6' style='text-align:center;'>Nu există istoric pentru acest utilaj.</td></tr>";
        }

        document.getElementById('btnExportIndividual').onclick = () => exportaExcelIndividual(id);
        document.getElementById('historyModal').style.display = "flex";
    }

    // 8. DASHBOARD GENERAL
    function deschideRapoarte() {
        const corp = document.getElementById('corpScadente');
        corp.innerHTML = "";
        let cOk = 0, cWarn = 0, cCrit = 0, costTotal = 0;

        Object.values(dbRaw).forEach(u => {
            let ultima = "-";
            if(u.istoric) {
                const ist = Object.values(u.istoric).sort((a,b)=>new Date(b.data)-new Date(a.data));
                ultima = ist[0].data;
                Object.values(u.istoric).forEach(i => costTotal += (parseFloat(i.cost) || 0));
            }
            
            const zile = calculZile(ultima);
            if(zile < 30) cOk++; else if(zile < 90) cWarn++; else cCrit++;

            let actiune = "", status = "";
            if (zile >= 365) { 
                actiune = "Revizie Anuală Plan 2026"; 
                status = `<span class="status-pill bg-crit">CRITIC</span>`; 
            } else if (zile >= 180) { 
                actiune = "Revizie Semestrială"; 
                status = `<span class="status-pill bg-crit">DEPĂȘIT</span>`; 
            } else if (zile >= 30) { 
                actiune = "Control Lunar / Ungere"; 
                status = `<span class="status-pill bg-warn">URMEAZĂ</span>`; 
            }
            
            if (zile >= 90 || ultima === "-") {
                corp.innerHTML += `
                    <tr>
                        <td><b>${u.nume}</b><br><small>${u.sectie}</small></td>
                        <td>${zile === 999 ? 'LIPSĂ' : zile + ' zile'}</td>
                        <td>${actiune || 'Inspecție standard'}</td>
                        <td>${status || '<span class="status-pill bg-warn">URMEAZĂ</span>'}</td>
                    </tr>`;
            }
        });

        document.getElementById('totalCost').innerText = costTotal.toLocaleString() + " RON";

        const ctx = document.getElementById('statusChart').getContext('2d');
        if(chartInstance) chartInstance.destroy();
        chartInstance = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['OK', 'Atenție', 'Critic'],
                datasets: [{ data: [cOk, cWarn, cCrit], backgroundColor: ['#27ae60', '#f39c12', '#e74c3c'], borderWidth: 0 }]
            },
            options: { plugins: { legend: { position: 'bottom' } } }
        });

        document.getElementById('reportModal').style.display = "flex";
    }

    // 9. EXPORT EXCEL
    function exportaExcelNativ() {
        let date = [];
        Object.values(dbRaw).forEach(u => {
            if(u.istoric) {
                Object.values(u.istoric).forEach(i => {
                    date.push({ "Data": i.data, "Utilaj": u.nume, "ID": u.id, "Secție": u.sectie, "Mecanic": i.mecanic, "Tip": i.tip, "Operațiuni": i.verificari, "Cost (RON)": i.cost });
                });
            }
        });
        const ws = XLSX.utils.json_to_sheet(date);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Istoric General");
        XLSX.writeFile(wb, "Raport_Mentenanta_Killer_SRL.xlsx");
    }

    function exportaExcelIndividual(id) {
        const u = dbRaw[id];
        let date = [];
        if(u.istoric) {
            Object.values(u.istoric).forEach(i => {
                date.push({ "Data": i.data, "Tip": i.tip, "Tehnician": i.mecanic, "Operațiuni": i.verificari, "Observații": i.obs, "Cost RON": i.cost });
            });
        }
        const ws = XLSX.utils.json_to_sheet(date);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Fisa Service");
        XLSX.writeFile(wb, `Fisa_Service_${u.nume.replace(/ /g, "_")}.xlsx`);
    }

    function inchideModal(id) { 
        document.getElementById(id).style.display = "none"; 
    }
    
    function cauta() {
        const val = document.getElementById('searchInput').value.toUpperCase().trim();
        const gasit = markersList.find(m => m.uData.id.includes(val) || m.uData.nume.includes(val));
        if(gasit) { 
            map.setView(gasit.getLatLng(), 1.5); 
            gasit.openPopup(); 
        } else {
            alert("Utilajul nu a fost găsit pe hartă!");
        }
    }

    window.onload = () => { 
        setTimeout(() => map.invalidateSize(), 600); 
    };

    function printeazaQR() {
        let basePath = window.location.href.substring(0, window.location.href.lastIndexOf("/") + 1);
        let printWindow = window.open('', '_blank');
        
        let html = `
            <html>
            <head>
                <title>Printare Etichete QR Mentenanță</title>
                <style>
                    body { font-family: 'Arial', sans-serif; text-align: center; background: #fff; }
                    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; padding: 20px; }
                    .card { border: 2px dashed #000; padding: 15px; border-radius: 10px; page-break-inside: avoid; text-align: center; }
                    img { max-width: 150px; height: auto; margin-bottom: 10px; }
                    h3 { margin: 0; font-size: 14px; text-transform: uppercase; }
                    p { margin: 5px 0 0; font-size: 11px; color: #333; font-weight: bold; }
                    @media print { .no-print { display: none; } }
                </style>
            </head>
            <body>
                <button class="no-print" onclick="window.print()" style="padding:15px 30px; font-size:18px; margin:20px; cursor:pointer; background:#27ae60; color:white; border:none; border-radius:10px; font-weight:bold;">🖨️ PRINTARE DOCUMENT</button>
                <div class="grid">
        `;

        Object.values(dbRaw).forEach(u => {
            let linkDeScanat = basePath + 'scan.html?id=' + u.id;
            let imgQrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(linkDeScanat)}`;
            
            html += `
                <div class="card">
                    <img src="${imgQrUrl}" alt="QR">
                    <h3>${u.nume}</h3>
                    <p>Secția: ${u.sectie}</p>
                    <p>ID: ${u.id}</p>
                </div>
            `;
        });

        html += `</div></body></html>`;
        printWindow.document.write(html);
        printWindow.document.close();
    }
</script>
</body>
</html>
se poate integra ca atunci cand caut o anumita sectie sa imi dea harta zoom in zona in care sunt concentrate pinurile?

Absolut! Aceasta este o funcție extrem de utilă (se numește Auto-Zoom pe Bounds). Când alegi o secție, harta va calcula automat "cutia" în care se află toate utilajele din acea secție și va face zoom fix pe ele. Dacă alegi "Toate", harta va reveni la vederea de ansamblu.

Am actualizat funcția afiseazaPuncte() și am rescris tot codul pentru view.html ca să fii sigur că este complet, desfășurat și conține toate detaliile (inclusiv tabelul detaliat cu operațiunile de care ai zis anterior).

Iată codul complet pentru view.html:

