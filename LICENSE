<script>
    // 1. Initializare Firebase
    const firebaseConfig = { databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" };
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    // 2. Citire ID din codul QR (din URL)
    const urlParams = new URLSearchParams(window.location.search);
    const qrId = urlParams.get('id');

    if(!qrId) {
        document.getElementById('loader').innerText = "❌ Eroare: Cod QR Invalid. Lipseste ID-ul.";
    } else {
        // 3. Extragere date utilaj
        database.ref('utilaje/' + qrId).once('value').then((snapshot) => {
            const u = snapshot.val();
            if(!u) {
                document.getElementById('loader').innerText = "❌ Utilajul nu a fost găsit în baza de date.";
                return;
            }

            document.getElementById('loader').style.display = "none";
            document.getElementById('content').style.display = "block";

            // Populare date
            document.getElementById('uNume').innerText = u.nume;
            document.getElementById('uDetalii').innerText = `${u.model || '-'} | Secția: ${u.sectie} | ID: ${u.id}`;
            document.getElementById('btnEditare').href = `edit.html?id=${u.id}`; // Trimite ID-ul către editare

            const containerIstoric = document.getElementById('uIstoric');
            let ultimaData = null;

            if(u.istoric) {
                // Sortare istoric: cel mai nou sus
                const istoricArray = Object.values(u.istoric).sort((a, b) => new Date(b.data) - new Date(a.data));
                ultimaData = istoricArray[0].data;

                istoricArray.forEach((i, index) => {
                    let clasa = "istoric-box";
                    if(i.tip && i.tip.includes("Corectivă")) clasa += " critic"; // Marcam cu rosu defectiunile

                    containerIstoric.innerHTML += `
                        <div class="${clasa}">
                            <div class="data-interventie">📅 ${i.data} (${i.tip || 'Preventivă'})</div>
                            <div class="detalii-interventie"><b>👷 Mecanic:</b> ${i.mecanic || '-'}</div>
                            <div class="detalii-interventie"><b>🔧 Bife/Operațiuni:</b> ${i.verificari || '-'}</div>
                            <div class="detalii-interventie"><b>📝 Obs:</b> ${i.obs || '-'}</div>
                        </div>
                    `;
                });
            } else {
                containerIstoric.innerHTML = "<i>Acest utilaj nu are nicio intervenție înregistrată încă.</i>";
            }

            // Calculare status mentenanta
            const statusDiv = document.getElementById('uStatus');
            if(ultimaData) {
                const zile = Math.floor((new Date() - new Date(ultimaData)) / (1000 * 3600 * 24));
                if(zile > 90) {
                    statusDiv.className = "status-alert status-bad";
                    statusDiv.innerText = `⚠️ ATENȚIE: Au trecut ${zile} zile de la ultima revizie! Mentenanță CRITICĂ necesară.`;
                } else {
                    statusDiv.className = "status-alert status-ok";
                    statusDiv.innerText = `✅ UTILAJ ÎN GRAFIC (Ultima revizie acum ${zile} zile)`;
                }
            } else {
                statusDiv.className = "status-alert status-bad";
                statusDiv.innerText = `⚠️ UTILAJ NOU - NECESITĂ INSPECȚIE INIȚIALĂ`;
            }
        });
    }
