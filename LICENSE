<script>
    const firebaseConfig = { databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" };
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    var map = L.map('map', { crs: L.CRS.Simple, minZoom: 0, maxZoom: 3 });
    L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map);
    map.setView([500, 700], 0.5);

    let dbRaw = {}; 
    let markersList = [];

    // Ascultăm baza de date
    database.ref('utilaje').on('value', (snapshot) => {
        dbRaw = snapshot.val() || {};
        afiseazaPuncte();
    });

    // Funcție pentru a calcula zilele trecute de la o dată
    function calculeazaZileTrecute(dataString) {
        if (!dataString || dataString === "-") return 0;
        const dataInterventie = new Date(dataString);
        const dataCurenta = new Date();
        const diferentaTimp = dataCurenta.getTime() - dataInterventie.getTime();
        return Math.floor(diferentaTimp / (1000 * 3600 * 24));
    }

    function afiseazaPuncte() {
        const filtruSectie = document.getElementById('filterSectie').value;
        
        // Curățăm harta
        markersList.forEach(m => map.removeLayer(m));
        markersList = [];

        Object.keys(dbRaw).forEach(key => {
            const utilaj = dbRaw[key];
            if(filtruSectie !== "Toate" && utilaj.sectie !== filtruSectie) return;
            if(!utilaj.lat || !utilaj.lng) return;

            // Extragem istoricul și îl ordonăm (cele mai noi primele)
            let istoricHTML = "";
            let ultimaData = "-";

            if (utilaj.istoric) {
                // Transformăm obiectul istoric într-un array și îl sortăm descrescător după timestamp (sau dată)
                const istoricArray = Object.values(utilaj.istoric).sort((a, b) => new Date(b.data) - new Date(a.data));
                ultimaData = istoricArray[0].data;

                // Construim rândurile tabelului pentru popup (maxim 3 pentru a nu aglomera)
                const afisari = istoricArray.slice(0, 3);
                afisari.forEach(int => {
                    istoricHTML += `
                        <tr>
                            <td><b>${int.data}</b></td>
                            <td>${int.verificari ? int.verificari.substring(0, 30) + '...' : '-'}</td>
                            <td>${int.obs ? int.obs.substring(0, 20) + '...' : '-'}</td>
                        </tr>
                    `;
                });
            } else {
                istoricHTML = "<tr><td colspan='3' style='text-align:center;'>Nu există istoric</td></tr>";
            }

            // Construim Popup-ul complex
            const popupContent = `
                <div class="popup-header">
                    <h3>${utilaj.nume}</h3>
                    <p>${utilaj.model || 'Fără model'} | ID: ${utilaj.id}</p>
                </div>
                <div class="popup-body">
                    <p style="font-size:11px; margin-top:0;"><b>Secție:</b> ${utilaj.sectie}</p>
                    <table class="history-table">
                        <thead>
                            <tr><th>Data</th><th>Operațiuni</th><th>Obs.</th></tr>
                        </thead>
                        <tbody>
                            ${istoricHTML}
                        </tbody>
                    </table>
                </div>
                <button class="btn-export-mini" onclick="exportaFisa('${key}')">📥 Descarcă Fișa (Excel)</button>
            `;

            const marker = L.marker([utilaj.lat, utilaj.lng], {
                icon: L.icon({ 
                    iconUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon.png',
                    className: 'existing-pin',
                    iconSize: [25, 41], iconAnchor: [12, 41]
                })
            }).addTo(map).bindPopup(popupContent);
            
            marker.uData = { id: String(utilaj.id).toUpperCase(), nume: utilaj.nume.toUpperCase() };
            markersList.push(marker);
        });
    }

    function deschideRapoarte() {
        const corpTabelGeneral = document.getElementById('corptabel');
        const corpScadente = document.getElementById('corpScadente');
        
        corpTabelGeneral.innerHTML = "";
        corpScadente.innerHTML = "";
        
        // Logica pentru Planul de Mentenanță (Alerte)
        Object.keys(dbRaw).forEach(key => {
            const u = dbRaw[key];
            let ultimaData = "-";
            let zileTrecute = 0;

            if (u.istoric) {
                const istoricArray = Object.values(u.istoric).sort((a, b) => new Date(b.data) - new Date(a.data));
                ultimaData = istoricArray[0].data;
                zileTrecute = calculeazaZileTrecute(ultimaData);
            }

            // 1. POPULARE TABEL EVIDENȚĂ GLOBALĂ
            corpTabelGeneral.innerHTML += `
                <tr>
                    <td>${u.id}</td>
                    <td><b>${u.nume}</b><br><span style="font-size:10px;color:gray;">${u.sectie}</span></td>
                    <td>${ultimaData}</td>
                </tr>
            `;

            // 2. LOGICĂ PLAN MENTENANȚĂ (Când trebuie intervenit?)
            // Exemplu de reguli:
            let actiune = "";
            let status = "";

            if (zileTrecute > 180) { // Mai vechi de 6 luni
                actiune = "Schimb Ulei / Revizie Majoră";
                status = `<span class="status-pill bg-crit">CRITIC</span>`;
            } else if (zileTrecute > 30) { // Mai vechi de 1 lună
                actiune = "Inspecție Lunară (Sonde, Filtre)";
                status = `<span class="status-pill bg-warn">DE VERIFICAT</span>`;
            } else {
                status = `<span class="status-pill bg-ok">ÎN GRAFIC</span>`;
            }

            // Afișăm în tabelul de Scadențe doar dacă au trecut mai mult de 30 de zile
            if (zileTrecute > 30 || ultimaData === "-") {
                corpScadente.innerHTML += `
                    <tr>
                        <td><b>${u.nume}</b><br><span style="font-size:10px;color:gray;">${u.sectie}</span></td>
                        <td>${ultimaData === "-" ? "Niciodată" : zileTrecute + " zile"}</td>
                        <td>${ultimaData === "-" ? "Necesită revizie inițială" : actiune}</td>
                        <td>${status}</td>
                    </tr>
                `;
            }
        });

        if(corpScadente.innerHTML === "") {
            corpScadente.innerHTML = "<tr><td colspan='4' style='text-align:center; padding:20px;'>Nicio urgență momentan. Toate utilajele sunt în grafic! 🎉</td></tr>";
        }

        document.getElementById('reportModal').style.display = "flex";
    }

    function exportaFisa(key) {
        const u = dbRaw[key];
        let csv = "\uFEFFDATA;UTILAJ;ID;SECTIE;VERIFICARI;OBSERVATII\n";
        
        if (u.istoric) {
            Object.values(u.istoric).forEach(i => {
                csv += `${i.data};${u.nume};${u.id};${u.sectie};${i.verificari || ""};${(i.obs || "").replace(/;/g, ",")}\n`;
            });
        }
        
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = `Istoric_${u.nume.replace(/\s+/g, '_')}_${u.id}.csv`;
        a.click();
    }

    function exportaTotExcel() {
        let csv = "\uFEFFDATA;ID;UTILAJ;SECTIE;MODEL;VERIFICARI;OBSERVATII\n";
        Object.values(dbRaw).forEach(u => {
            if(u.istoric) {
                Object.values(u.istoric).forEach(i => {
                    csv += `${i.data};${u.id};${u.nume};${u.sectie};${u.model || ""};${i.verificari || ""};${(i.obs || "").replace(/;/g, ",")}\n`;
                });
            }
        });
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const a = document.createElement("a");
        a.href = URL.createObjectURL(blob);
        a.download = "Baza_Date_Mentenanta_Killer.csv";
        a.click();
    }

    function cauta() {
        const val = document.getElementById('searchInput').value.toUpperCase().trim();
        const gasit = markersList.find(m => m.uData.id.includes(val) || m.uData.nume.includes(val));
        if(gasit) { 
            map.setView(gasit.getLatLng(), 2); 
            gasit.openPopup(); 
        } else {
            alert("Utilajul nu a fost găsit pe hartă!");
        }
    }

    window.onload = () => { setTimeout(() => map.invalidateSize(), 600); };
</script>
</body>
</html>
Cum funcționează acum sistemul:
Evidența pe pin (Tabel Istoric): Când dai click pe orice utilaj pe hartă, fereastra mică care se deschide conține un tabel curat. Îți arată data, ce ai bifat (ex: schimb ulei, sonde) și observațiile pe care le-ai scris. Nu mai trebuie să exporți Excel-ul ca să vezi ce i-ai făcut ultima oară.

"Ce urmează de făcut?": Când apeși pe butonul portocaliu "⚠️ PLAN MENTENANȚĂ & RAPOARTE", modalul care se deschide este împărțit în două:

În stânga: O listă "roșie/portocalie" cu utilajele care au depășit o anumită perioadă (am pus ca exemplu 30 de zile pentru inspecție vizuală și peste 180 de zile / 6 luni pentru schimb de ulei major). Aplicația calculează singură zilele!

În dreapta: Evidența tuturor utilajelor de unde poți printa sau scoate Excel-ul global.

Dacă vei găsi fișierul cu "Planul de mentenanță" exact, vom putea schimba acele cifre din cod (30 de zile, 180 de zile) exact cu perioadele recomandate de producător pentru fiecare utilaj în parte!

se numeste PLANIFICARE MENTENANTA UTILAJE 2026. am urcat in Drive acum

Am reușit să găsesc și să citesc documentul „PLANIFICARE MENTENANTA UTILAJE 2026”. Este foarte detaliat și exact ce aveam nevoie!  

Din documentul tău am extras principalele reguli de periodicitate, pe care le putem traduce în „zile de alertă” în sistemul nostru:  


Săptămânal (7 zile): Ungere rulmenți, verificare nivel ulei (ex: Tumbler, Cuter).  


Lunar (30 zile): Curățare filtre, ungere lanțuri.  


Trimestrial (90 zile): Schimbare ulei pompă vid, verificare curele.  


Semestrial (180 zile): Verificare garnituri, curățare condensator, verificare sistem hidraulic.  


Anual (365 zile): Schimbare ulei transmisie, înlocuire rulmenți/curele, calibrare sonde.  

Pentru a implementa exact ceea ce îți dorești, am actualizat pagina view.html. Aceasta va acționa acum ca un adevărat Dispecerat de Mentenanță.

Cum funcționează noua implementare:
Popup la click pe hartă (Fișa Utilajului): Când dai click pe un utilaj, îți apare istoricul ultimelor 3 intervenții sub formă de tabel curat.

Lista „Ce urmează” (Alerte inteligente): Când deschizi Rapoartele, aplicația citește data ultimei intervenții pentru fiecare utilaj și o compară cu cele 5 reguli de mai sus. Dacă a depășit 7 zile, te avertizează că trebuie verificat nivelul de ulei; dacă a depășit 365 de zile, te alertează pentru revizia majoră anuală.

