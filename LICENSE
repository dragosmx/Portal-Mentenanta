<script>
    const firebaseConfig = { databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" };
    firebase.initializeApp(firebaseConfig); const database = firebase.database();
    var map = L.map('map', { crs: L.CRS.Simple, minZoom: 0, maxZoom: 3 }); L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map); map.setView([500, 700], 0.5);
    let dbRaw = {}, markersList = [], chartInstance = null;

    database.ref('utilaje').on('value', (snap) => { dbRaw = snap.val() || {}; afiseazaPuncte(); });

    function calculZile(dataStr) { if(!dataStr || dataStr === "-") return 999; return Math.floor((new Date() - new Date(dataStr)) / (1000 * 3600 * 24)); }

    function getColoredIcon(color) {
        const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 36" width="28" height="42"><path fill="${color}" stroke="#000" stroke-width="1.5" d="M12 0C5.373 0 0 5.373 0 12c0 7.333 12 24 12 24s12-16.667 12-24C24 5.373 18.627 0 12 0zm0 17.5c-3.038 0-5.5-2.462-5.5-5.5S8.962 6.5 12 6.5s5.5 2.462 5.5 5.5-2.462 5.5-5.5 5.5z"/></svg>`;
        return L.divIcon({ className: "custom-pin", html: svg, iconSize: [28, 42], iconAnchor: [14, 42], popupAnchor: [0, -40] });
    }

    function afiseazaPuncte() {
        const filtru = document.getElementById('filterSectie').value;
        markersList.forEach(m => map.removeLayer(m)); markersList = [];
        Object.keys(dbRaw).forEach(id => {
            const u = dbRaw[id]; if(filtru !== "Toate" && u.sectie !== filtru) return; if(!u.lat || !u.lng) return;
            let uD = "-"; if(u.istoric) uD = Object.values(u.istoric).sort((a,b)=>new Date(b.data)-new Date(a.data))[0].data;
            const zile = calculZile(uD);
            let col = "#e74c3c"; if(zile < 30) col = "#27ae60"; else if(zile < 90) col = "#f39c12";
            const m = L.marker([u.lat, u.lng], { icon: getColoredIcon(col) }).addTo(map);
            m.bindPopup(`<div class="pop-h"><h3>${u.nume}</h3></div><div class="pop-b"><p>Ultima: ${uD}</p><button class="btn-h" onclick="deschideIstoric('${id}')">📜 VEZI ISTORIC</button></div>`);
            m.uData = { id: String(u.id).toUpperCase(), nume: u.nume.toUpperCase() }; markersList.push(m);
        });
    }

    function deschideIstoric(id) {
        const u = dbRaw[id]; document.getElementById('histNume').innerText = u.nume;
        const corp = document.getElementById('corpHistIndiv'); corp.innerHTML = "";
        if(u.istoric) {
            Object.values(u.istoric).sort((a,b)=>new Date(b.data)-new Date(a.data)).forEach(i => {
                corp.innerHTML += `<tr><td>${i.data}</td><td>${i.mecanic || '-'}</td><td>${i.verificari}</td><td>${i.cost || 0} RON</td></tr>`;
            });
        }
        document.getElementById('historyModal').style.display = "flex";
    }

    function deschideRapoarte() {
        let ok=0, warn=0, crit=0, costT=0; const corp = document.getElementById('corpScadente'); corp.innerHTML = "";
        Object.values(dbRaw).forEach(u => {
            let uD = "-"; if(u.istoric) { uD = Object.values(u.istoric).sort((a,b)=>new Date(b.data)-new Date(a.data))[0].data; Object.values(u.istoric).forEach(i => costT += (parseFloat(i.cost)||0)); }
            const zile = calculZile(uD); if(zile < 30) ok++; else if(zile < 90) warn++; else crit++;
            if(zile >= 30 || uD === "-") corp.innerHTML += `<tr><td>${u.nume}</td><td>${zile === 999 ? 'LIPSĂ' : zile}</td><td>${zile > 90 ? '🔴 CRITIC' : '🟡 URMEAZĂ'}</td></tr>`;
        });
        document.getElementById('totalCost').innerText = costT.toLocaleString() + " RON";
        if(chartInstance) chartInstance.destroy();
        chartInstance = new Chart(document.getElementById('statusChart'), { type: 'doughnut', data: { labels: ['OK','Atenție','Critic'], datasets: [{ data: [ok, warn, crit], backgroundColor: ['#27ae60','#f39c12','#e74c3c'] }] } });
        document.getElementById('reportModal').style.display = "flex";
    }

    function exportaExcelNativ() {
        let d = []; Object.values(dbRaw).forEach(u => { if(u.istoric) Object.values(u.istoric).forEach(i => d.push({ Data: i.data, Utilaj: u.nume, Mecanic: i.mecanic, Operațiuni: i.verificari, Cost: i.cost })); });
        const ws = XLSX.utils.json_to_sheet(d); const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, ws, "Mentenanta"); XLSX.writeFile(wb, "Raport_Killer.xlsx");
    }

    function printeazaQR() {
        let base = window.location.href.substring(0, window.location.href.lastIndexOf("/") + 1);
        let win = window.open('', '_blank');
        let h = '<html><head><style>.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;padding:20px;}.card{border:1px dashed #000;padding:10px;text-align:center;}img{width:120px;}</style></head><body><div class="grid">';
        Object.values(dbRaw).forEach(u => {
            let link = base + 'scan.html?id=' + u.id;
            let qr = `https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent(link)}`;
            h += `<div class="card"><img src="${qr}"><h3>${u.nume}</h3><p>ID: ${u.id}</p></div>`;
        });
        h += '</div><button onclick="window.print()">PRINT</button></body></html>';
        win.document.write(h); win.document.close();
    }
    
    function cauta() {
        const val = document.getElementById('searchInput').value.toUpperCase().trim();
        const gasit = markersList.find(m => m.uData.id.includes(val) || m.uData.nume.includes(val));
        if(gasit) { map.setView(gasit.getLatLng(), 1.5); gasit.openPopup(); }
    }
</script>
</body>
</html>
