<script>
    const firebaseConfig = { databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" };
    firebase.initializeApp(firebaseConfig); const database = firebase.database();

    var map = L.map('map', { crs: L.CRS.Simple, minZoom: 0, maxZoom: 3, zoomControl: false });
    L.control.zoom({ position: 'bottomright' }).addTo(map);
    L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map); map.setView([500, 700], 0.5);

    let dbRaw = {}, markersList = [], chartInstance = null;

    database.ref('utilaje').on('value', (snap) => { dbRaw = snap.val() || {}; afiseazaPuncte(); });

    function calculZile(dataStr) { if(!dataStr || dataStr === "-") return 999; return Math.floor((new Date() - new Date(dataStr)) / (1000 * 3600 * 24)); }

    function getColoredIcon(color) {
        const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 36" width="28" height="42"><path fill="${color}" stroke="#000" stroke-width="1.5" d="M12 0C5.373 0 0 5.373 0 12c0 7.333 12 24 12 24s12-16.667 12-24C24 5.373 18.627 0 12 0zm0 17.5c-3.038 0-5.5-2.462-5.5-5.5S8.962 6.5 12 6.5s5.5 2.462 5.5 5.5-2.462 5.5-5.5 5.5z"/></svg>`;
        return L.divIcon({ className: "custom-pin", html: svg, iconSize: [28, 42], iconAnchor: [14, 42], popupAnchor: [0, -40] });
    }

    function afiseazaPuncte() {
        const filtru = document.getElementById('filterSectie').value;
        markersList.forEach(m => map.removeLayer(m)); markersList = [];
        let bounds = [];

        Object.keys(dbRaw).forEach(id => {
            const u = dbRaw[id]; if(filtru !== "Toate" && u.sectie !== filtru) return; if(!u.lat || !u.lng) return;
            let uD = "-"; let popTabel = "";
            if(u.istoric) {
                const ist = Object.values(u.istoric).sort((a,b)=>new Date(b.data)-new Date(a.data));
                uD = ist[0].data;
                ist.slice(0, 2).forEach(i => {
                    popTabel += `<tr><td><b>${i.data}</b></td><td>${i.verificari}</td></tr>`;
                });
            }
            const zile = calculZile(uD);
            let col = zile < 30 ? "#27ae60" : (zile < 90 ? "#f39c12" : "#e74c3c");
            const m = L.marker([u.lat, u.lng], { icon: getColoredIcon(col) }).addTo(map);
            bounds.push([u.lat, u.lng]);
            m.bindPopup(`<div class="popup-header"><h3>${u.nume}</h3><p>ID: ${u.id}</p></div><div class="popup-body"><div class="last-info">Ultima: ${uD} (${zile} zile)</div><table style="font-size:10px; width:100%; border-collapse:collapse; margin-bottom:10px;">${popTabel}</table><button class="btn-history" onclick="deschideIstoricIndividual('${id}')">📜 ISTORIC COMPLET</button></div>`);
            m.uData = { id: String(u.id).toUpperCase(), nume: u.nume.toUpperCase() }; markersList.push(m);
        });
        if(bounds.length > 0 && filtru !== "Toate") map.fitBounds(bounds, { padding: [50, 50], maxZoom: 1.5 });
    }

    function deschideIstoricIndividual(id) {
        const u = dbRaw[id]; document.getElementById('histNume').innerText = u.nume; document.getElementById('histModel').innerText = "Model: " + (u.model || "-");
        const corp = document.getElementById('corpIstoricIndividual'); corp.innerHTML = "";
        if(u.istoric) {
            Object.values(u.istoric).sort((a,b)=>new Date(b.data)-new Date(a.data)).forEach(i => {
                corp.innerHTML += `<tr><td>${i.data}</td><td>${i.tip || 'Plan'}</td><td>${i.mecanic || '-'}</td><td>${i.verificari}</td><td>${i.obs || '-'}</td></tr>`;
            });
        }
        document.getElementById('btnExportIndividual').onclick = () => exportaExcelIndividual(id);
        document.getElementById('historyModal').style.display = "flex";
    }

    function deschideRapoarte() {
        let ok=0, warn=0, crit=0, totalCount=0; const corpS = document.getElementById('corpScadente'); const corpF = document.getElementById('corpFluxLive');
        corpS.innerHTML = ""; corpF.innerHTML = ""; let fluxData = [];

        Object.values(dbRaw).forEach(u => {
            let uD = "-"; if(u.istoric) {
                const ist = Object.values(u.istoric).sort((a,b)=>new Date(b.data)-new Date(a.data));
                uD = ist[0].data; totalCount += ist.length;
                Object.values(u.istoric).forEach(i => fluxData.push({ data: i.data, nume: u.nume, mecanic: i.mecanic, activitate: i.verificari }));
            }
            const zile = calculZile(uD); if(zile < 30) ok++; else if(zile < 90) warn++; else crit++;
            if(zile >= 30 || uD === "-") corpS.innerHTML += `<tr><td><b>${u.nume}</b><br><small>${u.sectie}</small></td><td>${zile === 999 ? 'LIPSĂ' : zile}</td><td><span class="status-pill ${zile > 90 ? 'bg-crit' : 'bg-warn'}">${zile > 90 ? 'CRITIC' : 'URMEAZĂ'}</span></td></tr>`;
        });

        fluxData.sort((a,b)=>new Date(b.data)-new Date(a.data)).slice(0, 15).forEach(f => {
            corpF.innerHTML += `<tr><td>${f.data}</td><td><b>${f.nume}</b></td><td>${f.mecanic || '-'}</td><td>${f.activitate}</td></tr>`;
        });

        document.getElementById('totalInterventii').innerText = totalCount;
        if(chartInstance) chartInstance.destroy();
        chartInstance = new Chart(document.getElementById('statusChart'), { type: 'doughnut', data: { labels: ['OK','Atenție','Critic'], datasets: [{ data: [ok, warn, crit], backgroundColor: ['#27ae60','#f39c12','#e74c3c'], borderWidth: 0 }] }, options: { plugins: { legend: { position: 'bottom' } } } });
        document.getElementById('reportModal').style.display = "flex";
    }

    function exportaExcelNativ() {
        let d = []; Object.values(dbRaw).forEach(u => { if(u.istoric) Object.values(u.istoric).forEach(i => d.push({ Data: i.data, Utilaj: u.nume, Sectie: u.sectie, Mecanic: i.mecanic, Activitate: i.verificari })); });
        const ws = XLSX.utils.json_to_sheet(d); const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, ws, "Mentenanta"); XLSX.writeFile(wb, "Raport_Killer_2026.xlsx");
    }

    function exportaExcelIndividual(id) {
        const u = dbRaw[id]; let d = []; if(u.istoric) Object.values(u.istoric).forEach(i => d.push({ Data: i.data, Mecanic: i.mecanic, Activitate: i.verificari, Note: i.obs }));
        const ws = XLSX.utils.json_to_sheet(d); const wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, ws, "Fisa_Service"); XLSX.writeFile(wb, `Fisa_${u.nume}.xlsx`);
    }

    function exportaPDF() {
        const area = document.getElementById('pdfArea');
        const opt = { margin: 10, filename: 'Raport_Killer_Mentenanta.pdf', image: { type: 'jpeg', quality: 0.98 }, html2canvas: { scale: 2 }, jsPDF: { unit: 'mm', format: 'a4', orientation: 'landscape' } };
        html2pdf().set(opt).from(area).save();
    }

    function printeazaQR() {
        let base = window.location.href.substring(0, window.location.href.lastIndexOf("/") + 1);
        let win = window.open('', '_blank');
        let h = `<html><head><title>Etichete QR</title><style>@page{margin:10mm;size:A4;}body{font-family:sans-serif;text-align:center;}.grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;}.card{border:1px dashed #666;padding:8px;text-align:center;}img{max-width:90px;}h3{font-size:11px;margin:5px 0 0;}p{font-size:9px;margin:3px 0;font-weight:bold;}.no-print{padding:15px;background:#27ae60;color:white;border:none;border-radius:10px;font-weight:bold;cursor:pointer;margin-bottom:20px;}</style></head><body><button class="no-print" onclick="window.print()">🖨️ PRINTARE (A4)</button><div class="grid">`;
        Object.values(dbRaw).forEach(u => {
            let qr = `https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=${encodeURIComponent(base+'scan.html?id='+u.id)}`;
            h += `<div class="card"><img src="${qr}"><h3>${u.nume}</h3><p>ID: ${u.id}</p></div>`;
        });
        h += '</div></body></html>'; win.document.write(h); win.document.close();
    }

    function inchideModal(id) { document.getElementById(id).style.display = "none"; }
    function cauta() {
        const val = document.getElementById('searchInput').value.toUpperCase();
        const m = markersList.find(x => x.uData.id.includes(val) || x.uData.nume.includes(val));
        if(m) { map.setView(m.getLatLng(), 1.5); m.openPopup(); }
    }
    window.onload = () => setTimeout(() => map.invalidateSize(), 600);
</script>
</body>
</html>
nu e codul complet

Îmi cer scuze pentru aceste întreruperi repetate. Se pare că volumul mare de cod depășește limita de caractere a unui singur mesaj, iar sistemul îl taie automat la final.

Pentru a rezolva definitiv problema, am optimizat structura codului (eliminând spațiile inutile și condensând anumite părți repetitive) fără a scoate nicio funcție. Astfel, totul va încăpea într-un singur bloc de cod complet.

Iată fișierul view.html integral, de la prima la ultima linie, cu toate funcțiile incluse (Zoom, PDF, Scroll Flux Live, Fără Costuri și Semnătura ta):

