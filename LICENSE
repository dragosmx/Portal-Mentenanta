<script>
    // 1. Configurare Firebase
    const firebaseConfig = { 
        databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" 
    };
    
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    // 2. Configurare Hartă Leaflet
    var map = L.map('map', { 
        crs: L.CRS.Simple, 
        minZoom: 0, 
        maxZoom: 3 
    });
    
    L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map);
    map.setView([500, 700], 1); 

    // 3. Variabile Globale
    let dbRaw = {};
    let markersGroup = L.layerGroup().addTo(map);
    let activeMarker = null;
    let selectedId = null;
    let currentCoords = null;
    
    // Setăm data de astăzi automat în câmpul Dată
    document.getElementById('data').valueAsDate = new Date();

    // 4. Ascultăm baza de date pentru actualizări în timp real
    database.ref('utilaje').on('value', (snap) => { 
        dbRaw = snap.val() || {}; 
        refreshPini(); 
    });

    // 5. Funcția pentru afișarea pinilor pe hartă (în modul edit)
    function refreshPini() {
        markersGroup.clearLayers();
        
        Object.keys(dbRaw).forEach(id => {
            const u = dbRaw[id];
            
            if (u.lat && u.lng) {
                const customIcon = L.icon({ 
                    iconUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon.png', 
                    className: 'existing-pin', 
                    iconSize: [25, 41], 
                    iconAnchor: [12, 41] 
                });
                
                const m = L.marker([u.lat, u.lng], { icon: customIcon }).addTo(markersGroup);
                
                m.on('click', (e) => { 
                    L.DomEvent.stopPropagation(e); 
                    incarcaUtilaj(id); 
                });
            }
        });
    }

    // 6. Funcția de click pe hartă pentru a adăuga un pin nou
    map.on('click', (e) => {
        // Dacă edităm deja un utilaj existent, nu putem adăuga unul nou din greșeală
        if (selectedId) {
            return; 
        }
        
        currentCoords = [e.latlng.lat.toFixed(0), e.latlng.lng.toFixed(0)];
        
        // Ștergem pinul provizoriu dacă exista deja unul pus
        if (activeMarker) {
            map.removeLayer(activeMarker);
        }
        
        activeMarker = L.marker(e.latlng).addTo(map); 
        
        checkReady();
    });

    // 7. Funcția de încărcare a datelor când dăm click pe un utilaj existent
    function incarcaUtilaj(id) {
        selectedId = id; 
        const u = dbRaw[id];
        
        document.getElementById('nume').value = u.nume; 
        document.getElementById('model').value = u.model || ""; 
        document.getElementById('sectie').value = u.sectie;
        
        document.getElementById('status').innerHTML = `MOD: EDITARE UTILAJ (ID: ${id})`; 
        document.getElementById('status').className = "status-badge status-edit";
        
        // Creăm butonul de ștergere definitivă
        const deleteBtnHtml = `<button class="btn-del" onclick="stergeUtilaj('${id}')">⚠️ ȘTERGE UTILAJ DEFINITIV</button>`;
        document.getElementById('deleteZone').innerHTML = deleteBtnHtml;
        
        if (activeMarker) {
            map.removeLayer(activeMarker);
        }
        
        toggleExtra(); 
        checkReady();
    }

    // 8. BIFE DINAMICE CONFORM PLANULUI 2026 (EXTRAS DIN DOCUMENTUL URCAT DE TINE)
    function toggleExtra() {
        const s = document.getElementById('sectie').value;
        const extraFieldsDiv = document.getElementById('extraFields');
        
        let html = '<label>Operațiuni Plan Mentenanță 2026:</label><div class="checklist">';

        if (s === 'Tocare' || s === 'Injectare') {
            html += `
                <label class="check-item"><input type="checkbox" class="task" value="Filtru admisie aer"> Filtru admisie aer</label>
                <label class="check-item"><input type="checkbox" class="task" value="Sistem hidraulic"> Sistem hidraulic</label>
                <label class="check-item"><input type="checkbox" class="task" value="Motor principal"> Motor principal</label>
                <label class="check-item"><input type="checkbox" class="task" value="Transmisie cuva"> Transmisie cuvă (Schimb ulei Shell Tellus)</label>
                <label class="check-item"><input type="checkbox" class="task" value="Descarcator pasta"> Descărcător pastă</label>
                <label class="check-item"><input type="checkbox" class="task" value="Curele transmisie"> Reîntindere/Schimb Curele</label>
            `;
        } else if (s === 'Tranșare') {
            html += `
                <label class="check-item"><input type="checkbox" class="task" value="Benzi transport"> Verificare benzi transport</label>
                <label class="check-item"><input type="checkbox" class="task" value="Tablou electric"> Tablou electric (contacte)</label>
                <label class="check-item"><input type="checkbox" class="task" value="Sistem taiere"> Sistem tăiere (Ascuțire/Gresare)</label>
            `;
        } else if (s === 'Ambalare Vid') {
            html += `
                <label class="check-item"><input type="checkbox" class="task" value="Ulei Pompa Vid"> Ulei Pompă Vid</label>
                <label class="check-item"><input type="checkbox" class="task" value="Rezistente Lipire"> Rezistențe Lipire</label>
                <label class="check-item"><input type="checkbox" class="task" value="Banda Teflon"> Bandă Teflon</label>
            `;
        } else {
            html += `
                <label class="check-item"><input type="checkbox" class="task" value="Inspectie Vizuala"> Inspecție Vizuală</label>
                <label class="check-item"><input type="checkbox" class="task" value="Verificare Tablou"> Tablou Electric</label>
            `;
        }
        
        html += `</div>`;
        html += `<div class="group" style="margin-top:10px;">`;
        html += `<label>Altă operațiune (Scrieți manual):</label>`;
        html += `<input type="text" id="extraCheck">`;
        html += `</div>`;
        
        extraFieldsDiv.innerHTML = html;
    }

    // 9. Verificare validitate formular înainte de salvare
    function checkReady() {
        const numeValid = document.getElementById('nume').value.trim().length > 2;
        const areLocatie = (selectedId !== null) || (currentCoords !== null);
        
        const saveBtn = document.getElementById('saveBtn');
        
        if (areLocatie && numeValid) {
            saveBtn.disabled = false;
        } else {
            saveBtn.disabled = true;
        }
    }

    // 10. Ștergerea unui utilaj
    async function stergeUtilaj(id) { 
        const confirmare = confirm("Ești sigur că vrei să ștergi acest utilaj și întregul său istoric?");
        if (confirmare) { 
            await database.ref('utilaje/' + id).remove(); 
            resetForm(); 
        } 
    }

    // 11. Funcția principală de salvare a datelor
    async function salveaza() {
        const btn = document.getElementById('saveBtn'); 
        const msg = document.getElementById('feedbackMsg');
        
        btn.disabled = true; 
        btn.innerText = "⏳ SE SALVEAZĂ...";

        try {
            // Colectăm ce a fost bifat
            const bifeList = document.querySelectorAll('.task:checked');
            const bifeArray = Array.from(bifeList);
            const bifeValues = bifeArray.map(c => c.value);
            const bifeString = bifeValues.join(", ");
            
            // Colectăm valoarea extra scrisă manual
            const extraCheckElement = document.getElementById('extraCheck');
            let manual = "";
            if (extraCheckElement) {
                manual = extraCheckElement.value;
            }
            
            // Creăm șirul final de verificări
            let verificariFinale = bifeString;
            if (manual !== "") {
                if (verificariFinale !== "") {
                    verificariFinale += " | " + manual;
                } else {
                    verificariFinale = manual;
                }
            }
            
            // Creăm obiectul pentru intervenție
            const entry = {
                data: document.getElementById('data').value,
                tip: document.getElementById('tipInterventie').value,
                mecanic: document.getElementById('mecanic').value,
                verificari: verificariFinale,
                obs: document.getElementById('obs').value,
                timestamp: Date.now()
            };

            if (selectedId) {
                // Dacă utilajul există, actualizăm și adăugăm în istoric
                const istoricRef = database.ref('utilaje/' + selectedId + '/istoric').push();
                await istoricRef.set(entry);
                
                await database.ref('utilaje/' + selectedId + '/model').set(document.getElementById('model').value);
                await database.ref('utilaje/' + selectedId + '/sectie').set(document.getElementById('sectie').value);
            } else {
                // Dacă este un utilaj complet nou
                const idGenerat = Math.floor(1000 + Math.random() * 9000);
                const idNou = "K-" + idGenerat;
                
                const utilajNouObject = { 
                    id: idNou, 
                    nume: document.getElementById('nume').value, 
                    model: document.getElementById('model').value, 
                    sectie: document.getElementById('sectie').value, 
                    lat: parseFloat(currentCoords[0]), 
                    lng: parseFloat(currentCoords[1]), 
                    istoric: { 
                        "init": entry 
                    } 
                };
                
                await database.ref('utilaje/' + idNou).set(utilajNouObject);
            }

            // Confirmare de succes
            msg.innerText = "✅ SALVAT CU SUCCES!"; 
            msg.className = "msg-popup msg-success"; 
            msg.style.display = "block";
            
            setTimeout(() => { 
                resetForm(); 
                btn.innerText = "💾 SALVEAZĂ FIȘA"; 
                msg.style.display = "none"; 
            }, 2000);
            
        } catch(e) {
            // Confirmare eroare
            msg.innerText = "❌ EROARE: " + e.message; 
            msg.className = "msg-popup msg-error"; 
            msg.style.display = "block";
            
            btn.disabled = false; 
            btn.innerText = "💾 ÎNCEARCĂ DIN NOU";
        }
    }

    // 12. Resetare formular pentru acțiuni noi
    function resetForm() {
        selectedId = null; 
        currentCoords = null;
        
        document.getElementById('nume').value = ""; 
        document.getElementById('model').value = ""; 
        document.getElementById('obs').value = ""; 
        document.getElementById('mecanic').value = "";
        
        document.getElementById('status').innerHTML = "MOD: UTILAJ NOU"; 
        document.getElementById('status').className = "status-badge"; 
        document.getElementById('deleteZone').innerHTML = "";
        
        if (activeMarker) {
            map.removeLayer(activeMarker); 
        }
        
        toggleExtra(); 
        checkReady();
    }

    // Inițializare scripturi după ce se încarcă pagina
    toggleExtra(); 
    
    window.onload = () => { 
        setTimeout(() => {
            map.invalidateSize();
        }, 500); 
    };
</script>
</body>
</html>
ceva mai detaliat ce ai putea adauga? cum mai putem imbunatati ? iar la rapoarte si export cum putem sa imbunatatim? vreau totul sa fie mai mult decat perfect

Pentru a aduce aplicația la nivelul „mai mult decât perfect” (nivel Enterprise / Corporație), trebuie să trecem de la o simplă evidență la un instrument de Business Intelligence (Analiză și Decizie).

Iată 4 inovații majore pe care le-am gândit și pe care ți le-am integrat direct în codurile de mai jos:

1. Grafice Vizuale (Dashboard cu Chart.js)
În pagina de Vizualizare, nu vei mai avea doar tabele anoste. Am integrat o bibliotecă profesională de grafice. Când deschizi Rapoartele, vei vedea un Grafic Rotund (Doughnut Chart) care îți arată instant proporția utilajelor: Câte sunt OK, câte necesită atenție și câte sunt în stadiu CRITIC.

2. Export Nativ în Excel (.xlsx) în loc de (.csv)
Până acum exportam fișiere .csv (care uneori strică diacriticele sau pun textul în aceeași coloană dacă Excelul tău e setat în română). Am integrat biblioteca SheetJS. Acum, aplicația generează un fișier Excel real (.xlsx), cu coloane perfect așezate, suport pentru diacritice și gata de printat sau trimis la contabilitate/conducere.

3. Modul de Bugetare (Calcul Costuri)
Mentenanța înseamnă bani. Am adăugat în edit.html un câmp dedicat pentru Cost Intervenție (RON). Astfel, în rapoartele din view.html, sistemul va aduna automat aceste costuri și îți va spune Costul Total al Mentenanței (ex: 2.500 RON cheltuiți luna asta pe piese).

4. Jurnalizare Strictă
Acum, Excelul exportat va avea coloane separate și clare pentru: Dată, Utilaj, Secție, Tip Intervenție, Mecanic, Operațiuni Bifate, Observații și Cost.

Iată codurile aduse la rangul de perfecțiune. Înlocuiește-le pe amândouă complet.

