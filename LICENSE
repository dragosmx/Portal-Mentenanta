<script>
    // Inițializare Firebase
    const firebaseConfig = { 
        databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" 
    };
    firebase.initializeApp(firebaseConfig); 
    const database = firebase.database();

    // Inițializare Hartă
    var map = L.map('map', { 
        crs: L.CRS.Simple, 
        minZoom: 0, 
        maxZoom: 3 
    }); 
    
    L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map); 
    map.setView([500, 700], 0.5);
    
    let dbRaw = {};
    let markersList = [];
    let chartInstance = null;

    // Citire date
    database.ref('utilaje').on('value', (snap) => { 
        dbRaw = snap.val() || {}; 
        afiseazaPuncte(); 
    });

    // Funcție calcul zile
    function calculZile(dataStr) { 
        if (!dataStr || dataStr === "-") {
            return 999; 
        }
        const dataInterventie = new Date(dataStr);
        const dataCurenta = new Date();
        const diferenta = dataCurenta - dataInterventie;
        return Math.floor(diferenta / (1000 * 3600 * 24)); 
    }

    // Pini SVG Colorați
    function getColoredIcon(color) {
        const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 36" width="28" height="42">
            <path fill="${color}" stroke="#000" stroke-width="1.5" d="M12 0C5.373 0 0 5.373 0 12c0 7.333 12 24 12 24s12-16.667 12-24C24 5.373 18.627 0 12 0zm0 17.5c-3.038 0-5.5-2.462-5.5-5.5S8.962 6.5 12 6.5s5.5 2.462 5.5 5.5-2.462 5.5-5.5 5.5z"/>
        </svg>`;
        return L.divIcon({ 
            className: "custom-pin", 
            html: svg, 
            iconSize: [28, 42], 
            iconAnchor: [14, 42], 
            popupAnchor: [0, -40] 
        });
    }

    // Afișare puncte pe hartă
    function afiseazaPuncte() {
        const filtru = document.getElementById('filterSectie').value;
        
        // Curățăm harta
        markersList.forEach(m => map.removeLayer(m)); 
        markersList = [];
        
        Object.keys(dbRaw).forEach(id => {
            const u = dbRaw[id]; 
            
            if (filtru !== "Toate" && u.sectie !== filtru) return; 
            if (!u.lat || !u.lng) return;
            
            let ultimaData = "-"; 
            if (u.istoric) {
                const istoricSortat = Object.values(u.istoric).sort((a, b) => new Date(b.data) - new Date(a.data));
                ultimaData = istoricSortat[0].data;
            }
            
            const zile = calculZile(ultimaData);
            
            let culoare = "#e74c3c"; // Roșu
            if (zile < 30) {
                culoare = "#27ae60"; // Verde
            } else if (zile < 90) {
                culoare = "#f39c12"; // Galben
            }
            
            const marker = L.marker([u.lat, u.lng], { icon: getColoredIcon(culoare) }).addTo(map);
            
            const htmlPopup = `
                <div class="pop-h">
                    <h3 style="margin:0;">${u.nume}</h3>
                </div>
                <div class="pop-b">
                    <p>Ultima intervenție: <b>${ultimaData}</b></p>
                    <button class="btn-h" onclick="deschideIstoric('${id}')">📜 VEZI ISTORIC</button>
                </div>
            `;
            
            marker.bindPopup(htmlPopup);
            marker.uData = { id: String(u.id).toUpperCase(), nume: u.nume.toUpperCase() }; 
            markersList.push(marker);
        });
    }

    // Deschidere Istoric Individual
    function deschideIstoric(id) {
        const u = dbRaw[id]; 
        document.getElementById('histNume').innerText = u.nume + " - Istoric Service";
        const corp = document.getElementById('corpHistIndiv'); 
        corp.innerHTML = "";
        
        if (u.istoric) {
            const istoricSortat = Object.values(u.istoric).sort((a, b) => new Date(b.data) - new Date(a.data));
            
            istoricSortat.forEach(i => {
                corp.innerHTML += `
                    <tr>
                        <td style="padding:10px;"><b>${i.data}</b></td>
                        <td>${i.mecanic || '-'}</td>
                        <td>${i.verificari}</td>
                        <td><b>${i.cost || 0} RON</b></td>
                    </tr>
                `;
            });
        } else {
            corp.innerHTML = `<tr><td colspan="4" style="text-align:center; padding:20px;">Nu există istoric.</td></tr>`;
        }
        document.getElementById('historyModal').style.display = "flex";
    }

    // Deschidere Dashboard General
    function deschideRapoarte() {
        let utilajeOk = 0;
        let utilajeWarn = 0;
        let utilajeCrit = 0;
        let costTotal = 0; 
        
        const corp = document.getElementById('corpScadente'); 
        corp.innerHTML = "";
        
        Object.values(dbRaw).forEach(u => {
            let ultimaData = "-"; 
            
            if (u.istoric) { 
                const istoricSortat = Object.values(u.istoric).sort((a, b) => new Date(b.data) - new Date(a.data));
                ultimaData = istoricSortat[0].data; 
                
                Object.values(u.istoric).forEach(i => {
                    costTotal += (parseFloat(i.cost) || 0);
                }); 
            }
            
            const zile = calculZile(ultimaData); 
            
            if (zile < 30) {
                utilajeOk++; 
            } else if (zile < 90) {
                utilajeWarn++; 
            } else {
                utilajeCrit++;
            }
            
            if (zile >= 30 || ultimaData === "-") {
                let statusBadge = zile > 90 ? '🔴 CRITIC' : '🟡 URMEAZĂ';
                
                corp.innerHTML += `
                    <tr>
                        <td style="padding:10px; border-bottom:1px solid #eee;">
                            <b>${u.nume}</b><br><small>${u.sectie}</small>
                        </td>
                        <td style="border-bottom:1px solid #eee;">
                            ${zile === 999 ? 'LIPSĂ DATE' : zile + ' zile'}
                        </td>
                        <td style="border-bottom:1px solid #eee; font-weight:bold;">
                            ${statusBadge}
                        </td>
                    </tr>
                `;
            }
        });
        
        document.getElementById('totalCost').innerText = costTotal.toLocaleString() + " RON";
        
        if (chartInstance) {
            chartInstance.destroy();
        }
        
        chartInstance = new Chart(document.getElementById('statusChart'), { 
            type: 'doughnut', 
            data: { 
                labels: ['OK (<30 zile)', 'Atenție (30-90 zile)', 'Critic (>90 zile)'], 
                datasets: [{ 
                    data: [utilajeOk, utilajeWarn, utilajeCrit], 
                    backgroundColor: ['#27ae60', '#f39c12', '#e74c3c'] 
                }] 
            } 
        });
        
        document.getElementById('reportModal').style.display = "flex";
    }

    // Export Excel Nativ
    function exportaExcelNativ() {
        let dateExcel = []; 
        
        Object.values(dbRaw).forEach(u => { 
            if (u.istoric) {
                Object.values(u.istoric).forEach(i => { 
                    dateExcel.push({ 
                        "Data Intervenție": i.data, 
                        "Nume Utilaj": u.nume, 
                        "ID Utilaj": u.id,
                        "Secție": u.sectie,
                        "Mecanic": i.mecanic || "-", 
                        "Operațiuni Efectuate": i.verificari || "-", 
                        "Observații": i.obs || "-",
                        "Cost (RON)": i.cost || 0 
                    }); 
                });
            }
        });
        
        if (dateExcel.length === 0) {
            alert("Nu există date de exportat!");
            return;
        }

        const ws = XLSX.utils.json_to_sheet(dateExcel); 
        const wb = XLSX.utils.book_new(); 
        XLSX.utils.book_append_sheet(wb, ws, "Mentenanta Baza Date"); 
        XLSX.writeFile(wb, "Raport_Mentenanta_Killer.xlsx");
    }

    // Printare Etichete QR
    function printeazaQR() {
        let basePath = window.location.href.substring(0, window.location.href.lastIndexOf("/") + 1);
        let printWindow = window.open('', '_blank');
        
        let htmlPrint = `
            <html>
            <head>
                <title>Etichete QR</title>
                <style>
                    body { font-family: sans-serif; text-align: center; }
                    .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; padding: 20px; }
                    .card { border: 2px dashed #000; padding: 15px; border-radius: 10px; text-align: center; }
                    img { max-width: 150px; margin-bottom: 10px; }
                    h3 { margin: 0; font-size: 14px; text-transform: uppercase; }
                    p { margin: 5px 0 0; font-size: 12px; font-weight:bold; }
                    @media print { .no-print { display: none; } }
                </style>
            </head>
            <body>
                <button class="no-print" onclick="window.print()" style="padding:15px; background:#27ae60; color:white; font-size:16px; font-weight:bold; cursor:pointer; border:none; border-radius:10px; margin-bottom:20px;">🖨️ PRINȚEAZĂ PAGINA</button>
                <div class="grid">
        `;
        
        Object.values(dbRaw).forEach(u => {
            let linkDeScanat = basePath + 'scan.html?id=' + u.id;
            let qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=${encodeURIComponent(linkDeScanat)}`;
            
            htmlPrint += `
                <div class="card">
                    <img src="${qrUrl}" alt="QR Code">
                    <h3>${u.nume}</h3>
                    <p>Secția: ${u.sectie}</p>
                    <p>ID: ${u.id}</p>
                </div>
            `;
        });
        
        htmlPrint += `</div></body></html>`;
        
        printWindow.document.write(htmlPrint); 
        printWindow.document.close();
    }
    
    // Căutare Utilaj
    function cauta() {
        const val = document.getElementById('searchInput').value.toUpperCase().trim();
        const gasit = markersList.find(m => m.uData.id.includes(val) || m.uData.nume.includes(val));
        
        if (gasit) { 
            map.setView(gasit.getLatLng(), 2); 
            gasit.openPopup(); 
        } else {
            alert("Utilajul nu a fost găsit pe hartă!");
        }
    }

    // Rezolvare problemă încărcare hartă gri
    window.onload = () => { 
        setTimeout(() => map.invalidateSize(), 600); 
    };
</script>
</body>
</html>
