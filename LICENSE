<script>
    const firebaseConfig = { databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" };
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    var map = L.map('map', { crs: L.CRS.Simple, minZoom: 0, maxZoom: 3 });
    L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map);
    map.setView([500, 700], 0.5);

    let dbRaw = {}; 
    let markersList = [];

    database.ref('utilaje').on('value', (snapshot) => {
        dbRaw = snapshot.val() || {};
        afiseazaPuncte();
    });

    // Funcție calcul zile
    function calculZile(dataString) {
        if (!dataString || dataString === "-") return 999; // Daca nu are istoric, e urgent.
        const dataInregistrare = new Date(dataString);
        const azi = new Date();
        return Math.floor((azi - dataInregistrare) / (1000 * 3600 * 24));
    }

    function afiseazaPuncte() {
        const filtru = document.getElementById('filterSectie').value;
        markersList.forEach(m => map.removeLayer(m));
        markersList = [];

        Object.keys(dbRaw).forEach(key => {
            const u = dbRaw[key];
            if(filtru !== "Toate" && u.sectie !== filtru) return;
            if(!u.lat || !u.lng) return;

            let istoricHTML = "";
            
            if (u.istoric) {
                // Ordonam istoricul cele mai noi sus
                const istArray = Object.values(u.istoric).sort((a, b) => new Date(b.data) - new Date(a.data));
                const top3 = istArray.slice(0, 3);
                
                top3.forEach(int => {
                    istoricHTML += `
                        <tr>
                            <td><b>${int.data}</b></td>
                            <td>${int.verificari || '-'}</td>
                            <td>${int.obs || '-'}</td>
                        </tr>`;
                });
            } else {
                istoricHTML = "<tr><td colspan='3' style='text-align:center;'>Fără istoric înregistrat.</td></tr>";
            }

            const popupContent = `
                <div class="popup-header">
                    <h3>${u.nume}</h3>
                    <p>${u.model || 'Fără model declarat'}</p>
                </div>
                <div class="popup-body">
                    <p style="font-size:11px; margin-top:0;"><b>Secție:</b> ${u.sectie}</p>
                    <b>Ultimele intervenții:</b>
                    <table class="history-table">
                        <thead><tr><th>Data</th><th>Bife / Operațiuni</th><th>Observații</th></tr></thead>
                        <tbody>${istoricHTML}</tbody>
                    </table>
                </div>
                <button class="btn-export-mini" onclick="exportaFisa('${key}')">📥 Exportă Istoric Utilaj (Excel)</button>
            `;

            const m = L.marker([u.lat, u.lng], {
                icon: L.icon({ iconUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon.png', className: 'existing-pin', iconSize: [25, 41], iconAnchor: [12, 41] })
            }).addTo(map).bindPopup(popupContent);
            
            m.uData = { id: String(u.id).toUpperCase(), nume: u.nume.toUpperCase() };
            markersList.push(m);
        });
    }

    function deschideRapoarte() {
        const corpTabel = document.getElementById('corptabel');
        const corpScadente = document.getElementById('corpScadente');
        corpTabel.innerHTML = ""; corpScadente.innerHTML = "";
        
        let alerteGasite = 0;

        Object.keys(dbRaw).forEach(key => {
            const u = dbRaw[key];
            let ultimaData = "-";
            let zile = 999;

            if (u.istoric) {
                const istArray = Object.values(u.istoric).sort((a, b) => new Date(b.data) - new Date(a.data));
                ultimaData = istArray[0].data;
                zile = calculZile(ultimaData);
            }

            // Populare tabel mic (dreapta)
            corpTabel.innerHTML += `<tr><td><b>${u.nume}</b><br><span style="font-size:10px;color:gray;">${u.sectie}</span></td><td>${ultimaData}</td></tr>`;

            // LOGICA DE ALERTE CONFORM PLAN 2026
            let status = "";
            let actiune = "";
            let randTabel = "";

            if (zile >= 365) {
                actiune = "<b>Revizie ANUALĂ:</b> Schimb ulei transmisie, inlocuire curele/rulmenți, verificare tablou electric.";
                status = `<span class="status-pill bg-crit">CRITIC</span>`;
            } else if (zile >= 180) {
                actiune = "<b>Revizie SEMESTRIALĂ:</b> Verificare sistem hidraulic, curățare condensator, verificare ulei pompa vid.";
                status = `<span class="status-pill bg-crit">DEPĂȘIT</span>`;
            } else if (zile >= 90) {
                actiune = "<b>Inspecție TRIMESTRIALĂ:</b> Reîntindere curele, curățare ventil balast/filtre aer.";
                status = `<span class="status-pill bg-warn">URMEAZĂ</span>`;
            } else if (zile >= 30) {
                actiune = "<b>Inspecție LUNARĂ:</b> Verificare nivel ulei, curățare filtre, ungere lanț.";
                status = `<span class="status-pill bg-warn">DE VERIFICAT</span>`;
            }

            // Dacă se încadrează la o alertă, o băgăm în tabelul mare din stânga
            if (actiune !== "") {
                alerteGasite++;
                randTabel = `
                    <tr>
                        <td><b>${u.nume}</b><br><span style="font-size:10px;color:gray;">${u.sectie} | ${u.model||''}</span></td>
                        <td><b style="color:red;">${zile === 999 ? "Lipsă Date" : zile + " zile"}</b></td>
                        <td style="font-size:11px;">${actiune}</td>
                        <td>${status}</td>
                    </tr>`;
                corpScadente.innerHTML += randTabel;
            }
        });

        if (alerteGasite === 0) {
            corpScadente.innerHTML = "<tr><td colspan='4' style='text-align:center; padding:20px; font-weight:bold; color:var(--success);'>Toate utilajele sunt în grafic conform Planului 2026! 🎉</td></tr>";
        }

        document.getElementById('reportModal').style.display = "flex";
    }

    function exportaFisa(key) {
        const u = dbRaw[key];
        let csv = "\uFEFFDATA;UTILAJ;SECTIE;MODEL;VERIFICARI;OBSERVATII\n";
        if (u.istoric) {
            Object.values(u.istoric).forEach(i => {
                csv += `${i.data};${u.nume};${u.sectie};${u.model || "-"};${(i.verificari || "").replace(/;/g, ",")};${(i.obs || "").replace(/;/g, ",")}\n`;
            });
        }
        const b = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const a = document.createElement("a"); a.href = URL.createObjectURL(b); a.download = `Istoric_${u.nume}.csv`; a.click();
    }

    function exportaTotExcel() {
        let csv = "\uFEFFDATA;UTILAJ;SECTIE;MODEL;VERIFICARI;OBSERVATII\n";
        Object.values(dbRaw).forEach(u => {
            if(u.istoric) {
                Object.values(u.istoric).forEach(i => {
                    csv += `${i.data};${u.nume};${u.sectie};${u.model || "-"};${(i.verificari || "").replace(/;/g, ",")};${(i.obs || "").replace(/;/g, ",")}\n`;
                });
            }
        });
        const b = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const a = document.createElement("a"); a.href = URL.createObjectURL(b); a.download = "Baza_Date_Mentenanta.csv"; a.click();
    }

    function cauta() {
        const val = document.getElementById('searchInput').value.toUpperCase().trim();
        const gasit = markersList.find(m => m.uData.id.includes(val) || m.uData.nume.includes(val));
        if(gasit) { map.setView(gasit.getLatLng(), 2); gasit.openPopup(); } 
        else { alert("Utilajul nu a fost găsit pe hartă!"); }
    }
</script>
</body>
</html>
Explicația Sfatului Meu (Implementarea Logicii)
Am integrat în cod o funcție care verifică zilnic „ceartă” de timp (câte zile au trecut de la ultima dată când ai dat „Salvează” pentru acel utilaj).

Dacă trec 30 de zile -> Apare portocaliu și îți zice să verifici filtrele și uleiul.

Dacă trec 90 de zile -> Se adaugă verificarea curelelor și ventilului de la pompa de vid.

Dacă trece un an -> Intră pe Roșu Critic și îți zice că trebuie revizia anuală majoră (schimb ulei transmisie, rulmenți, etc.).

Aplicația gândește acum automat în locul tău și te avertizează exact ce proceduri din „Planul 2026”  trebuie executate. Tot ce trebuie să faci este să folosești butonul edit.html pentru a bifa și salva o intervenție nouă, iar cronometrul se resetează automat la zero pentru acel utilaj!  

toate pinurile sunt culoarea rosie. de ce? uite de exemplu la masinile de umplere s-a schimbat uleiul pe 31.01.2026, asta se afla in sectia fabricatie.

Pinii apar de culoare roșie (sau o nuanță apropiată) din două motive posibile în codul actual: fie din cauza filtrului setat pe secțiune (Tratament Termic are un filtru care bate spre roșu), fie pentru că sistemul calculează că acele utilaje sunt scadente (întârziate) conform Planului 2026.

Dacă luăm exemplul tău: Mașini de umplere, ultima intervenție 31.01.2026.
Astăzi fiind 11.05.2026, au trecut exact 100 de zile.
Conform logicii din documentul tău (Planul 2026), la 90 de zile (Trimestrial) trebuia făcută verificarea curelelor și a filtrelor. De aceea, sistemul le marchează ca fiind „în întârziere”.

Ca să fie totul clar vizual, am modificat codul din view.html astfel încât culoarea pinului de pe hartă să se schimbe automat în funcție de starea de mentenanță, nu de secție:

VERDE: Mentenanță la zi (0 - 30 zile).

PORTOCALIU: Mentenanță necesară curând (30 - 90 zile).

ROȘU: Mentenanță DEPĂȘITĂ (peste 90 zile).

