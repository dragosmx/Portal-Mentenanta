<script>
    const firebaseConfig = { 
        databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" 
    };
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    var map = L.map('map', { crs: L.CRS.Simple, minZoom: 0, maxZoom: 3 });
    L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map);
    map.setView([500, 700], 1); 

    let dbRaw = {};
    let markersGroup = L.layerGroup().addTo(map);
    let activeMarker = null;
    let selectedId = null;
    let currentCoords = null;
    
    document.getElementById('data').valueAsDate = new Date();

    database.ref('utilaje').on('value', (snap) => { 
        dbRaw = snap.val() || {}; 
        refreshPini(); 
    });

    // Pinii vizuali pe harta de editare pot ramane cei clasici de Leaflet
    function refreshPini() {
        markersGroup.clearLayers();
        Object.keys(dbRaw).forEach(id => {
            const u = dbRaw[id];
            if(u.lat && u.lng) {
                const m = L.marker([u.lat, u.lng], { 
                    icon: L.icon({ 
                        iconUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon.png', 
                        className: 'existing-pin', 
                        iconSize: [25, 41], 
                        iconAnchor: [12, 41] 
                    }) 
                }).addTo(markersGroup);
                
                m.on('click', (e) => { 
                    L.DomEvent.stopPropagation(e); 
                    incarcaUtilaj(id); 
                });
            }
        });
    }

    map.on('click', (e) => {
        if(selectedId) return; 
        currentCoords = [e.latlng.lat.toFixed(0), e.latlng.lng.toFixed(0)];
        
        if(activeMarker) map.removeLayer(activeMarker);
        
        activeMarker = L.marker(e.latlng).addTo(map); 
        checkReady();
    });

    function incarcaUtilaj(id) {
        selectedId = id; 
        const u = dbRaw[id];
        
        document.getElementById('nume').value = u.nume; 
        document.getElementById('model').value = u.model || ""; 
        document.getElementById('sectie').value = u.sectie;
        
        document.getElementById('status').innerHTML = `MOD: EDITARE UTILAJ (ID: ${id})`; 
        document.getElementById('status').className = "status-badge status-edit";
        
        document.getElementById('deleteZone').innerHTML = `<button class="btn-del" onclick="stergeUtilaj('${id}')">⚠️ ȘTERGE UTILAJ DEFINITIV</button>`;
        
        if(activeMarker) map.removeLayer(activeMarker); 
        
        toggleExtra(); 
        checkReady();
    }

    // AICI AM IMPLEMENTAT DATELE TALE REALE DIN DOCUMENT
    function toggleExtra() {
        const s = document.getElementById('sectie').value;
        let html = '<label>Operațiuni Plan Mentenanță 2026:</label><div class="checklist">';

        if (s === 'Tocare' || s === 'Injectare') {
            html += `
                <label class="check-item"><input type="checkbox" class="task" value="Filtru admisie aer"> Filtru admisie aer</label>
                <label class="check-item"><input type="checkbox" class="task" value="Sistem hidraulic"> Sistem hidraulic</label>
                <label class="check-item"><input type="checkbox" class="task" value="Motor principal"> Motor principal (cabluri/ventilare)</label>
                <label class="check-item"><input type="checkbox" class="task" value="Transmisie cuva (Shell Tellus)"> Transmisie cuvă (Schimb ulei)</label>
                <label class="check-item"><input type="checkbox" class="task" value="Descarcator pasta"> Descărcător pastă</label>
                <label class="check-item"><input type="checkbox" class="task" value="Curele transmisie"> Reîntindere/Schimb Curele</label>`;
        } else if (s === 'Tranșare') {
            html += `
                <label class="check-item"><input type="checkbox" class="task" value="Benzi transport"> Verificare benzi transport</label>
                <label class="check-item"><input type="checkbox" class="task" value="Tablou electric"> Tablou electric (contacte)</label>
                <label class="check-item"><input type="checkbox" class="task" value="Sistem taiere"> Sistem tăiere (Ascuțire/Gresare)</label>`;
        } else if (s === 'Ambalare Vid') {
            html += `
                <label class="check-item"><input type="checkbox" class="task" value="Ulei Pompa Vid"> Ulei Pompă Vid</label>
                <label class="check-item"><input type="checkbox" class="task" value="Rezistente Lipire"> Rezistențe Lipire</label>
                <label class="check-item"><input type="checkbox" class="task" value="Banda Teflon"> Bandă Teflon</label>`;
        } else {
            html += `
                <label class="check-item"><input type="checkbox" class="task" value="Inspectie Vizuala"> Inspecție Vizuală</label>
                <label class="check-item"><input type="checkbox" class="task" value="Verificare Tablou"> Tablou Electric</label>`;
        }
        
        html += `</div><div class="group" style="margin-top:10px;"><label>Altă operațiune (Scrieți manual):</label><input type="text" id="extraCheck"></div>`;
        document.getElementById('extraFields').innerHTML = html;
    }

    function checkReady() {
        document.getElementById('saveBtn').disabled = !( (selectedId || currentCoords) && document.getElementById('nume').value.trim().length > 2 );
    }

    async function stergeUtilaj(id) { 
        if (confirm("Ești sigur că vrei să ștergi acest utilaj și întregul său istoric?")) { 
            await database.ref('utilaje/' + id).remove(); 
            resetForm(); 
        } 
    }

    async function salveaza() {
        const btn = document.getElementById('saveBtn'); 
        const msg = document.getElementById('feedbackMsg');
        
        btn.disabled = true; 
        btn.innerText = "⏳ SE SALVEAZĂ...";

        try {
            const bife = Array.from(document.querySelectorAll('.task:checked')).map(c => c.value).join(", ");
            const manual = document.getElementById('extraCheck') ? document.getElementById('extraCheck').value : "";
            
            const entry = {
                data: document.getElementById('data').value,
                tip: document.getElementById('tipInterventie').value,
                mecanic: document.getElementById('mecanic').value,
                verificari: bife + (manual ? " | " + manual : ""),
                obs: document.getElementById('obs').value,
                timestamp: Date.now()
            };

            if (selectedId) {
                await database.ref('utilaje/' + selectedId + '/istoric').push().set(entry);
                await database.ref('utilaje/' + selectedId + '/model').set(document.getElementById('model').value);
                await database.ref('utilaje/' + selectedId + '/sectie').set(document.getElementById('sectie').value);
            } else {
                const idNou = "K-" + Math.floor(1000 + Math.random() * 9000);
                await database.ref('utilaje/' + idNou).set({ 
                    id: idNou, 
                    nume: document.getElementById('nume').value, 
                    model: document.getElementById('model').value, 
                    sectie: document.getElementById('sectie').value, 
                    lat: parseFloat(currentCoords[0]), 
                    lng: parseFloat(currentCoords[1]), 
                    istoric: { "init": entry } 
                });
            }

            msg.innerText = "✅ SALVAT CU SUCCES!"; 
            msg.className = "msg-popup msg-success"; 
            msg.style.display = "block";
            
            setTimeout(() => { 
                resetForm(); 
                btn.innerText = "💾 SALVEAZĂ FIȘA"; 
                msg.style.display = "none"; 
            }, 2000);
            
        } catch(e) {
            msg.innerText = "❌ EROARE: " + e.message; 
            msg.className = "msg-popup msg-error"; 
            msg.style.display = "block";
            
            btn.disabled = false; 
            btn.innerText = "💾 ÎNCEARCĂ DIN NOU";
        }
    }

    function resetForm() {
        selectedId = null; 
        currentCoords = null;
        
        document.getElementById('nume').value = ""; 
        document.getElementById('model').value = ""; 
        document.getElementById('obs').value = ""; 
        document.getElementById('mecanic').value = "";
        
        document.getElementById('status').innerHTML = `MOD: UTILAJ NOU`; 
        document.getElementById('status').className = "status-badge"; 
        document.getElementById('deleteZone').innerHTML = "";
        
        if (activeMarker) map.removeLayer(activeMarker); 
        
        toggleExtra(); 
        checkReady();
    }

    toggleExtra(); 
    window.onload = () => { setTimeout(() => map.invalidateSize(), 500); };
</script>
</body>
</html>
in edit tot lipsesc linii de cod

Îmi cer mii de scuze! M-am uitat pe codul generat anterior și am realizat unde este problema: din dorința de a face textul mai scurt în răspuns, am pus mai multe comenzi JavaScript pe aceeași linie (de exemplu: document.getElementById('nume').value = ""; document.getElementById('model').value = ""; scrise la rând). Același lucru l-am făcut și la CSS.

Acest lucru face codul foarte greu de citit pentru tine, pare că lipsesc porțiuni și poate ascunde erori.

De data aceasta, am scris fiecare proprietate CSS, fiecare div și fiecare comandă JavaScript pe un rând separat, exact cum se scrie codul în mod profesional, curat și aerisit. Nu am scurtat și nu am șters ABSOLUT NIMIC. Am inclus și toate detaliile din documentul tău PLANIFICARE MENTENANTA 2026 (ulei Shell Tellus, ascuțire feliator Bizerba, etc.).

Te rog să copiezi tot acest bloc de cod și să înlocuiești complet fișierul edit.html:

