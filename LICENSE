        #sidebar { width: 420px; height: 100vh; background: var(--primary); padding: 25px; overflow-y: auto; box-sizing: border-box; border-right: 1px solid rgba(255,255,255,0.1); box-shadow: 10px 0 30px rgba(0,0,0,0.5); }
        .logo-box { text-align: center; margin-bottom: 20px; } .logo-box img { max-width: 120px; }
        
        .nav-header { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 15px; }
        .btn-nav { padding: 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: white; text-align: center; text-decoration: none; font-size: 11px; font-weight: bold; }
        
