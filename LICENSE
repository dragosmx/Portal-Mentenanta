<script>
    const firebaseConfig = { databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" };
    firebase.initializeApp(firebaseConfig); const database = firebase.database();
    var map = L.map('map', { crs: L.CRS.Simple, minZoom: 0, maxZoom: 3 }); L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map); map.setView([500, 700], 1); 

    let dbRaw = {}, markersGroup = L.layerGroup().addTo(map), activeMarker = null, selectedId = null, currentCoords = null;
    document.getElementById('data').valueAsDate = new Date();

    database.ref('utilaje').on('value', (snap) => { 
        dbRaw = snap.val() || {}; 
        refreshPini(); 
        const urlParams = new URLSearchParams(window.location.search);
        const qrId = urlParams.get('id');
        if (qrId && dbRaw[qrId] && selectedId !== qrId) incarcaUtilaj(qrId);
    });

    function refreshPini() {
        markersGroup.clearLayers();
        Object.keys(dbRaw).forEach(id => {
            const u = dbRaw[id];
            if(u.lat && u.lng) {
                const m = L.marker([u.lat, u.lng], { icon: L.icon({ iconUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon.png', className: 'existing-pin', iconSize: [25, 41], iconAnchor: [12, 41] }) }).addTo(markersGroup);
                m.on('click', (e) => { L.DomEvent.stopPropagation(e); incarcaUtilaj(id); });
            }
        });
    }

    map.on('click', (e) => {
        if(selectedId) return; currentCoords = [e.latlng.lat.toFixed(0), e.latlng.lng.toFixed(0)];
        if(activeMarker) map.removeLayer(activeMarker);
        activeMarker = L.marker(e.latlng).addTo(map); checkReady();
    });

    function incarcaUtilaj(id) {
        selectedId = id; const u = dbRaw[id];
        document.getElementById('nume').value = u.nume; document.getElementById('model').value = u.model || ""; document.getElementById('sectie').value = u.sectie;
        document.getElementById('status').innerHTML = `MOD: EDITARE (${id})`; 
        document.getElementById('deleteZone').innerHTML = `<button class="btn-del" onclick="stergeUtilaj('${id}')">⚠️ ȘTERGE DEFINITIV</button>`;
        toggleExtra(); checkReady();
    }

    function toggleExtra() {
        const s = document.getElementById('sectie').value;
        let html = '<label>Plan Mentenanță 2026:</label><div class="checklist">';
        if (s === 'Tocare' || s === 'Injectare') {
            html += `<label class="check-item"><input type="checkbox" class="task" value="Filtru aer"> Filtru aer</label><label class="check-item"><input type="checkbox" class="task" value="Sistem hidraulic"> Sistem hidraulic</label><label class="check-item"><input type="checkbox" class="task" value="Ulei Transmisie"> Schimb Ulei (Shell Tellus)</label><label class="check-item"><input type="checkbox" class="task" value="Curele"> Curele</label>`;
        } else if (s === 'Tranșare') {
            html += `<label class="check-item"><input type="checkbox" class="task" value="Benzi"> Benzi transport</label><label class="check-item"><input type="checkbox" class="task" value="Sistem taiere"> Sistem tăiere (Ascuțire)</label>`;
        } else {
            html += `<label class="check-item"><input type="checkbox" class="task" value="Inspectie"> Inspecție Vizuală</label><label class="check-item"><input type="checkbox" class="task" value="Tablou"> Tablou Electric</label>`;
        }
        html += `</div><input type="text" id="extraCheck" placeholder="Altceva manual..." style="margin-top:10px;">`;
        document.getElementById('extraFields').innerHTML = html;
    }

    function checkReady() { document.getElementById('saveBtn').disabled = !( (selectedId || currentCoords) && document.getElementById('nume').value.trim().length > 2 ); }
    async function stergeUtilaj(id) { if(confirm("Ștergi utilajul?")) { await database.ref('utilaje/'+id).remove(); resetForm(); } }

    async function salveaza() {
        const btn = document.getElementById('saveBtn'); btn.disabled = true;
        try {
            const bife = Array.from(document.querySelectorAll('.task:checked')).map(c => c.value).join(", ");
            const manual = document.getElementById('extraCheck').value;
            const entry = {
                data: document.getElementById('data').value,
                tip: document.getElementById('tipInterventie').value,
                mecanic: document.getElementById('mecanic').value,
                cost: parseFloat(document.getElementById('cost').value) || 0,
                verificari: bife + (manual ? " | " + manual : ""),
                obs: document.getElementById('obs').value,
                timestamp: Date.now()
            };
            if (selectedId) {
                await database.ref('utilaje/'+selectedId+'/istoric').push().set(entry);
                await database.ref('utilaje/'+selectedId+'/model').set(document.getElementById('model').value);
                await database.ref('utilaje/'+selectedId+'/sectie').set(document.getElementById('sectie').value);
            } else {
                const idN = "K-" + Math.floor(1000 + Math.random() * 9000);
                await database.ref('utilaje/'+idN).set({ id: idN, nume: document.getElementById('nume').value, model: document.getElementById('model').value, sectie: document.getElementById('sectie').value, lat: parseFloat(currentCoords[0]), lng: parseFloat(currentCoords[1]), istoric: { "init": entry } });
            }
            alert("✅ SALVAT!"); resetForm();
        } catch(e) { alert("Eroare: " + e.message); btn.disabled = false; }
    }

    function resetForm() {
        selectedId = null; currentCoords = null;
        document.getElementById('nume').value = ""; document.getElementById('model').value = ""; document.getElementById('mecanic').value = ""; document.getElementById('cost').value = "";
        document.getElementById('status').innerHTML = "MOD: UTILAJ NOU"; document.getElementById('deleteZone').innerHTML = "";
        if (activeMarker) map.removeLayer(activeMarker); toggleExtra(); checkReady();
    }
    toggleExtra();
</script>
</body>
</html>
