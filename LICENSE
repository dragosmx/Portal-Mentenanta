PASUL 1: Rezolvarea Pinilor Roșii în view.html
Deschide view.html, mergi jos de tot la secțiunea <script> și înlocuiește funcția afiseazaPuncte() cu varianta de mai jos. Aceasta folosește icoane SVG indestructibile:

JavaScript
    // Funcție pentru a genera Pini SVG colorați 100% sigur
    function getColoredIcon(color) {
        const svgIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 36" width="28" height="42"><path fill="${color}" stroke="#000" stroke-width="1" d="M12 0C5.373 0 0 5.373 0 12c0 7.333 12 24 12 24s12-16.667 12-24C24 5.373 18.627 0 12 0zm0 17.5c-3.038 0-5.5-2.462-5.5-5.5S8.962 6.5 12 6.5s5.5 2.462 5.5 5.5-2.462 5.5-5.5 5.5z"/></svg>`;
        return L.divIcon({
            className: "custom-svg-icon",
            html: svgIcon,
            iconSize: [28, 42],
            iconAnchor: [14, 42],
            popupAnchor: [0, -40]
        });
    }

    function afiseazaPuncte() {
        const filtru = document.getElementById('filterSectie').value;
        markersList.forEach(m => map.removeLayer(m));
        markersList = [];

        Object.keys(dbRaw).forEach(id => {
            const u = dbRaw[id];
            if(filtru !== "Toate" && u.sectie !== filtru) return;
            if(!u.lat || !u.lng) return;

            let ultimaData = "-";
            let tabelPop = "";
            if(u.istoric) {
                const ist = Object.values(u.istoric).sort((a,b) => new Date(b.data) - new Date(a.data));
                ultimaData = ist[0].data;
                ist.slice(0, 3).forEach(i => {
                    tabelPop += `<tr><td>${i.data}</td><td>${i.verificari || '-'}</td></tr>`;
                });
            }

            const zile = calculZile(ultimaData);
            
            // AICI STABILIM CULOAREA EXACTĂ HEXADECIMALĂ
            let hexColor = "#e74c3c"; // Roșu implicit (Peste 90 zile sau lipsă)
            if(zile < 30) hexColor = "#27ae60"; // Verde (Sub 30 zile)
            else if(zile < 90) hexColor = "#f39c12"; // Galben/Portocaliu (Intre 30 si 90 zile)

            const marker = L.marker([u.lat, u.lng], {
                icon: getColoredIcon(hexColor)
            }).addTo(map);

            marker.bindPopup(`
                <div class="popup-header">
                    <h3>${u.nume}</h3>
                    <p>ID: ${u.id} | Ultima revizie: ${ultimaData}</p>
                </div>
                <div class="popup-body">
                    <b>Istoric recent:</b>
                    <table class="history-table">
                        <thead><tr><th>Dată</th><th>Operațiuni</th></tr></thead>
                        <tbody>${tabelPop || '<tr><td colspan="2">Fără istoric</td></tr>'}</tbody>
                    </table>
                    <button class="btn-mini-excel" onclick="exportaFisa('${id}')">📥 Descarcă Fișa Utilaj</button>
                </div>
            `);

            marker.uData = { nume: u.nume.toUpperCase(), id: String(u.id).toUpperCase() };
            markersList.push(marker);
        });
    }
Salvează și dă refresh. Acum pinii modificați sâmbătă (9 mai) pe care i-ai introdus trebuie să apară verde aprins!

