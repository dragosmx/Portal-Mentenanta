<script>
    // 1. Initializare Firebase
    const firebaseConfig = { 
        databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" 
    };
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    // 2. Initializare Hartă
    // AM REZOLVAT SUPRAPUNEREA MUTÂND BUTOANELE ZOOM JOS-DREAPTA
    var map = L.map('map', { 
        crs: L.CRS.Simple, 
        minZoom: 0, 
        maxZoom: 3,
        zoomControl: false // Oprim controalele default din stânga sus
    });
    
    L.control.zoom({ position: 'bottomright' }).addTo(map); // Le adăugăm în dreapta jos
    
    L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map);
    map.setView([500, 700], 0.5);

    // 3. Variabile globale
    let dbRaw = {}; 
    let markersList = []; 
    let chartInstance = null;

    // 4. Preluare Date din baza de date
    database.ref('utilaje').on('value', (snap) => {
        dbRaw = snap.val() || {};
        afiseazaPuncte();
    });

    // 5. Calculare diferență zile
    function calculZile(dataStr) {
        if (!dataStr || dataStr === "-") return 999;
        const diff = new Date() - new Date(dataStr);
        return Math.floor(diff / (1000 * 3600 * 24));
    }

    // 6. Generare Pini SVG Colorați
    function getColoredIcon(color) {
        const svg = `
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 36" width="28" height="42">
                <path fill="${color}" stroke="#000" stroke-width="1.5" d="M12 0C5.373 0 0 5.373 0 12c0 7.333 12 24 12 24s12-16.667 12-24C24 5.373 18.627 0 12 0zm0 17.5c-3.038 0-5.5-2.462-5.5-5.5S8.962 6.5 12 6.5s5.5 2.462 5.5 5.5-2.462 5.5-5.5 5.5z"/>
            </svg>`;
        return L.divIcon({ className: "custom-pin", html: svg, iconSize: [28, 42], iconAnchor: [14, 42], popupAnchor: [0, -40] });
    }

    // 7. AFIȘARE PUNCTE, POPUP DETALIAT ȘI AUTO-ZOOM PE SECȚIE
    function afiseazaPuncte() {
        const filtru = document.getElementById('filterSectie').value;
        
        // Curățăm harta
        markersList.forEach(m => map.removeLayer(m));
        markersList = [];
        let boundsArray = [];

        Object.keys(dbRaw).forEach(id => {
            const u = dbRaw[id];
            if (filtru !== "Toate" && u.sectie !== filtru) return;
            if (!u.lat || !u.lng) return;

            let ultimaData = "-";
            let tabelPopHtml = "";
            let statusText = "🟢 OK";

            if (u.istoric) {
                const istoricArray = Object.values(u.istoric);
                istoricArray.sort((a, b) => new Date(b.data) - new Date(a.data));
                ultimaData = istoricArray[0].data;
                
                const ultimeleTrei = istoricArray.slice(0, 3);
                ultimeleTrei.forEach(i => {
                    let culoareTip = (i.tip && i.tip.includes('Corectivă')) ? "#e74c3c" : "#27ae60";
                    let mecanicNume = i.mecanic || 'Nespecificat';
                    let operatiuni = i.verificari || '<i>Nicio operațiune bifată</i>';
                    let tipInterventie = i.tip || 'Plan';

                    tabelPopHtml += `
                        <tr>
                            <td style="padding: 6px; border-bottom: 1px solid #eee; vertical-align: top; white-space: nowrap; width: 35%;">
                                <b>${i.data}</b><br>
                                <span style="font-size:9px; color:#7f8c8d;">${mecanicNume}</span>
                            </td>
                            <td style="padding: 6px; border-bottom: 1px solid #eee; vertical-align: top; font-size:10px;">
                                <span style="color:${culoareTip}; font-weight:bold;">[${tipInterventie}]</span><br>
                                <span style="color:#2c3e50;">${operatiuni}</span>
                            </td>
                        </tr>
                    `;
                });
            } else {
                tabelPopHtml = `<tr><td colspan="2" style="text-align:center; padding: 10px;">Lipsă date istoric.</td></tr>`;
            }
            
            const zile = calculZile(ultimaData);
            let hexColor = "#e74c3c"; 
            if (zile < 30) { hexColor = "#27ae60"; statusText = "🟢 ÎN GRAFIC"; } 
            else if (zile < 90) { hexColor = "#f39c12"; statusText = "🟡 NECESITĂ ATENȚIE"; } 
            else { statusText = "🔴 CRITIC / DEPĂȘIT"; }

            const m = L.marker([u.lat, u.lng], { icon: getColoredIcon(hexColor) }).addTo(map);
            boundsArray.push([u.lat, u.lng]);
            
            const popHtml = `
                <div class="popup-header">
                    <h3>${u.nume}</h3>
                    <p>Model: ${u.model || '-'} | ID: ${u.id}</p>
                </div>
                <div class="popup-body">
                    <div class="last-info">
                        <b>Status Actual:</b> ${statusText}<br>
                        <b>Zile scurse de la ultima revizie:</b> ${zile === 999 ? 'Niciodată' : zile + ' zile'}
                    </div>
                    <b style="font-size:11px; color:#2c3e50; text-transform: uppercase;">Ce s-a lucrat ultima oară:</b>
                    <table style="width:100%; border-collapse:collapse; font-size:11px; margin-top:8px; margin-bottom:10px;">
                        <thead>
                            <tr style="background:#f1f2f6; color: #555;">
                                <th style="padding:5px; text-align:left;">Data / Om</th>
                                <th style="padding:5px; text-align:left;">Operațiuni Efectuate</th>
                            </tr>
                        </thead>
                        <tbody>${tabelPopHtml}</tbody>
                    </table>
                    <button class="btn-history" onclick="deschideIstoricUtilaj('${id}')">📜 VEZI ISTORIC COMPLET</button>
                </div>
            `;
            m.bindPopup(popHtml);
            m.uData = { id: String(u.id).toUpperCase(), nume: u.nume.toUpperCase() };
            markersList.push(m);
        });

        // Executăm Auto-Zoom-ul dacă am selectat o secție
        if (boundsArray.length > 0 && filtru !== "Toate") {
            map.fitBounds(boundsArray, { padding: [50, 50], maxZoom: 1.5 });
        } else if (filtru === "Toate") {
            map.setView([500, 700], 0.5);
        }
    }

    // 8. MODAL ISTORIC INDIVIDUAL (Fără cost)
    function deschideIstoricUtilaj(id) {
        const u = dbRaw[id];
        document.getElementById('histNume').innerText = u.nume;
        document.getElementById('histModel').innerText = "Model: " + (u.model || "-") + " | Secție: " + u.sectie;
        const corp = document.getElementById('corpIstoricIndividual');
        corp.innerHTML = "";
        
        if (u.istoric) {
            const istSorted = Object.values(u.istoric);
            istSorted.sort((a, b) => new Date(b.data) - new Date(a.data));
            
            istSorted.forEach(i => {
                corp.innerHTML += `
                    <tr>
                        <td><b>${i.data}</b></td>
                        <td>${i.tip || 'Preventivă'}</td>
                        <td><i>${i.mecanic || '-'}</i></td>
                        <td>${i.verificari || '-'}</td>
                        <td>${i.obs || '-'}</td>
                    </tr>
                `;
            });
        } else {
            corp.innerHTML = "<tr><td colspan='5' style='text-align:center;'>Nu există istoric pentru acest utilaj.</td></tr>";
        }
        document.getElementById('btnExportIndividual').onclick = () => exportaExcelIndividual(id);
        document.getElementById('historyModal').style.display = "flex";
    }

    // 9. DASHBOARD GENERAL (Axat pe intervenții, nu costuri)
    function deschideRapoarte() {
        const corp = document.getElementById('corpScadente');
        corp.innerHTML = "";
        let countOk = 0, countWarn = 0, countCrit = 0, totalInterventii = 0;

        Object.values(dbRaw).forEach(u => {
            let ultimaData = "-";
            if (u.istoric) {
                const istArray = Object.values(u.istoric);
                totalInterventii += istArray.length; // Calculăm volumul total de muncă
                istArray.sort((a, b) => new Date(b.data) - new Date(a.data));
                ultimaData = istArray[0].data;
            }
            
            const zile = calculZile(ultimaData);
            if (zile < 30) countOk++; 
            else if (zile < 90) countWarn++; 
            else countCrit++;

            let actiune = "", statusBadge = "";
            if (zile >= 365) { actiune = "Revizie Anuală Plan"; statusBadge = `<span class="status-pill bg-crit">CRITIC</span>`; } 
            else if (zile >= 180) { actiune = "Revizie Semestrială"; statusBadge = `<span class="status-pill bg-crit">DEPĂȘIT</span>`; } 
            else if (zile >= 30) { actiune = "Control Lunar"; statusBadge = `<span class="status-pill bg-warn">URMEAZĂ</span>`; }
            
            if (zile >= 30 || ultimaData === "-") {
                corp.innerHTML += `
                    <tr>
                        <td><b>${u.nume}</b><br><small>${u.sectie}</small></td>
                        <td>${zile === 999 ? 'LIPSĂ' : zile + ' zile'}</td>
                        <td>${actiune || 'Inspecție standard'}</td>
                        <td>${statusBadge || '<span class="status-pill bg-warn">URMEAZĂ</span>'}</td>
                    </tr>
                `;
            }
        });

        document.getElementById('totalInterventii').innerText = totalInterventii;

        const ctx = document.getElementById('statusChart').getContext('2d');
        if (chartInstance) chartInstance.destroy();
        chartInstance = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['OK', 'Atenție', 'Critic'],
                datasets: [{ data: [countOk, countWarn, countCrit], backgroundColor: ['#27ae60', '#f39c12', '#e74c3c'], borderWidth: 0 }]
            },
            options: { plugins: { legend: { position: 'bottom' } } }
        });
        document.getElementById('reportModal').style.display = "flex";
    }

    // 10. EXPORT EXCEL GENERAL (Fără cost)
    function exportaExcelNativ() {
        let dateExcel = [];
        Object.values(dbRaw).forEach(u => {
            if (u.istoric) {
                Object.values(u.istoric).forEach(i => {
                    dateExcel.push({ 
                        "Data": i.data, "Utilaj": u.nume, "ID": u.id, "Secție": u.sectie, 
                        "Mecanic": i.mecanic || "-", "Tip": i.tip || "-", 
                        "Operațiuni": i.verificari || "-", "Observații": i.obs || "-" 
                    });
                });
            }
        });
        const ws = XLSX.utils.json_to_sheet(dateExcel);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Istoric General");
        XLSX.writeFile(wb, "Raport_Mentenanta_Killer.xlsx");
    }

    // 11. EXPORT EXCEL INDIVIDUAL (Fără cost)
    function exportaExcelIndividual(id) {
        const u = dbRaw[id];
        let dateExcel = [];
        if (u.istoric) {
            Object.values(u.istoric).forEach(i => {
                dateExcel.push({ 
                    "Data": i.data, "Tip": i.tip || "-", "Tehnician": i.mecanic || "-", 
                    "Operațiuni": i.verificari || "-", "Observații": i.obs || "-" 
                });
            });
        }
        const ws = XLSX.utils.json_to_sheet(dateExcel);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Fisa Service");
        XLSX.writeFile(wb, `Fisa_Service_${u.nume.replace(/ /g, "_")}.xlsx`);
    }

    // 12. ÎNCHIDERE MODAL
    function inchideModal(id) { document.getElementById(id).style.display = "none"; }
    
    // 13. CĂUTARE UTILAJ
    function cauta() {
        const val = document.getElementById('searchInput').value.toUpperCase().trim();
        const gasit = markersList.find(m => m.uData.id.includes(val) || m.uData.nume.includes(val));
        if (gasit) { map.setView(gasit.getLatLng(), 1.5); gasit.openPopup(); } 
        else { alert("Utilajul nu a fost găsit pe hartă!"); }
    }

    // 14. GENERARE ETICHETE QR PENTRU PRINTARE A4
    function printeazaQR() {
        let basePath = window.location.href.substring(0, window.location.href.lastIndexOf("/") + 1);
        let printWindow = window.open('', '_blank');
        let htmlContent = `
            <html><head><title>Printare Etichete QR</title><style>
            body { font-family: 'Arial', sans-serif; text-align: center; background: #fff; }
            .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; padding: 20px; }
            .card { border: 2px dashed #000; padding: 15px; border-radius: 10px; page-break-inside: avoid; text-align: center; }
            img { max-width: 150px; margin-bottom: 10px; }
            h3 { margin: 0; font-size: 14px; text-transform: uppercase; }
            p { margin: 5px 0 0; font-size: 11px; color: #333; font-weight: bold; }
            @media print { .no-print { display: none; } }
            </style></head><body>
            <button class="no-print" onclick="window.print()" style="padding:15px 30px; font-size:18px; margin:20px; cursor:pointer; background:#27ae60; color:white; border:none; border-radius:10px; font-weight:bold;">🖨️ PRINTARE DOCUMENT</button>
            <div class="grid">
        `;
        Object.values(dbRaw).forEach(u => {
            let linkDeScanat = basePath + 'scan.html?id=' + u.id;
            let imgQrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(linkDeScanat)}`;
            htmlContent += `<div class="card"><img src="${imgQrUrl}"><h3>${u.nume}</h3><p>Secția: ${u.sectie}</p><p>ID: ${u.id}</p></div>`;
        });
        htmlContent += `</div></body></html>`;
        printWindow.document.write(htmlContent);
        printWindow.document.close();
    }

    window.onload = () => { setTimeout(() => map.invalidateSize(), 600); };
</script>
</body>
</html>
dar iarasi lipsesc linii de cod

Îmi cer scuze, ai perfectă dreptate! Din cauza lungimii, sistemul a oprit generarea mesajului exact la mijlocul codului JavaScript.

Pentru a nu mai exista absolut nicio problemă, îți las mai jos întregul fișier view.html. M-am asigurat personal că generarea se duce până la capăt (până la eticheta </html>).

Am integrat:

Butoanele de Zoom (+/-) mutate în dreapta-jos (ca să nu se mai suprapună cu bara de căutare).

Eliminarea completă a costurilor (acum focusul este doar pe mentenanță, bife și număr de intervenții).

Popup-ul detaliat pe hartă.

Auto-zoom-ul când selectezi o secție.

Iată codul final, complet și desfășurat pentru view.html:

