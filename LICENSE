        // 🛡️ PAZNICUL DE ACCES
        if (sessionStorage.getItem('access_granted') !== 'true') {
            window.location.href = 'index.html';
        }
        
        // ⏱️ AUTO-LOGOUT (30 min inactivitate)
        let timeout;
        function resetTimer() {
            clearTimeout(timeout);
            timeout = setTimeout(() => {
                sessionStorage.removeItem('access_granted');
                window.location.href = 'index.html';
            }, 1800000);
        }
        window.onmousemove = resetTimer;
        window.onkeypress = resetTimer;

        // ⚠️ PREVENIRE ÎNCHIDERE ACCIDENTALĂ
        window.onbeforeunload = function() { 
            if(document.getElementById('nume').value !== "") {
                return "Ai date nesalvate care se vor pierde!";
            }
        };
    </script>

