    <style>
        body { margin: 0; padding: 15px; background: #f0f2f5; font-family: sans-serif; }
        .card { background: white; padding: 20px; border-radius: 15px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); max-width: 500px; margin: auto; }
        .h { background: #2c3e50; color: white; padding: 15px; border-radius: 10px; text-align: center; border-bottom: 4px solid #27ae60; }
