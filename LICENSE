<script>
    // 1. Initializare Firebase
    const firebaseConfig = { 
        databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" 
    };
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    // 2. Initializare Hartă
    var map = L.map('map', { 
        crs: L.CRS.Simple, 
        minZoom: 0, 
        maxZoom: 3 
    });
    
    L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map);
    map.setView([500, 700], 0.5);

    // 3. Variabile globale
    let dbRaw = {}; 
    let markersList = []; 
    let chartInstance = null;

    // 4. Preluare Date din baza de date
    database.ref('utilaje').on('value', (snap) => {
        dbRaw = snap.val() || {};
        afiseazaPuncte();
    });

    // 5. Calculare diferență zile
    function calculZile(dataStr) {
        if (!dataStr || dataStr === "-") {
            return 999;
        }
        const diff = new Date() - new Date(dataStr);
        return Math.floor(diff / (1000 * 3600 * 24));
    }

    // 6. Generare Pini SVG Colorați
    function getColoredIcon(color) {
        const svg = `
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 36" width="28" height="42">
                <path fill="${color}" stroke="#000" stroke-width="1.5" d="M12 0C5.373 0 0 5.373 0 12c0 7.333 12 24 12 24s12-16.667 12-24C24 5.373 18.627 0 12 0zm0 17.5c-3.038 0-5.5-2.462-5.5-5.5S8.962 6.5 12 6.5s5.5 2.462 5.5 5.5-2.462 5.5-5.5 5.5z"/>
            </svg>`;
        return L.divIcon({ 
            className: "custom-pin", 
            html: svg, 
            iconSize: [28, 42], 
            iconAnchor: [14, 42], 
            popupAnchor: [0, -40] 
        });
    }

    // 7. AFIȘARE PUNCTE, POPUP DETALIAT ȘI AUTO-ZOOM PE SECȚIE
    function afiseazaPuncte() {
        const filtru = document.getElementById('filterSectie').value;
        
        // Curățăm harta de markerii vechi
        markersList.forEach(m => map.removeLayer(m));
        markersList = [];

        // Variabilă pentru a păstra coordonatele utilajelor (pentru auto-zoom)
        let boundsArray = [];

        Object.keys(dbRaw).forEach(id => {
            const u = dbRaw[id];
            
            // Verificăm filtrele
            if (filtru !== "Toate" && u.sectie !== filtru) {
                return;
            }
            if (!u.lat || !u.lng) {
                return;
            }

            let ultimaData = "-";
            let tabelPopHtml = "";
            let statusText = "🟢 OK";

            // Construim tabelul din popup cu ultimele 3 intervenții
            if (u.istoric) {
                const istoricArray = Object.values(u.istoric);
                
                // Sortăm descrescător după dată
                istoricArray.sort((a, b) => new Date(b.data) - new Date(a.data));
                ultimaData = istoricArray[0].data;
                
                const ultimeleTrei = istoricArray.slice(0, 3);
                
                ultimeleTrei.forEach(i => {
                    let culoareTip = "#27ae60"; // Verde pentru preventivă
                    if (i.tip && i.tip.includes('Corectivă')) {
                        culoareTip = "#e74c3c"; // Roșu pentru defect
                    }
                    
                    let mecanicNume = i.mecanic ? i.mecanic : 'Nespecificat';
                    let operatiuni = i.verificari ? i.verificari : '<i>Nicio operațiune bifată</i>';
                    let tipInterventie = i.tip ? i.tip : 'Plan';

                    tabelPopHtml += `
                        <tr>
                            <td style="padding: 6px; border-bottom: 1px solid #eee; vertical-align: top; white-space: nowrap; width: 35%;">
                                <b>${i.data}</b><br>
                                <span style="font-size:9px; color:#7f8c8d;">${mecanicNume}</span>
                            </td>
                            <td style="padding: 6px; border-bottom: 1px solid #eee; vertical-align: top; font-size:10px;">
                                <span style="color:${culoareTip}; font-weight:bold;">[${tipInterventie}]</span><br>
                                <span style="color:#2c3e50;">${operatiuni}</span>
                            </td>
                        </tr>
                    `;
                });
            } else {
                tabelPopHtml = `<tr><td colspan="2" style="text-align:center; padding: 10px;">Lipsă date istoric.</td></tr>`;
            }
            
            // Calculăm culoarea pin-ului
            const zile = calculZile(ultimaData);
            let hexColor = "#e74c3c"; 
            
            if (zile < 30) {
                hexColor = "#27ae60"; 
                statusText = "🟢 ÎN GRAFIC";
            } else if (zile < 90) {
                hexColor = "#f39c12"; 
                statusText = "🟡 NECESITĂ ATENȚIE";
            } else {
                statusText = "🔴 CRITIC / DEPĂȘIT";
            }

            // Adăugăm pin-ul pe hartă
            const m = L.marker([u.lat, u.lng], { icon: getColoredIcon(hexColor) }).addTo(map);
            
            // Salvăm coordonatele pentru zoom
            boundsArray.push([u.lat, u.lng]);
            
            // Construcția POPUP-ului detaliat
            const popHtml = `
                <div class="popup-header">
                    <h3>${u.nume}</h3>
                    <p>Model: ${u.model || '-'} | ID: ${u.id}</p>
                </div>
                <div class="popup-body">
                    <div class="last-info">
                        <b>Status Actual:</b> ${statusText}<br>
                        <b>Zile scurse de la ultima revizie:</b> ${zile === 999 ? 'Niciodată' : zile + ' zile'}
                    </div>
                    
                    <b style="font-size:11px; color:#2c3e50; text-transform: uppercase;">Ce s-a lucrat ultima oară:</b>
                    <table style="width:100%; border-collapse:collapse; font-size:11px; margin-top:8px; margin-bottom:10px;">
                        <thead>
                            <tr style="background:#f1f2f6; color: #555;">
                                <th style="padding:5px; text-align:left;">Data / Om</th>
                                <th style="padding:5px; text-align:left;">Operațiuni Efectuate</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${tabelPopHtml}
                        </tbody>
                    </table>
                    
                    <button class="btn-history" onclick="deschideIstoricUtilaj('${id}')">📜 VEZI ISTORIC COMPLET</button>
                </div>
            `;
            
            m.bindPopup(popHtml);
            m.uData = { id: String(u.id).toUpperCase(), nume: u.nume.toUpperCase() };
            markersList.push(m);
        });

        // Executăm Auto-Zoom-ul dacă am selectat o secție anume
        if (boundsArray.length > 0 && filtru !== "Toate") {
            map.fitBounds(boundsArray, { padding: [50, 50], maxZoom: 1.5 });
        } else if (filtru === "Toate") {
            // Resetăm zoom-ul la vizualizarea întregii fabrici
            map.setView([500, 700], 0.5);
        }
    }

