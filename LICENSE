<script>
    // 1. Configurare Firebase
    const firebaseConfig = { 
        databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" 
    };
    
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    // 2. Configurare Hartă Leaflet
    var map = L.map('map', { 
        crs: L.CRS.Simple, 
        minZoom: 0, 
        maxZoom: 3 
    });
    
    L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map);
    map.setView([500, 700], 1); 

    // 3. Variabile Globale
    let dbRaw = {};
    let markersGroup = L.layerGroup().addTo(map);
    let activeMarker = null;
    let selectedId = null;
    let currentCoords = null;
    
    // Setăm data de astăzi automat în câmpul Dată
    document.getElementById('data').valueAsDate = new Date();

    // 4. Ascultăm baza de date pentru actualizări în timp real
    database.ref('utilaje').on('value', (snap) => { 
        dbRaw = snap.val() || {}; 
        refreshPini(); 
    });

    // 5. Funcția pentru afișarea pinilor pe hartă (în modul edit)
    function refreshPini() {
        markersGroup.clearLayers();
        
        Object.keys(dbRaw).forEach(id => {
            const u = dbRaw[id];
            
            if (u.lat && u.lng) {
                const customIcon = L.icon({ 
                    iconUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon.png', 
                    className: 'existing-pin', 
                    iconSize: [25, 41], 
                    iconAnchor: [12, 41] 
                });
                
                const m = L.marker([u.lat, u.lng], { icon: customIcon }).addTo(markersGroup);
                
                m.on('click', (e) => { 
                    L.DomEvent.stopPropagation(e); 
                    incarcaUtilaj(id); 
                });
            }
        });
    }

    // 6. Funcția de click pe hartă pentru a adăuga un pin nou
    map.on('click', (e) => {
        // Dacă edităm deja un utilaj existent, nu putem adăuga unul nou din greșeală
        if (selectedId) {
            return; 
        }
        
        currentCoords = [e.latlng.lat.toFixed(0), e.latlng.lng.toFixed(0)];
        
        // Ștergem pinul provizoriu dacă exista deja unul pus
        if (activeMarker) {
            map.removeLayer(activeMarker);
        }
        
        activeMarker = L.marker(e.latlng).addTo(map); 
        
        checkReady();
    });

    // 7. Funcția de încărcare a datelor când dăm click pe un utilaj existent
    function incarcaUtilaj(id) {
        selectedId = id; 
        const u = dbRaw[id];
        
        document.getElementById('nume').value = u.nume; 
        document.getElementById('model').value = u.model || ""; 
        document.getElementById('sectie').value = u.sectie;
        
        document.getElementById('status').innerHTML = `MOD: EDITARE UTILAJ (ID: ${id})`; 
        document.getElementById('status').className = "status-badge status-edit";
        
        // Creăm butonul de ștergere definitivă
        const deleteBtnHtml = `<button class="btn-del" onclick="stergeUtilaj('${id}')">⚠️ ȘTERGE UTILAJ DEFINITIV</button>`;
        document.getElementById('deleteZone').innerHTML = deleteBtnHtml;
        
        if (activeMarker) {
            map.removeLayer(activeMarker);
        }
        
        toggleExtra(); 
        checkReady();
    }

    // 8. BIFE DINAMICE CONFORM PLANULUI 2026
    function toggleExtra() {
        const s = document.getElementById('sectie').value;
        const extraFieldsDiv = document.getElementById('extraFields');
        
        let html = '<label>Operațiuni Plan Mentenanță 2026:</label><div class="checklist">';

        if (s === 'Tocare' || s === 'Injectare') {
            html += `
                <label class="check-item"><input type="checkbox" class="task" value="Filtru admisie aer"> Filtru admisie aer</label>
                <label class="check-item"><input type="checkbox" class="task" value="Sistem hidraulic"> Sistem hidraulic</label>
                <label class="check-item"><input type="checkbox" class="task" value="Motor principal"> Motor principal</label>
                <label class="check-item"><input type="checkbox" class="task" value="Transmisie cuva"> Transmisie cuvă (Ulei)</label>
                <label class="check-item"><input type="checkbox" class="task" value="Descarcator pasta"> Descărcător pastă</label>
                <label class="check-item"><input type="checkbox" class="task" value="Curele transmisie"> Curele</label>
            `;
        } else if (s === 'Tranșare') {
            html += `
                <label class="check-item"><input type="checkbox" class="task" value="Benzi transport"> Verificare benzi transport</label>
                <label class="check-item"><input type="checkbox" class="task" value="Tablou electric"> Tablou electric (contacte)</label>
                <label class="check-item"><input type="checkbox" class="task" value="Sistem taiere"> Sistem tăiere (Ascuțire/Gresare)</label>
            `;
        } else if (s === 'Ambalare Vid') {
            html += `
                <label class="check-item"><input type="checkbox" class="task" value="Ulei Pompa Vid"> Ulei Pompă Vid</label>
                <label class="check-item"><input type="checkbox" class="task" value="Rezistente Lipire"> Rezistențe Lipire</label>
                <label class="check-item"><input type="checkbox" class="task" value="Banda Teflon"> Bandă Teflon</label>
            `;
        } else {
            html += `
                <label class="check-item"><input type="checkbox" class="task" value="Inspectie Vizuala"> Inspecție Vizuală</label>
                <label class="check-item"><input type="checkbox" class="task" value="Verificare Tablou"> Tablou Electric</label>
            `;
        }
        
        html += `</div>`;
        html += `<div class="group" style="margin-top:10px;">`;
        html += `<label>Altă operațiune manuală:</label>`;
        html += `<input type="text" id="extraCheck">`;
        html += `</div>`;
        
        extraFieldsDiv.innerHTML = html;
    }

    // 9. Verificare validitate formular înainte de salvare
    function checkReady() {
        const numeValid = document.getElementById('nume').value.trim().length > 2;
        const areLocatie = (selectedId !== null) || (currentCoords !== null);
        
        const saveBtn = document.getElementById('saveBtn');
        
        if (areLocatie && numeValid) {
            saveBtn.disabled = false;
        } else {
            saveBtn.disabled = true;
        }
    }

    // 10. Ștergerea unui utilaj
    async function stergeUtilaj(id) { 
        const confirmare = confirm("Ești sigur că vrei să ștergi acest utilaj și întregul său istoric?");
        if (confirmare) { 
            await database.ref('utilaje/' + id).remove(); 
            resetForm(); 
        } 
    }

    // 11. Funcția principală de salvare a datelor
    async function salveaza() {
        const btn = document.getElementById('saveBtn'); 
        const msg = document.getElementById('feedbackMsg');
        
        btn.disabled = true; 
        btn.innerText = "⏳ SE SALVEAZĂ...";

        try {
            // Colectăm ce a fost bifat
            const bifeList = document.querySelectorAll('.task:checked');
            const bifeArray = Array.from(bifeList);
            const bifeValues = bifeArray.map(c => c.value);
            const bifeString = bifeValues.join(", ");
            
            // Colectăm valoarea extra scrisă manual
            const extraCheckElement = document.getElementById('extraCheck');
            let manual = "";
            if (extraCheckElement) {
                manual = extraCheckElement.value;
            }
            
            // Creăm șirul final de verificări
            let verificariFinale = bifeString;
            if (manual !== "") {
                if (verificariFinale !== "") {
                    verificariFinale += " | " + manual;
                } else {
                    verificariFinale = manual;
                }
            }
            
            // Colectăm costul
            let costValoare = parseFloat(document.getElementById('cost').value);
            if (isNaN(costValoare)) {
                costValoare = 0;
            }

            // Creăm obiectul pentru intervenție
            const entry = {
                data: document.getElementById('data').value,
                tip: document.getElementById('tipInterventie').value,
                mecanic: document.getElementById('mecanic').value,
                cost: costValoare,
                verificari: verificariFinale,
                obs: document.getElementById('obs').value,
                timestamp: Date.now()
            };

            if (selectedId) {
                // Dacă utilajul există, actualizăm și adăugăm în istoric
                const istoricRef = database.ref('utilaje/' + selectedId + '/istoric').push();
                await istoricRef.set(entry);
                
                await database.ref('utilaje/' + selectedId + '/model').set(document.getElementById('model').value);
                await database.ref('utilaje/' + selectedId + '/sectie').set(document.getElementById('sectie').value);
            } else {
                // Dacă este un utilaj complet nou
                const idGenerat = Math.floor(1000 + Math.random() * 9000);
                const idNou = "K-" + idGenerat;
                
                const utilajNouObject = { 
                    id: idNou, 
                    nume: document.getElementById('nume').value, 
                    model: document.getElementById('model').value, 
                    sectie: document.getElementById('sectie').value, 
                    lat: parseFloat(currentCoords[0]), 
                    lng: parseFloat(currentCoords[1]), 
                    istoric: { 
                        "init": entry 
                    } 
                };
                
                await database.ref('utilaje/' + idNou).set(utilajNouObject);
            }

            // Confirmare de succes
            msg.innerText = "✅ SALVAT CU SUCCES!"; 
            msg.className = "msg-popup msg-success"; 
            msg.style.display = "block";
            
            setTimeout(() => { 
                resetForm(); 
                btn.innerText = "💾 SALVEAZĂ FIȘA"; 
                msg.style.display = "none"; 
            }, 2000);
            
        } catch(e) {
            // Confirmare eroare
            msg.innerText = "❌ EROARE: " + e.message; 
            msg.className = "msg-popup msg-error"; 
            msg.style.display = "block";
            
            btn.disabled = false; 
            btn.innerText = "💾 ÎNCEARCĂ DIN NOU";
        }
    }

    // 12. Resetare formular pentru acțiuni noi
    function resetForm() {
        selectedId = null; 
        currentCoords = null;
        
        document.getElementById('nume').value = ""; 
        document.getElementById('model').value = ""; 
        document.getElementById('obs').value = ""; 
        document.getElementById('mecanic').value = "";
        document.getElementById('cost').value = "";
        
        document.getElementById('status').innerHTML = "MOD: UTILAJ NOU"; 
        document.getElementById('status').className = "status-badge"; 
        document.getElementById('deleteZone').innerHTML = "";
        
        if (activeMarker) {
            map.removeLayer(activeMarker); 
        }
        
        toggleExtra(); 
        checkReady();
    }

    // Inițializare scripturi după ce se încarcă pagina
    toggleExtra(); 
    
    window.onload = () => { 
        setTimeout(() => {
            map.invalidateSize();
        }, 500); 
    };
</script>
</body>
</html>
multumesc. altceva ce ai mai imbunatati? cum am putea gandi partea cu qr code?

Cu mare drag! Faptul că te gândești deja la coduri QR înseamnă că duci această aplicație exact în direcția corectă: un sistem CMMS (Computerized Maintenance Management System) de nivel corporativ, la fel cum folosesc fabricile mari (ex: SAP, IBM Maximo).

Iată cum putem gândi logic partea de QR Code și ce alte 3 îmbunătățiri majore mai poți adăuga pe viitor.

1. Cum implementăm sistemul cu QR Code (Conceptul)
Scopul codului QR este să elimine timpul de căutare. Mecanicul ajunge în fața Cuter-ului, scoate telefonul, scanează eticheta de pe utilaj și pe ecran îi apare instant formularul de mentenanță deja completat cu numele și secția utilajului, gata să fie bifat.

Fluxul tehnic pe care îl putem adăuga:

Generarea: În pagina view.html (în acel meniu individual al utilajului unde e butonul de Excel), adăugăm un buton "🖨️ Printează Etichetă QR". Când dai click, îți generează un pătrat QR pe care îl poți scoate la imprimantă pe o etichetă autocolantă.

Ce conține QR-ul? Codul QR va stoca pur și simplu un link web către portalul tău, care conține ID-ul utilajului. De exemplu:
www.killer-mentenanta.ro/edit.html?id=K-1234

Scanarea și Auto-completarea: Orice telefon modern scanează QR-uri direct din aplicația de Cameră. Când mecanicul scanează, se va deschide pagina edit.html. Noi vom pune 3 linii de cod JavaScript care citesc link-ul. Dacă văd că există un ?id=..., aplicația caută instant acel utilaj în Firebase, îl selectează pe hartă și completează automat Denumirea, Modelul și Secția. Mecanicul doar pune bifele, costul și dă Salvează.

Dacă vrei, la pasul următor îți pot scrie exact modificările pentru a integra generarea și citirea de QR Code! E foarte ușor de adăugat peste ce avem deja.

2. Ce alte îmbunătățiri majore se mai pot face? (Nivelul următor)
Dacă vrei să faci aplicația să fie „tanc”, iată ce mai putem dezvolta:

A. Atașare de Fotografii (Dovada reparației)
Cum arată: În edit.html punem un buton 📷 "Adaugă Poză".

Cum ajută: Dacă mecanicul găsește o piesă fisurată, face poza cu telefonul. Poza se urcă automat în baza de date (Firebase Storage) și, când tu te uiți în view.html la istoric, vezi și imaginea reparației sau a piesei defecte, nu doar textul.

B. Sistem de Utilizatori și Roluri (Autentificare reală)
Cum arată: Acum oricine știe parola simplă poate intra. Putem face un sistem de conturi bazat pe email/parolă.

Cum ajută:

Cont Mecanic: Poate scana QR-uri, adăuga intervenții, dar NU poate șterge utilaje și nu vede costurile financiare totale.

Cont Admin (Tu): Vede graficele, rapoartele Excel, costurile și poate șterge din baza de date.

În plus, în câmpul „Mecanic”, aplicația va pune automat numele celui logat, fără să mai trebuiască să-l scrie el manual.

C. Alerte Automate pe Email
Cum arată: Un script care rulează în fundal (folosind un serviciu gratuit precum EmailJS).

Cum ajută: În fiecare luni dimineața, aplicația îți trimite automat un email: "Bună dimineața! Săptămâna aceasta aveți 3 utilaje care necesită inspecție: 1. Feliator Bizerba (Curele) ... ". Așa nu mai trebuie să deschizi zilnic aplicația ca să verifici ce e cu roșu.

D. Gestiune Stocuri de Piese (Simplificată)
Cum arată: În loc ca mecanicul să scrie manual "Am folosit ulei Shell Tellus", va avea un Dropdown (o listă) cu piesele pe care le aveți în magazie.

Cum ajută: Când bifează că a folosit o curea sau 2 litri de ulei, sistemul scade automat acea cantitate dintr-un stoc virtual, iar la final de lună știi exact ce piese trebuie să mai comanzi.

Cum ți se par aceste idei? Vrei să începem prin a implementa acum sistemul de QR Code (Generare în Vizualizare + Auto-deschidere în Editare)?

putem sa adaugam, dar cand scanezi acel qrcode ca si simplu angajat si vrei doar sa vezi cand s-a facut ultima interventie sau sa vada istoricul se poate si acest lucru? sunt foarte bune ideile tale, putem sa le implementam iar cu partea de qr code as dori sa pot cumva exporta o lista si pe urma sa le pot printa si decupa mai usor.

Ideea ta este excelentă! Să separăm lucrurile pentru un „angajat simplu” față de un „mecanic/admin” este exact modul în care funcționează marile sisteme de mentenanță.

Pentru a realiza asta perfect, vom adăuga o a 3-a pagină în sistemul tău, numită scan.html.

Cum va funcționa noul flux cu QR Code:
Tipărirea (A4): În panoul tău de view.html vei avea un buton nou „🖨️ ETICHETE QR”. Când apeși pe el, se generează automat o pagină curată de printat la imprimantă, cu toate utilajele sub formă de etichete (Pătrat cu QR, Nume Utilaj, ID). Tu le tai și le lipești pe utilaje.

Scanarea (Angajat Simplu): Angajatul din fabrică scanează codul cu camera telefonului. Se deschide direct pagina scan.html pe telefon. Aici vede doar istoricul (când a fost schimbat uleiul, ce a făcut mecanicul). Nu cere parolă și nu poate modifica nimic.

Scanarea (Mecanic): Dacă mecanicul scanează, el vede același istoric, dar are jos un buton „CĂTRE EDITARE”. Apasă pe el, bagă parola, iar formularul din edit.html se completează automat cu datele acelui utilaj, gata să fie bifat!

Pentru a nu tăia nicio linie și a-ți da codurile 100% complete, îți voi da exact fișierele necesare.

