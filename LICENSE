    <script>
        // 🛡️ PAZNICUL DE ACCES
        if (sessionStorage.getItem('access_granted') !== 'true') {
            window.location.href = 'index.html';
        }
        
        // ⏱️ AUTO-LOGOUT (30 min)
        let timeout;
        function resetTimer() {
            clearTimeout(timeout);
            timeout = setTimeout(() => {
                sessionStorage.removeItem('access_granted');
                window.location.href = 'index.html';
            }, 1800000);
        }
        window.onmousemove = resetTimer;
        window.onkeypress = resetTimer;

        // ⚠️ PREVENIRE ÎNCHIDERE PAGINĂ
        window.onbeforeunload = function() { 
            if(document.getElementById('nume').value !== "") return "Ai date nesalvate!"; 
        };
    </script>

    <style>
        :root { --primary: #2c3e50; --accent: #f39c12; --success: #27ae60; --danger: #e74c3c; --text: #ecf0f1; }
        body { margin: 0; padding: 0; display: flex; height: 100vh; background: #1a1a1a; color: var(--text); font-family: 'Segoe UI', sans-serif; overflow: hidden; }
        
        #sidebar { 
            width: 400px; height: 100vh; background: var(--primary); padding: 25px; 
            overflow-y: auto; box-sizing: border-box; display: flex; flex-direction: column; 
            z-index: 10; border-right: 1px solid rgba(255,255,255,0.1); box-shadow: 10px 0 30px rgba(0,0,0,0.5);
        }

        .nav-header { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px; }
        .btn-nav { padding: 10px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(0,0,0,0.2); color: white; text-align: center; text-decoration: none; font-size: 11px; font-weight: bold; cursor: pointer; }
        .btn-nav:hover { background: var(--accent); }

        .logo-box { text-align: center; margin-bottom: 15px; }
        .logo-box img { max-width: 120px; }

        .cloud-status { background: rgba(39, 174, 96, 0.1); padding: 10px; border-radius: 8px; font-size: 10px; display: flex; align-items: center; justify-content: center; gap: 8px; color: var(--success); margin-bottom: 20px; border: 1px solid var(--success); }
        .dot { width: 7px; height: 7px; background: var(--success); border-radius: 50%; animation: pulse 1.5s infinite; }
        @keyframes pulse { 0% { opacity: 0.4; } 50% { opacity: 1; } 100% { opacity: 0.4; } }

        .status-badge { padding: 12px; border-radius: 8px; font-size: 11px; font-weight: bold; margin-bottom: 20px; text-align: center; border-left: 5px solid var(--accent); background: rgba(0,0,0,0.2); }
        .status-edit { border-left-color: var(--success); color: var(--success); }

