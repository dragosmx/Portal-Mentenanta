    <div class="modal-c" style="flex-direction:column; max-width:900px;">
        <span style="position:absolute;top:10px;right:20px;cursor:pointer;font-size:30px;" onclick="this.parentElement.parentElement.style.display='none'">&times;</span>
        <h2 id="histNume">Nume Utilaj</h2>
        <div style="overflow-y:auto; background:white; padding:15px; border-radius:10px;">
            <table style="width:100%; font-size:12px; border-collapse:collapse;" border="1" bordercolor="#eee">
                <thead><tr style="background:#f1f2f6;"><th>Data</th><th>Mecanic</th><th>Operațiuni</th><th>Cost</th></tr></thead>
                <tbody id="corpHistIndiv"></tbody>
            </table>
        </div>
    </div>
