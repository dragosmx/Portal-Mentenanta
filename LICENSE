2. edit.html (Formularul - Verde Killer & Plan 2026)
Include câmpul de Cost, Mecanic și bifele din document.

HTML
<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administrare - Killer SRL</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.17.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.17.1/firebase-database-compat.js"></script>

    <script>
        if (sessionStorage.getItem('access_granted') !== 'true') {
            window.location.href = 'index.html?ref=' + encodeURIComponent(window.location.search);
        }
        let timeout; function resetTimer() { clearTimeout(timeout); timeout = setTimeout(() => { sessionStorage.removeItem('access_granted'); window.location.href = 'index.html'; }, 1800000); }
        window.onmousemove = resetTimer; window.onkeypress = resetTimer;
    </script>

    <style>
        :root { --primary: #2c3e50; --accent: #27ae60; --success: #2ecc71; --danger: #e74c3c; --text: #ecf0f1; --text-dim: #bdc3c7; }
