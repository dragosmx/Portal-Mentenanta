<script>
    // 1. Initializare Firebase
    const firebaseConfig = { 
        databaseURL: "https://killer-mentenanta-default-rtdb.europe-west1.firebasedatabase.app/" 
    };
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    // 2. Initializare Hartă
    // Oprim controalele default din stânga sus (zoomControl: false)
    var map = L.map('map', { 
        crs: L.CRS.Simple, 
        minZoom: 0, 
        maxZoom: 3,
        zoomControl: false 
    });
    
    // Adăugăm controalele de Zoom în dreapta-jos (ca să nu se suprapună)
    L.control.zoom({ position: 'bottomright' }).addTo(map);
    
    L.imageOverlay('harta.jpg', [[0, 0], [1000, 1400]]).addTo(map);
    map.setView([500, 700], 0.5);

    // 3. Variabile globale
    let dbRaw = {}; 
    let markersList = []; 
    let chartInstance = null;

    // 4. Preluare Date din baza de date
    database.ref('utilaje').on('value', (snap) => {
        dbRaw = snap.val() || {};
        afiseazaPuncte();
    });

    // 5. Calculare diferență zile
    function calculZile(dataStr) {
        if (!dataStr || dataStr === "-") {
            return 999;
        }
        const diff = new Date() - new Date(dataStr);
        return Math.floor(diff / (1000 * 3600 * 24));
    }

    // 6. Generare Pini SVG Colorați
    function getColoredIcon(color) {
        const svg = `
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 36" width="28" height="42">
                <path fill="${color}" stroke="#000" stroke-width="1.5" d="M12 0C5.373 0 0 5.373 0 12c0 7.333 12 24 12 24s12-16.667 12-24C24 5.373 18.627 0 12 0zm0 17.5c-3.038 0-5.5-2.462-5.5-5.5S8.962 6.5 12 6.5s5.5 2.462 5.5 5.5-2.462 5.5-5.5 5.5z"/>
            </svg>`;
        return L.divIcon({ 
            className: "custom-pin", 
            html: svg, 
            iconSize: [28, 42], 
            iconAnchor: [14, 42], 
            popupAnchor: [0, -40] 
        });
    }

    // 7. AFIȘARE PUNCTE, POPUP DETALIAT ȘI AUTO-ZOOM PE SECȚIE
    function afiseazaPuncte() {
        const filtru = document.getElementById('filterSectie').value;
        
        // Curățăm harta
        markersList.forEach(m => map.removeLayer(m));
        markersList = [];

        // Array pentru coordonate auto-zoom
        let boundsArray = [];

        Object.keys(dbRaw).forEach(id => {
            const u = dbRaw[id];
            
            if (filtru !== "Toate" && u.sectie !== filtru) {
                return;
            }
            if (!u.lat || !u.lng) {
                return;
            }

            let ultimaData = "-";
            let tabelPopHtml = "";
            let statusText = "🟢 OK";

            // Generăm tabelul scurt pentru Pop-up
            if (u.istoric) {
                const istoricArray = Object.values(u.istoric);
                istoricArray.sort((a, b) => new Date(b.data) - new Date(a.data));
                ultimaData = istoricArray[0].data;
                
                const ultimeleTrei = istoricArray.slice(0, 3);
                ultimeleTrei.forEach(i => {
                    let culoareTip = "#27ae60"; 
                    if (i.tip && i.tip.includes('Corectivă')) {
                        culoareTip = "#e74c3c"; 
                    }
                    
                    let mecanicNume = i.mecanic ? i.mecanic : 'Nespecificat';
                    let operatiuni = i.verificari ? i.verificari : '<i>Nicio operațiune bifată</i>';
                    let tipInterventie = i.tip ? i.tip : 'Plan';

                    tabelPopHtml += `
                        <tr>
                            <td style="padding: 6px; border-bottom: 1px solid #eee; vertical-align: top; white-space: nowrap; width: 35%;">
                                <b>${i.data}</b><br>
                                <span style="font-size:9px; color:#7f8c8d;">${mecanicNume}</span>
                            </td>
                            <td style="padding: 6px; border-bottom: 1px solid #eee; vertical-align: top; font-size:10px;">
                                <span style="color:${culoareTip}; font-weight:bold;">[${tipInterventie}]</span><br>
                                <span style="color:#2c3e50;">${operatiuni}</span>
                            </td>
                        </tr>
                    `;
                });
            } else {
                tabelPopHtml = `<tr><td colspan="2" style="text-align:center; padding: 10px;">Lipsă date istoric.</td></tr>`;
            }
            
            const zile = calculZile(ultimaData);
            let hexColor = "#e74c3c"; 
            
            if (zile < 30) {
                hexColor = "#27ae60"; 
                statusText = "🟢 ÎN GRAFIC";
            } else if (zile < 90) {
                hexColor = "#f39c12"; 
                statusText = "🟡 NECESITĂ ATENȚIE";
            } else {
                statusText = "🔴 CRITIC / DEPĂȘIT";
            }

            const m = L.marker([u.lat, u.lng], { icon: getColoredIcon(hexColor) }).addTo(map);
            boundsArray.push([u.lat, u.lng]);
            
            const popHtml = `
                <div class="popup-header">
                    <h3>${u.nume}</h3>
                    <p>Model: ${u.model || '-'} | ID: ${u.id}</p>
                </div>
                <div class="popup-body">
                    <div class="last-info">
                        <b>Status Actual:</b> ${statusText}<br>
                        <b>Zile scurse de la ultima revizie:</b> ${zile === 999 ? 'Niciodată' : zile + ' zile'}
                    </div>
                    
                    <b style="font-size:11px; color:#2c3e50; text-transform: uppercase;">Ce s-a lucrat ultima oară:</b>
                    <table style="width:100%; border-collapse:collapse; font-size:11px; margin-top:8px; margin-bottom:10px;">
                        <thead>
                            <tr style="background:#f1f2f6; color: #555;">
                                <th style="padding:5px; text-align:left;">Data / Om</th>
                                <th style="padding:5px; text-align:left;">Operațiuni Efectuate</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${tabelPopHtml}
                        </tbody>
                    </table>
                    
                    <button class="btn-history" onclick="deschideIstoricUtilaj('${id}')">📜 VEZI ISTORIC COMPLET</button>
                </div>
            `;
            
            m.bindPopup(popHtml);
            m.uData = { id: String(u.id).toUpperCase(), nume: u.nume.toUpperCase() };
            markersList.push(m);
        });

        // Aplicăm zoom-ul
        if (boundsArray.length > 0 && filtru !== "Toate") {
            map.fitBounds(boundsArray, { padding: [50, 50], maxZoom: 1.5 });
        } else if (filtru === "Toate") {
            map.setView([500, 700], 0.5);
        }
    }

    // 8. MODAL ISTORIC INDIVIDUAL (fără costuri)
    function deschideIstoricUtilaj(id) {
        const u = dbRaw[id];
        
        document.getElementById('histNume').innerText = u.nume;
        document.getElementById('histModel').innerText = "Model: " + (u.model || "-") + " | Secție: " + u.sectie;
        
        const corp = document.getElementById('corpIstoricIndividual');
        corp.innerHTML = "";
        
        if (u.istoric) {
            const istSorted = Object.values(u.istoric);
            istSorted.sort((a, b) => new Date(b.data) - new Date(a.data));
            
            istSorted.forEach(i => {
                let obsRow = i.obs ? i.obs : '-';
                let mecRow = i.mecanic ? i.mecanic : '-';
                let tipRow = i.tip ? i.tip : 'Preventivă';
                let verifRow = i.verificari ? i.verificari : '-';

                corp.innerHTML += `
                    <tr>
                        <td><b>${i.data}</b></td>
                        <td>${tipRow}</td>
                        <td><i>${mecRow}</i></td>
                        <td>${verifRow}</td>
                        <td>${obsRow}</td>
                    </tr>
                `;
            });
        } else {
            corp.innerHTML = "<tr><td colspan='5' style='text-align:center;'>Nu există istoric pentru acest utilaj.</td></tr>";
        }

        document.getElementById('btnExportIndividual').onclick = function() {
            exportaExcelIndividual(id);
        };
        
        document.getElementById('historyModal').style.display = "flex";
    }

    // 9. DASHBOARD GENERAL (Numără intervenții, nu lei)
    function deschideRapoarte() {
        const corp = document.getElementById('corpScadente');
        corp.innerHTML = "";
        
        let countOk = 0;
        let countWarn = 0;
        let countCrit = 0;
        let numarTotalInterventii = 0;

        Object.values(dbRaw).forEach(u => {
            let ultimaData = "-";
            
            if (u.istoric) {
                const istArray = Object.values(u.istoric);
                istArray.sort((a, b) => new Date(b.data) - new Date(a.data));
                ultimaData = istArray[0].data;
                
                // Calculăm numărul total de reparații efectuate
                numarTotalInterventii += istArray.length;
            }
            
            const zile = calculZile(ultimaData);
            
            if (zile < 30) {
                countOk++;
            } else if (zile < 90) {
                countWarn++;
            } else {
                countCrit++;
            }

            let actiune = "";
            let statusBadge = "";
            
            if (zile >= 365) { 
                actiune = "Revizie Anuală Plan"; 
                statusBadge = `<span class="status-pill bg-crit">CRITIC</span>`; 
            } else if (zile >= 180) { 
                actiune = "Revizie Semestrială"; 
                statusBadge = `<span class="status-pill bg-crit">DEPĂȘIT</span>`; 
            } else if (zile >= 30) { 
                actiune = "Control Lunar"; 
                statusBadge = `<span class="status-pill bg-warn">URMEAZĂ</span>`; 
            }
            
            if (zile >= 30 || ultimaData === "-") {
                corp.innerHTML += `
                    <tr>
                        <td><b>${u.nume}</b><br><small>${u.sectie}</small></td>
                        <td>${zile === 999 ? 'LIPSĂ' : zile + ' zile'}</td>
                        <td>${actiune || 'Inspecție standard'}</td>
                        <td>${statusBadge || '<span class="status-pill bg-warn">URMEAZĂ</span>'}</td>
                    </tr>
                `;
            }
        });

        document.getElementById('totalInterventii').innerText = numarTotalInterventii;

        const ctx = document.getElementById('statusChart').getContext('2d');
        if (chartInstance) {
            chartInstance.destroy();
        }
        
        chartInstance = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['OK', 'Atenție', 'Critic'],
                datasets: [{ 
                    data: [countOk, countWarn, countCrit], 
                    backgroundColor: ['#27ae60', '#f39c12', '#e74c3c'], 
                    borderWidth: 0 
                }]
            },
            options: { plugins: { legend: { position: 'bottom' } } }
        });

        document.getElementById('reportModal').style.display = "flex";
    }

    // 10. EXPORT EXCEL GENERAL (Fără Cost)
    function exportaExcelNativ() {
        let dateExcel = [];
        Object.values(dbRaw).forEach(u => {
            if (u.istoric) {
                Object.values(u.istoric).forEach(i => {
                    dateExcel.push({ 
                        "Data": i.data, "Utilaj": u.nume, "ID": u.id, "Secție": u.sectie, 
                        "Mecanic": i.mecanic || "-", "Tip": i.tip || "-", 
                        "Operațiuni": i.verificari || "-", "Observații": i.obs || "-" 
                    });
                });
            }
        });
        const ws = XLSX.utils.json_to_sheet(dateExcel);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Istoric General");
        XLSX.writeFile(wb, "Raport_Mentenanta_Killer_SRL.xlsx");
    }

    // 11. EXPORT EXCEL INDIVIDUAL (Fără Cost)
    function exportaExcelIndividual(id) {
        const u = dbRaw[id];
        let dateExcel = [];
        if (u.istoric) {
            Object.values(u.istoric).forEach(i => {
                dateExcel.push({ 
                    "Data": i.data, "Tip": i.tip || "-", "Tehnician": i.mecanic || "-", 
                    "Operațiuni": i.verificari || "-", "Observații": i.obs || "-" 
                });
            });
        }
        const ws = XLSX.utils.json_to_sheet(dateExcel);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "Fisa Service");
        XLSX.writeFile(wb, `Fisa_Service_${u.nume.replace(/ /g, "_")}.xlsx`);
    }

    // 12. ÎNCHIDERE MODAL
    function inchideModal(id) { 
        document.getElementById(id).style.display = "none"; 
    }
    
    // 13. CĂUTARE UTILAJ DUPĂ NUME / ID
    function cauta() {
        const val = document.getElementById('searchInput').value.toUpperCase().trim();
        const gasit = markersList.find(m => {
            return m.uData.id.includes(val) || m.uData.nume.includes(val);
        });
        if (gasit) { 
            map.setView(gasit.getLatLng(), 1.5); 
            gasit.openPopup(); 
        } else {
            alert("Utilajul nu a fost găsit pe hartă!");
        }
    }

    // 14. GENERARE ETICHETE QR PENTRU PRINTARE A4
    function printeazaQR() {
        let basePath = window.location.href.substring(0, window.location.href.lastIndexOf("/") + 1);
        let printWindow = window.open('', '_blank');
        
        let htmlContent = `
            <html><head><title>Printare Etichete QR Mentenanță</title><style>
                body { font-family: 'Arial', sans-serif; text-align: center; background: #fff; }
                .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; padding: 20px; }
                .card { border: 2px dashed #000; padding: 15px; border-radius: 10px; page-break-inside: avoid; text-align: center; }
                img { max-width: 150px; height: auto; margin-bottom: 10px; }
                h3 { margin: 0; font-size: 14px; text-transform: uppercase; }
                p { margin: 5px 0 0; font-size: 11px; color: #333; font-weight: bold; }
                @media print { .no-print { display: none; } }
            </style></head><body>
            <button class="no-print" onclick="window.print()" style="padding:15px 30px; font-size:18px; margin:20px; cursor:pointer; background:#27ae60; color:white; border:none; border-radius:10px; font-weight:bold;">🖨️ PRINTARE DOCUMENT</button>
            <div class="grid">
        `;

        Object.values(dbRaw).forEach(u => {
            let linkDeScanat = basePath + 'scan.html?id=' + u.id;
            let imgQrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(linkDeScanat)}`;
            
            htmlContent += `
                <div class="card">
                    <img src="${imgQrUrl}" alt="QR">
                    <h3>${u.nume}</h3>
                    <p>Secția: ${u.sectie}</p>
                    <p>ID: ${u.id}</p>
                </div>
            `;
        });

        htmlContent += `</div></body></html>`;
        printWindow.document.write(htmlContent);
        printWindow.document.close();
    }

    // 15. CORECTARE DIMENSIUNE HARTĂ LA ÎNCĂRCARE
    window.onload = () => { 
        setTimeout(() => { map.invalidateSize(); }, 600); 
    };
</script>
</body>
</html>
qr codurile pentru printare se poate sa fie pe o coala de hartie mai multe? adica sa se poate sa fie si mai mici ?

Sigur că da! Este o idee mult mai practică. Etichetele prea mari ocupă mult spațiu pe hârtie și pot fi greu de lipit pe anumite utilaje.

Am modificat codul pentru generarea etichetelor astfel încât:

Să intre 5 etichete pe un rând (în loc de 3).

Să folosească mult mai bine marginile colii de hârtie A4 (intră zeci de utilaje pe o singură pagină).

Codul QR și textul să fie mai mici și compacte (dimensiune ideală pentru o etichetă de aparat).

Tot ce trebuie să faci este să mergi în fișierul view.html, să mergi jos de tot la finalul codului și să înlocuiești complet vechea funcție printeazaQR() cu aceasta de mai jos:

JavaScript
    // 14. GENERARE ETICHETE QR PENTRU PRINTARE A4 (VERSIUNEA COMPACTĂ - 5 PE RÂND)
    function printeazaQR() {
        let basePath = window.location.href.substring(0, window.location.href.lastIndexOf("/") + 1);
        let printWindow = window.open('', '_blank');
        
        let htmlContent = `
            <html><head><title>Printare Etichete QR Mentenanță</title><style>
                @page { margin: 10mm; size: A4; } /* Margini mici pe foaia A4 pentru a încăpea mai multe */
                body { font-family: 'Arial', sans-serif; text-align: center; background: #fff; margin: 0; padding: 0; }
                
                /* Grid pentru 5 etichete pe rând, mult mai compact */
                .grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; padding: 10px; }
                
                /* Eticheta efectivă (Mai mică, margini subțiri) */
                .card { border: 1px dashed #666; padding: 8px; border-radius: 6px; page-break-inside: avoid; text-align: center; }
                
                /* Imaginea QR micșorată */
                img { max-width: 90px; height: auto; margin-bottom: 5px; }
                
                /* Text micșorat corespunzător */
                h3 { margin: 0; font-size: 11px; text-transform: uppercase; line-height: 1.2; }
                p { margin: 3px 0 0; font-size: 9px; color: #333; font-weight: bold; }
                
                .btn-print { padding:10px 20px; font-size:16px; margin:15px; cursor:pointer; background:#27ae60; color:white; border:none; border-radius:8px; font-weight:bold; }
                @media print { .no-print { display: none; } }
            </style></head><body>
            <button class="no-print btn-print" onclick="window.print()">🖨️ PRINTARE ETICHETE (A4)</button>
            <div class="grid">
        `;

        Object.values(dbRaw).forEach(u => {
            let linkDeScanat = basePath + 'scan.html?id=' + u.id;
            // Generăm un QR cu rezoluție potrivită pentru dimensiunea nouă (120x120 în loc de 200x200)
            let imgQrUrl = \`https://api.qrserver.com/v1/create-qr-code/?size=120x120&data=\${encodeURIComponent(linkDeScanat)}\`;
            
            htmlContent += `
                <div class="card">
                    <img src="${imgQrUrl}" alt="QR">
                    <h3>${u.nume}</h3>
                    <p>Secția: ${u.sectie}</p>
                    <p>ID: ${u.id}</p>
                </div>
            `;
        });

        htmlContent += `</div></body></html>`;
        printWindow.document.write(htmlContent);
        printWindow.document.close();
    }
Acum, când apeși pe „🖨️ ETICHETE QR”, se va genera o pagină perfect organizată. Vei avea un grilaj fin de tăiere (cu linie punctată), iar etichetele vor avea aproximativ 4 x 5 cm, exact cât să fie lipite elegant pe colțul unui utilaj Seydelmann sau Bizerba!

ceva am gresit. poti genera codul complet view? fara linii lipsa?

Nu este nicio problemă! Când codul devine foarte lung, limitările platformei pot uneori să taie textul la final.

Pentru a preveni orice eroare, am optimizat modul în care este scris codul, astfel încât să se genereze absolut tot, până la ultima etichetă </html>.

Acesta este fișierul view.html complet, care include:

Zoom mutat în dreapta-jos.

Fără costuri (doar număr de intervenții și istoric).

Auto-Zoom pe secții.

Tabelul detaliat în Pop-up.

Printare QR compactă (5 pe rând).

Te rog să ștergi tot ce ai acum în view.html și să pui acest cod:

